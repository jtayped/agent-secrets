#!/bin/bash -p
# Privileged half of the secrets tooling. Installed at /usr/local/libexec/secret-helper,
# root:root 0755, reached through one NOPASSWD sudoers line.
#
# Everything that can see plaintext lives here, for two reasons. The key is
# root-owned, so the unprivileged wrappers cannot decrypt on their own
# even if an agent rewrites them. And the group filter for `secret-edit <scope>
# <group>` has to be applied before the plaintext leaves this process: a wrapper
# that decrypted the whole scope and then filtered would already have seen every
# sensitive value, and the gate would have bought nothing.
#
# `-p` in the shebang is load-bearing. Privileged mode makes bash ignore
# BASH_ENV, ENV, SHELLOPTS and functions exported through the environment, none
# of which sudo's env_reset can be relied on alone to strip.
#
# sudoers cannot restrict arguments: a Cmnd listed without an argument spec
# permits ANY argv, and no wildcard form changes that. So every check that
# matters is in this file, and the caller-side checks in secret-common.sh
# are conveniences with no security value once sudo is in the picture.
set -euo pipefail

umask 077
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

die() { echo "agent-secrets-helper: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Platform layer
#
# This block is duplicated, on purpose, in bin/secret-common.sh. The helper
# runs as root through sudo and must never source a file the calling account
# can write, so a shared lib/portable.sh would be a one-line privilege
# escalation. Two small copies are the price of not having that hole.
#
# Everything below is written for bash 3.2, because that is what macOS ships
# at the one bash path root actually owns. Associative arrays and mapfile are
# bash 4 and are deliberately absent from this file.

OS="$(uname -s)"
readonly OS
case "$OS" in
    Linux|Darwin) ;;
    CYGWIN*|MINGW*|MSYS*)
        die "windows is not supported natively; run this inside wsl2" ;;
    *) die "unsupported platform: $OS (linux and macos only)" ;;
esac

if [[ ${BASH_VERSINFO[0]:-0} -lt 3 ]] || { [[ ${BASH_VERSINFO[0]:-0} -eq 3 ]] && [[ ${BASH_VERSINFO[1]:-0} -lt 2 ]]; }; then
    die "needs bash 3.2 or newer (found ${BASH_VERSION:-unknown})"
fi

# `-p` in the shebang is the reason this file can ignore its environment. If
# something stripped it, the guarantees in the header comment are gone.
if [[ $EUID -eq 0 ]] && [[ ! -o privileged ]]; then
    die "refusing to run as root without bash privileged mode; the shebang must keep -p"
fi

stat_owner_uid() { if [[ "$OS" == Darwin ]]; then stat -f '%u' -- "$1"; else stat -c '%u' -- "$1"; fi; }
stat_mode()      { if [[ "$OS" == Darwin ]]; then stat -f '%Lp' -- "$1"; else stat -c '%a' -- "$1"; fi; }
stat_mtime()     { if [[ "$OS" == Darwin ]]; then stat -f '%m' -- "$1"; else stat -c '%Y' -- "$1"; fi; }

sha256_of_stdin() {
    if [[ "$OS" == Darwin ]]; then shasum -a 256; else sha256sum; fi | cut -d' ' -f1
}

home_of() {
    local u="$1" h=""
    if command -v getent >/dev/null 2>&1; then
        h="$(getent passwd "$u" | cut -d: -f6)"
    elif [[ "$OS" == Darwin ]]; then
        h="$(dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | sed 's/^NFSHomeDirectory: *//')"
    fi
    [[ -n "$h" ]] || return 1
    printf '%s\n' "$h"
}

# True when root, and only root, can replace this path or any directory above
# it. A helper that runs as root but calls a binary under a prefix the caller
# owns is not a privileged helper at all, and on macOS that is the normal
# state of affairs: homebrew's /opt/homebrew, and /usr/local on intel macs,
# are both writable by the admin account.
#
# Symlinks are the subtle part. A symlink's own permission bits are always 0777
# and the kernel ignores them completely: what governs access is the target,
# and what stops the link being repointed is write permission on the directory
# holding it, which this walk checks on the way up. Treating that 0777 as
# world-writable rejected /bin/bash on every usr-merged distribution, which is
# to say on Arch, Fedora, and current Debian and Ubuntu. So a symlink is
# checked for ownership, its mode is skipped, and its target is walked too.
path_is_trusted() {
    _trusted_walk "$1" 0
}

_trusted_walk() {
    local p="$1" depth="$2" owner mode link
    (( depth > 64 )) && return 1
    [[ -e "$p" ]] || return 1
    while :; do
        owner="$(stat_owner_uid "$p" 2>/dev/null)" || return 1
        [[ "$owner" == 0 ]] || return 1
        if [[ -L "$p" ]]; then
            link="$(readlink "$p" 2>/dev/null)" || return 1
            case "$link" in
                /*) ;;
                *) link="$(dirname -- "$p")/$link" ;;
            esac
            _trusted_walk "$link" "$((depth + 1))" || return 1
        else
            mode="$(stat_mode "$p" 2>/dev/null)" || return 1
            (( (8#$mode & 8#022) == 0 )) || return 1
        fi
        [[ "$p" == "/" ]] && return 0
        p="$(dirname -- "$p")"
    done
}

# Absolute, never resolved through PATH. In root mode an untrusted candidate is
# skipped rather than used, so the search can fall through to a safe one.
resolve_gpg() {
    local c found_untrusted=""
    for c in /usr/bin/gpg /usr/bin/gpg2 /opt/local/bin/gpg \
             /usr/local/bin/gpg /usr/local/bin/gpg2 /opt/homebrew/bin/gpg; do
        [[ -x "$c" ]] || continue
        if [[ $EUID -eq 0 ]] && ! path_is_trusted "$c"; then
            [[ -n "$found_untrusted" ]] || found_untrusted="$c"
            continue
        fi
        printf '%s\n' "$c"
        return 0
    done
    [[ -n "$found_untrusted" ]] && { printf '!%s\n' "$found_untrusted"; return 0; }
    return 1
}

GPG="$(resolve_gpg)" || die "no gpg found. install gnupg and run the installer again"
if [[ "$GPG" == '!'* ]]; then
    die "the only gpg on this machine is ${GPG#!}, which your account can replace. a root-owned helper cannot call it. install gnupg under a root-owned prefix, or use the unhardened mode"
fi
readonly GPG
# appended, never prepended. gpg is called by absolute path and finds its own
# agent through its compiled-in libexec dir, so this is only a fallback for odd
# installs. prepending it would put a homebrew prefix ahead of /usr/bin for the
# rest of this file, quietly swapping awk, sed and grep for different
# implementations in the one program that must not behave differently.
gpg_dir="$(dirname -- "$GPG")"
export PATH="$PATH:$gpg_dir"

if [[ $EUID -eq 0 ]]; then
    [[ -n "${SUDO_USER:-}" && "${SUDO_USER:-}" != root ]] || \
        die "run this through sudo from the account that owns the store"
    readonly target_user="$SUDO_USER"
    target_home="$(home_of "$target_user")" || die "cannot find a home directory for $target_user"
    readonly target_home
    readonly SECRETS_DIR="$target_home/.secrets"
else
    target_user="$(id -un)"
    readonly target_user
    readonly target_home="$HOME"
    readonly SECRETS_DIR="${AGENT_SECRETS_DIR:-$HOME/.secrets}"
fi
readonly SCOPES_DIR="$SECRETS_DIR/scopes"
readonly KEY_FILE="$SECRETS_DIR/key/.key"
# Only present while a rekey is in flight, or after one that has not been
# finished. See cmd_rekey for why keeping it is what makes a rekey safe to
# interrupt.
readonly KEY_FILE_OLD="$SECRETS_DIR/key/.key.old"

# sysexits, so a verdict can never be confused with a child's ordinary exit 1.
readonly EX_UNAVAILABLE=69   # no approval channel
readonly EX_TEMPFAIL=75      # dialog timed out, was killed, or crashed
readonly EX_NOPERM=77        # user said no
# part of the documented exit contract even where this file does not raise it.
# shellcheck disable=SC2034
readonly EX_CONFIG=78        # stale index or malformed metadata
readonly HELPER_PROTOCOL=4    # rekey

# A scope name becomes a filename. Re-validated here rather than trusted from
# the caller: this is the check that stops `decrypt ../../root/.ssh/id_ed25519`.
validate_scope() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "bad scope name"
}

# A group path becomes a variable-name prefix. Same reasoning.
validate_group() {
    [[ -z "$1" ]] && return 0
    [[ "$1" =~ ^[a-z0-9][a-z0-9_]*(\.[a-z0-9][a-z0-9_]*)*$ ]] || die "bad group path"
}

# Syntax is not existence. A group path that parses but names nothing selects an
# empty payload, and `secret-run <scope> typo -- cmd` then hands the command an
# environment with none of the values it asked for and exits 0. The command
# fails somewhere further down, for a reason that looks nothing like the cause.
#
# This mirrors render()'s in_scope exactly, and has to: asking for `pg` selects
# `pg.prod` even when `pg` itself is never declared, so a stricter check here
# would reject paths the renderer is happy to serve. Ungrouped keys have no
# group path, so nothing but the whole scope reaches them and the empty path
# stays valid.
group_exists() {
    local meta="$1" want="$2"
    [[ -z "$want" ]] && return 0
    awk -F'\t' -v want="$want" '
        $1=="G" && ($2==want || index($2 ".", want ".")==1) { found=1; exit }
        END { exit(found ? 0 : 1) }' <<< "$meta"
}

require_group() {
    local meta="$1" scope="$2" want="$3"
    group_exists "$meta" "$want" && return 0
    die "no group '$want' in scope '$scope'. browse it with: secret-list $scope --tree"
}

scope_file() {
    validate_scope "$1"
    printf '%s/%s.env.gpg' "$SCOPES_DIR" "$1"
}

# gpg argv is built entirely from constants plus a path this script derived
# itself. Nothing from the caller reaches it, which is what closes --output,
# --options, --homedir and --exec-path as injection points.
raw_decrypt() {
    local file="$1" out
    [[ -f "$file" ]] || die "no such scope"
    if out="$(decrypt_with "$KEY_FILE" "$file")"; then
        printf '%s\n' "$out"
        return 0
    fi
    # A rekey rewrites the key before it rewrites the scopes, and keeps the
    # previous key while it works. A scope that has not been re-encrypted yet
    # still opens through this fallback, which is what lets a rekey be killed
    # at any point without leaving half the store unreadable.
    if [[ -f "$KEY_FILE_OLD" ]] && out="$(decrypt_with "$KEY_FILE_OLD" "$file")"; then
        printf '%s\n' "$out"
        return 0
    fi
    return 1
}

decrypt_with() {
    "$GPG" --quiet --batch --pinentry-mode loopback \
           --passphrase-file "$1" --decrypt -- "$2" 2>/dev/null
}

raw_encrypt() { encrypt_with "$KEY_FILE"; }

encrypt_with() {
    "$GPG" --quiet --batch --yes --pinentry-mode loopback \
           --passphrase-file "$1" \
           --symmetric --cipher-algo AES256
}

# Same shape as secret-init writes: one line of base64, because gpg reads a
# passphrase file as text and stops at the first newline.
generate_key_material() {
    local out
    out="$("$GPG" --armor --gen-random 2 32)" || die "gpg could not generate a key"
    out="${out%%$'\n'*}"
    [[ ${#out} -ge 43 ]] || die "gpg produced a ${#out}-character key"
    [[ "$out" =~ ^[A-Za-z0-9+/=]+$ ]] || die "gpg produced a key outside the base64 alphabet"
    printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Parser
#
# Metadata rides in `#@` comment lines inside an otherwise ordinary .env
# payload, so an old secret-run, an old secret-edit, and a bare `gpg --decrypt`
# all still read the file correctly. That is what keeps a ciphertext backup plus the
# key in safekeeping sufficient to recover everything with no tooling at all.
#
#   #@g <dotted.path>[<tab or 2+ spaces><description>]   declare a group
#   #@d <text>                                          describe next declaration
#   #@a <name>=<value>                                   attribute of next declaration
#   #@sensitive [ttl=<seconds>]                          mark next declaration
#
# #@d, #@a and #@sensitive attach to the NEXT declaration, which is either a
# #@g line or a KEY= line. A blank line does not clear them, so a group's header
# block can be spaced out for readability. Only a declaration consumes them.
#
# A key belongs to the group whose derived prefix is the LONGEST match on its
# variable name: `#@g pg.aws.shared` derives PG_AWS_SHARED_ and claims
# PG_AWS_SHARED_ADMIN_RO_USER with leaf ADMIN_RO_USER, unless a longer declared
# group claims it first. Keys matching no group sit at the root.
#
# Emits tab-separated records on stdout. Never a value.
#   G <path> <sensitive> <ttl> <description>
#   GA <path> <name> <value>
#   K <var> <group> <leaf> <sensitive> <ttl> <description>
#   KA <var> <name> <value>
#   E <line-number> <message>
parse_meta() {
    awk '
    function reset_pending() { p_desc=""; p_sens=0; p_ttl=""; p_na=0 }

    function derive_prefix(path,   s) {
        s = toupper(path); gsub(/\./, "_", s); return s "_"
    }

    BEGIN { FS="\n"; reset_pending(); ng=0; nk=0; nga=0; nka=0 }

    { sub(/\r$/, ""); sub(/^\xef\xbb\xbf/, "") }

    /^[ \t]*#@/ {
        line = $0
        sub(/^[ \t]*#@/, "", line)

        if (line ~ /^g[ \t]/) {
            sub(/^g[ \t]+/, "", line)
            # Description is separated from the path by a tab or 2+ spaces.
            path = line; desc = ""
            if (match(line, /[ \t][ \t]+|\t/)) {
                path = substr(line, 1, RSTART-1)
                desc = substr(line, RSTART+RLENGTH)
            }
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", desc)
            if (path !~ /^[a-z0-9][a-z0-9_]*(\.[a-z0-9][a-z0-9_]*)*$/) {
                printf "E\t%d\tbad group path: %s\n", NR, path; reset_pending(); next
            }
            if (path in seen_g) { printf "E\t%d\tduplicate group: %s\n", NR, path }
            seen_g[path] = 1
            if (desc == "") desc = p_desc
            gpath[ng] = path; gdesc[ng] = desc; gsens[ng] = p_sens; gttl[ng] = p_ttl
            for (i = 0; i < p_na; i++) { ga_p[nga]=path; ga_n[nga]=p_an[i]; ga_v[nga]=p_av[i]; nga++ }
            ng++
            reset_pending(); next
        }
        if (line ~ /^d[ \t]/) {
            sub(/^d[ \t]+/, "", line)
            gsub(/[ \t]+$/, "", line)
            p_desc = (p_desc == "" ? line : p_desc " " line)
            next
        }
        if (line ~ /^a[ \t]/) {
            sub(/^a[ \t]+/, "", line)
            if (index(line, "=") == 0) { printf "E\t%d\tattribute needs name=value\n", NR; next }
            an = substr(line, 1, index(line, "=") - 1)
            av = substr(line, index(line, "=") + 1)
            gsub(/^[ \t]+|[ \t]+$/, "", an); gsub(/^[ \t]+|[ \t]+$/, "", av)
            if (an !~ /^[a-z][a-z0-9_]*$/) { printf "E\t%d\tbad attribute name: %s\n", NR, an; next }
            p_an[p_na] = an; p_av[p_na] = av; p_na++
            next
        }
        if (line ~ /^sensitive([ \t]|$)/) {
            p_sens = 1
            if (match(line, /ttl=[0-9]+/)) p_ttl = substr(line, RSTART+4, RLENGTH-4)
            next
        }
        printf "E\t%d\tunknown directive: %s\n", NR, line
        next
    }

    /^[ \t]*#/ { next }
    /^[ \t]*$/ { next }

    {
        eq = index($0, "=")
        if (eq == 0) { printf "E\t%d\tline is neither KEY=VALUE nor a comment\n", NR; next }
        var = substr($0, 1, eq-1)
        gsub(/^[ \t]+|[ \t]+$/, "", var)
        if (var !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { printf "E\t%d\tbad variable name\n", NR; next }
        if (var in seen_k) { printf "E\t%d\tduplicate key: %s\n", NR, var }
        seen_k[var] = 1
        kvar[nk] = var; kdesc[nk] = p_desc; ksens[nk] = p_sens; kttl[nk] = p_ttl
        for (i = 0; i < p_na; i++) { ka_k[nka]=var; ka_n[nka]=p_an[i]; ka_v[nka]=p_av[i]; nka++ }
        nk++
        reset_pending()
    }

    END {
        # Sensitivity inherits downward with no child opt-out, so a group is
        # effectively sensitive if it or any ancestor is marked.
        for (i = 0; i < ng; i++) {
            eff = gsens[i]; ttl = gttl[i]
            for (j = 0; j < ng; j++) {
                if (i == j) continue
                if (index(gpath[i] ".", gpath[j] ".") == 1 && gsens[j]) {
                    eff = 1
                    if (ttl == "") ttl = gttl[j]
                }
            }
            printf "G\t%s\t%d\t%d\t%s\t%s\n", gpath[i], gsens[i], eff, ttl, gdesc[i]
        }
        for (i = 0; i < nga; i++) printf "GA\t%s\t%s\t%s\n", ga_p[i], ga_n[i], ga_v[i]

        for (i = 0; i < nk; i++) {
            best = ""; bestlen = 0; bsens = 0; bttl = ""
            for (j = 0; j < ng; j++) {
                pfx = derive_prefix(gpath[j])
                if (index(kvar[i], pfx) == 1 && length(pfx) > bestlen) {
                    best = gpath[j]; bestlen = length(pfx)
                }
            }
            leaf = (best == "" ? kvar[i] : substr(kvar[i], bestlen + 1))
            # Inherit the winning group chain sensitivity.
            for (j = 0; j < ng; j++) {
                if (best != "" && index(best ".", gpath[j] ".") == 1 && gsens[j]) {
                    bsens = 1
                    if (bttl == "") bttl = gttl[j]
                }
            }
            eff = (ksens[i] || bsens) ? 1 : 0
            ttl = (kttl[i] != "" ? kttl[i] : bttl)
            printf "K\t%s\t%s\t%s\t%d\t%d\t%s\t%s\n", kvar[i], best, leaf, ksens[i], eff, ttl, kdesc[i]
        }
        for (i = 0; i < nka; i++) printf "KA\t%s\t%s\t%s\n", ka_k[i], ka_n[i], ka_v[i]
    }
    '
}

# ---------------------------------------------------------------------------
# Canonical renderer
#
# Takes the meta stream on fd 3 and the plaintext on stdin, and re-emits the
# payload in canonical order: groups sorted by path, each preceded by its
# attribute/description header block, keys sorted within their group, ungrouped
# keys last. Every save goes through this, so a hand-edited file comes back
# tidy and splicing is predictable.
#
# Group assignment is NOT recomputed here. It is read from the meta stream, so
# there is exactly one implementation of longest-prefix matching in this file.
# Two implementations that could drift is how a key silently ends up in the
# wrong place, or in no place at all.
#
# With GROUP set, emits only that subtree (the group, its descendants, and
# their keys). With KEEP_HEADER=0, omits the leading file comment.
render() {
    local group="${1:-}"
    awk -F'\t' -v want="$group" '
    BEGIN { ng=0; nk=0 }
    function in_scope(p) {
        if (want == "") return 1
        return (p == want || index(p ".", want ".") == 1)
    }
    # Values come from the payload, everything else from the meta stream.
    FNR==NR {
        if ($1 == "G")  { gp[ng]=$2; gown[ng]=$3; gt[ng]=$5; gd[ng]=$6; ng++ }
        if ($1 == "GA") { gan[$2] = gan[$2] SUBSEP $3 "=" $4 }
        if ($1 == "K")  { kv[nk]=$2; kg[nk]=$3; kown[nk]=$5; kt[nk]=$7; kd[nk]=$8; nk++ }
        if ($1 == "KA") { kan[$2] = kan[$2] SUBSEP $3 "=" $4 }
        next
    }
    {
        line = $0; sub(/\r$/, "", line); sub(/^\xef\xbb\xbf/, "", line)
        if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/) next
        eq = index(line, "=")
        if (eq == 0) next
        v = substr(line, 1, eq-1); gsub(/^[ \t]+|[ \t]+$/, "", v)
        val[v] = substr(line, eq+1)
        has[v] = 1
    }
    function emit_attrs(blob,   n, parts, i) {
        n = split(blob, parts, SUBSEP)
        for (i = 1; i <= n; i++) if (parts[i] != "") printf "#@a %s\n", parts[i]
    }
    function emit_key(i) {
        emit_attrs(kan[kv[i]])
        if (kown[i]) printf "#@sensitive%s\n", (kt[i] != "" ? " ttl=" kt[i] : "")
        if (kd[i] != "") printf "#@d %s\n", kd[i]
        printf "%s=%s\n", kv[i], val[kv[i]]
    }
    END {
        # Sort groups by path so the file reads as a tree.
        for (i = 0; i < ng; i++) order[i] = i
        for (i = 0; i < ng; i++) for (j = i+1; j < ng; j++)
            if (gp[order[j]] < gp[order[i]]) { t=order[i]; order[i]=order[j]; order[j]=t }

        for (oi = 0; oi < ng; oi++) {
            g = order[oi]
            if (!in_scope(gp[g])) continue
            printf "\n"
            emit_attrs(gan[gp[g]])
            # Only print a sensitivity mark the group declares itself. Printing
            # an inherited one would turn inheritance into a copy, and removing
            # the parent mark later would then silently leave the children marked.
            if (gown[g]) printf "#@sensitive%s\n", (gt[g] != "" ? " ttl=" gt[g] : "")
            printf "#@g %s\t%s\n", gp[g], gd[g]
            for (i = 0; i < nk; i++) if (kg[i] == gp[g] && has[kv[i]]) emit_key(i)
        }
        if (want == "") {
            first = 1
            for (i = 0; i < nk; i++) if (kg[i] == "" && has[kv[i]]) {
                if (first) { printf "\n"; first = 0 }
                emit_key(i)
            }
        }
    }
    ' /dev/fd/3 -
}

# ---------------------------------------------------------------------------
# Approval gate
readonly APPROVE_TTL_DEFAULT=900   # 15 min
readonly DENY_TTL=30               # short, but long enough to break a retry loop
readonly DIALOG_TIMEOUT=60         # inside the agent harness's 120s Bash window

target_uid() { id -u "$target_user"; }

cache_dir() {
    local u; u="$(target_uid)"
    if [[ $EUID -eq 0 ]]; then
        if [[ "$OS" == Darwin ]]; then printf '/var/run/agent-secrets-gate/%s' "$u"
        else printf '/run/agent-secrets-gate/%s' "$u"; fi
    else
        printf '%s/agent-secrets-gate' "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
    fi
}

# A verdict cache somebody else can write is a verdict cache somebody else can
# forge. `mkdir -p` is happy to hand back a directory that already exists and
# belongs to another account, which is exactly what a pre-created
# /tmp/agent-secrets-gate would be on a machine with no XDG_RUNTIME_DIR.
ensure_private_dir() {
    local d="$1" owner mode
    mkdir -p "$d" 2>/dev/null || die "cannot create $d"
    chmod 700 "$d" 2>/dev/null || die "cannot restrict $d"
    owner="$(stat_owner_uid "$d" 2>/dev/null)" || die "cannot stat $d"
    mode="$(stat_mode "$d" 2>/dev/null)" || die "cannot stat $d"
    [[ "$owner" == "$EUID" ]] || die "$d belongs to uid $owner, not to this process"
    (( (8#$mode & 8#077) == 0 )) || die "$d is reachable by other accounts"
}

# flock is util-linux and does not exist on macOS. mkdir is atomic everywhere,
# which is all this needs: one dialog at a time per scope. A lock whose owner
# died is stolen after LOCK_STALE seconds, so a crashed request cannot wedge
# the gate until the next reboot.
readonly LOCK_STALE=180
gate_lock=""
acquire_lock() {
    local d="$1" waited=0 now mt
    while ! mkdir "$d" 2>/dev/null; do
        now=$(date +%s)
        mt="$(stat_mtime "$d" 2>/dev/null || echo "$now")"
        # steal a lock whose owner is gone, but never loop back without
        # sleeping: if the rmdir fails for any reason, `continue` here would
        # spin at full speed for as long as the lock exists.
        if (( now - mt > LOCK_STALE )); then rmdir "$d" 2>/dev/null || true; fi
        sleep 1
        waited=$((waited + 1))
        if (( waited > LOCK_STALE )); then die "timed out waiting for the approval lock on $d"; fi
    done
    gate_lock="$d"
    # gate_locked can die on a corrupt verdict cache. without this the lock
    # would then survive its owner and make every later request wait out the
    # staleness timeout. exec in cmd_run happens after the lock is released, so
    # this trap never has anything left to do by then.
    trap release_lock EXIT
}
release_lock() {
    [[ -n "$gate_lock" ]] && rmdir "$gate_lock" 2>/dev/null
    gate_lock=""
    return 0
}

# The desktop environment is read from the user manager, never from the caller.
# A caller-supplied WAYLAND_DISPLAY or DISPLAY is how QT_QPA_PLATFORM=offscreen,
# LD_PRELOAD and PATH shadowing all get their foothold.
user_env_var() {
    local u g; u="$(target_uid)"; g="$(id -g "$target_user")"
    [[ "$OS" == Linux ]] || return 0
    if [[ $EUID -eq 0 ]]; then
        setpriv --reuid="$u" --regid="$g" --clear-groups -- \
            env -i XDG_RUNTIME_DIR="/run/user/$u" /usr/bin/systemctl --user show-environment 2>/dev/null \
            | sed -n "s/^$1=//p" | head -1
    else
        /usr/bin/systemctl --user show-environment 2>/dev/null | sed -n "s/^$1=//p" | head -1
    fi
}

# Ask "is there a live desktop to draw on", not "who am I".
#
# Identity cannot answer this. An agent session's /proc/self/sessionid is the
# systemd user manager's session, the same one the bisync timer runs in, so no
# identity test separates them. And the display environment variables cannot
# answer it either: XWayland means clearing WAYLAND_DISPLAY still reaches the
# screen, and an SSH session that exports DISPLAY=:0 reaches a screen nobody is
# sitting at.
approval_channel_ok() {
    if [[ "$OS" == Darwin ]]; then macos_channel_ok; else linux_channel_ok; fi
}

# macOS has no loginctl, but the question is the same one. /dev/console belongs
# to whoever is logged in at the physical display, which an ssh session never
# is, and ioreg is the only public place the lock state is published.
macos_channel_ok() {
    local console
    [[ -x /usr/sbin/ioreg ]] || return 1
    console="$(stat -f '%Su' /dev/console 2>/dev/null)" || return 1
    [[ "$console" == "$target_user" ]] || return 1
    ! /usr/sbin/ioreg -n Root -d1 2>/dev/null | grep -q 'CGSSessionScreenIsLocked.*Yes'
}

linux_channel_ok() {
    local d act rem seat locked
    command -v loginctl >/dev/null 2>&1 || return 1
    d=$(loginctl show-user "$(target_uid)" --value -p Display 2>/dev/null) || return 1
    [[ -n "$d" ]] || return 1
    act=$(loginctl show-session "$d" --value -p Active 2>/dev/null)
    rem=$(loginctl show-session "$d" --value -p Remote 2>/dev/null)
    seat=$(loginctl show-session "$d" --value -p Seat 2>/dev/null)
    locked=$(loginctl show-session "$d" --value -p LockedHint 2>/dev/null)
    # A locked screen matters on its own: the dialog would render behind the
    # lock and be answered by whoever unlocks the machine, not necessarily its owner.
    [[ "$act" == "yes" && "$rem" == "no" && -n "$seat" && "$locked" != "yes" ]]
}

# 0 = allow, 1 = deny, 2 = timed out, 3 = no dialog, crashed, or killed.
# Anything that is not a plain 0 is treated as absence of consent, never as
# consent: `env -i kdialog` aborts with 134 and no stderr when Qt cannot find a
# platform plugin, which is why this never infers availability from an exit
# status it did not expect.
ask_dialog() {
    if [[ "$OS" == Darwin ]]; then ask_dialog_macos "$@"; else ask_dialog_linux "$@"; fi
}

linux_dialog_tool() {
    local t
    for t in /usr/bin/kdialog /usr/bin/zenity /usr/local/bin/kdialog /usr/local/bin/zenity; do
        [[ -x "$t" ]] && { printf '%s\n' "$t"; return 0; }
    done
    return 1
}

ask_dialog_linux() {
    local title="$1" body="$2" u g rc=0 tool
    tool="$(linux_dialog_tool)" || return 3
    u="$(target_uid)"; g="$(id -g "$target_user")"
    local wd dp xa db
    wd=$(user_env_var WAYLAND_DISPLAY); dp=$(user_env_var DISPLAY)
    xa=$(user_env_var XAUTHORITY);      db=$(user_env_var DBUS_SESSION_BUS_ADDRESS)
    # Catch a stale post-relogin snapshot: the user manager keeps the values it
    # was given at session start, so after a logout WAYLAND_DISPLAY can name a
    # compositor socket that no longer exists.
    [[ -n "$wd" && ! -S "/run/user/$u/$wd" ]] && return 3

    local pre=() args=()
    [[ $EUID -eq 0 ]] && pre=(setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --)
    case "$tool" in
        */kdialog) args=(--title "$title" --warningyesno "$body") ;;
        */zenity)  args=(--question --title="$title" --text="$body"
                         --ok-label=allow --cancel-label=deny) ;;
    esac
    timeout -s TERM "$DIALOG_TIMEOUT" \
        ${pre[@]+"${pre[@]}"} env -i \
            HOME="$target_home" PATH=/usr/bin:/bin \
            XDG_RUNTIME_DIR="/run/user/$u" \
            ${wd:+WAYLAND_DISPLAY="$wd"} ${dp:+DISPLAY="$dp"} \
            ${xa:+XAUTHORITY="$xa"} ${db:+DBUS_SESSION_BUS_ADDRESS="$db"} \
            "$tool" ${args[@]+"${args[@]}"} || rc=$?
    case $rc in 0) return 0;; 1) return 1;; 124) return 2;; *) return 3;; esac
}

# The title and body are passed as osascript argv rather than spliced into the
# script text, so a description containing a quote cannot rewrite the dialog.
# `launchctl asuser` is how root reaches the GUI session on macOS; without it
# osascript has no window server to draw on.
ask_dialog_macos() {
    local title="$1" body="$2" u out rc=0 pre=()
    u="$(target_uid)"
    [[ -x /usr/bin/osascript ]] || return 3
    if [[ $EUID -eq 0 ]]; then
        [[ -x /bin/launchctl && -x /usr/bin/sudo ]] || return 3
        pre=(/bin/launchctl asuser "$u" /usr/bin/sudo -n -u "#$u" --)
    fi
    out="$(${pre[@]+"${pre[@]}"} /usr/bin/osascript - "$title" "$body" "$DIALOG_TIMEOUT" 2>/dev/null <<'APPLESCRIPT'
on run argv
    set dialogTitle to item 1 of argv
    set dialogBody to item 2 of argv
    set limit to (item 3 of argv) as integer
    set answer to display dialog dialogBody with title dialogTitle ¬
        buttons {"deny", "allow"} default button "deny" ¬
        with icon caution giving up after limit
    if gave up of answer then
        return "timeout"
    else if button returned of answer is "allow" then
        return "allow"
    else
        return "deny"
    end if
end run
APPLESCRIPT
    )" || rc=$?
    (( rc != 0 )) && return 3
    case "$out" in
        allow)   return 0 ;;
        deny)    return 1 ;;
        timeout) return 2 ;;
        *)       return 3 ;;
    esac
}

# Verdicts are cached by (scope, group), not by caller. Every agent Bash call
# is fresh, so a pid-based cache would prompt every time. A single lock for a
# scope lets one request batch every uncached item and prevents parallel callers
# from stacking overlapping dialogs.
cached_verdict() {
    local scope="$1" group="$2" dir="$3" g="$2" now verdict exp
    now=$(date +%s)
    while :; do
        local f="$dir/${scope}__${g//./_}"
        if [[ -f "$f" ]]; then
            IFS=' ' read -r verdict exp < "$f" || true
            if [[ "$exp" =~ ^[0-9]+$ && $now -lt $exp ]]; then
                printf '%s\n' "$verdict"
                return 0
            fi
        fi
        [[ "$g" == *.* ]] || break
        g="${g%.*}"
    done
    return 0
}

validate_motive() {
    local motive="$1"
    [[ -n "$motive" ]] || die "motive must not be empty"
    [[ ${#motive} -le 160 ]] || die "motive must be 160 characters or fewer"
    [[ "$motive" != *$'\n'* && "$motive" != *$'\r'* && "$motive" != *$'\t'* ]] || \
        die "motive must be one line"
    [[ "$motive" =~ ^[[:print:]]+$ ]] || die "motive must use printable characters"
}

effective_ttl() {
    local ttl="$1"
    [[ "$ttl" =~ ^[0-9]+$ ]] || ttl="$APPROVE_TTL_DEFAULT"
    printf '%s\n' "$ttl"
}

batch_dialog_body() {
    local scope="$1" motive="$2" entries="$3" max_ttl="$4"
    printf 'a process requests sensitive secrets in scope %s.\n\nmotive: %s\n\nrequested items:\n%s\nallow these items for up to %d minutes?' \
        "$scope" "${motive:-no motive supplied.}" "$entries" "$((max_ttl / 60))"
}

# The journal is the one record the calling process cannot rewrite.
log_verdict() { logger -p authpriv.notice -t agent-secrets-helper "scope=$1 group=$2 verdict=$3" 2>/dev/null || true; }

# ---------------------------------------------------------------------------
# Verbs. Every one writes to stdout and never to a file.
#
# This is deliberate. If the helper wrote scopes/<scope>.env.gpg the file would
# land root:root, and `rclone bisync` running as the user could no longer
# replace it. The sync would stop, silently, on the one directory whose whole
# job is being your backup. So the unprivileged wrapper keeps doing its own
# mktemp/$EDITOR/mv dance and the helper stays a pure filter.

plaintext_of() { raw_decrypt "$(scope_file "$1")" | tr -d '\r'; }

# What has to be approved, and under what name.
#
# Two sources, and missing either one is a hole. A group carrying its own
# #@sensitive mark covers everything beneath it, so gating the declared roots is
# enough. But a key can also be marked on its own, with no sensitive group
# anywhere above it, and reading only the G records lets that key straight out.
#
# A key-level mark is suppressed when an ancestor group is already marked,
# because the group prompt already covers it and two dialogs for one read is
# how prompt fatigue starts.
sensitive_roots() {
    awk -F'\t' '
      $1=="G" && $3=="1" { own[$2]=1; printf "%s\t%s\t%s\n", $2, $6, $5 }
      $1=="K" && $5=="1" {
          covered=0; g=$3
          while (g != "") {
              if (g in own) { covered=1; break }
              if (index(g,".")==0) break
              sub(/\.[^.]*$/, "", g)
          }
          if (!covered) printf "%s\t%s\t%s\n", $2, $8, $7
      }'
}

# True when the gate identity (a dotted group path, or a bare VARIABLE_NAME for
# a key marked on its own) falls inside the subtree being asked for.
in_request() {
    local id="$1" group="$2" keygroup="$3"
    [[ -z "$group" ]] && return 0
    [[ "$id" == "$group" || "$id" == "$group".* || "$group" == "$id".* ]] && return 0
    [[ -n "$keygroup" && ( "$keygroup" == "$group" || "$keygroup" == "$group".* || "$group" == "$keygroup".* ) ]] && return 0
    return 1
}

# Gate every sensitive root selected by one or more group paths. The request is
# approved or denied as one set, so a task that needs several known groups gets
# one readable dialog rather than a click-through stream.
#
# Candidates travel as tab-separated lines rather than in an associative array.
# This file has to run under the bash 3.2 that macOS ships at the only bash
# path root actually owns, and bash 3.2 has no `declare -A` and no `mapfile`.
gate_for() {
    local scope="$1" meta="$2" motive="$3"
    shift 3
    [[ $# -eq 0 ]] && set -- ""
    local roots; roots=$(sensitive_roots <<< "$meta")
    [[ -z "$roots" ]] && return 0

    local candidates="" seen="" id desc ttl kg group matches
    while IFS=$'\t' read -r id desc ttl; do
        [[ -z "$id" ]] && continue
        case "$seen" in *"|$id|"*) continue ;; esac
        kg=""
        case "$id" in
            [A-Z]*) kg=$(awk -F'\t' -v v="$id" '$1=="K" && $2==v { print $3 }' <<< "$meta") ;;
        esac
        matches=false
        for group in "$@"; do
            if in_request "$id" "$group" "$kg"; then matches=true; break; fi
        done
        $matches || continue
        seen="$seen|$id|"
        candidates="$candidates$id"$'\t'"$desc"$'\t'"$(effective_ttl "$ttl")"$'\n'
    done <<< "$roots"
    [[ -n "$candidates" ]] || return 0

    # Sorting makes the dialog and the audit log deterministic.
    candidates="$(printf '%s' "$candidates" | sort)"

    local dir; dir="$(cache_dir)"
    ensure_private_dir "$dir"
    acquire_lock "$dir/.lock.$scope"
    local rc=0
    gate_locked "$scope" "$motive" "$dir" "$candidates" || rc=$?
    release_lock
    return $rc
}

# Runs with the per-scope lock held, so one request can batch every uncached
# item and parallel callers cannot stack overlapping dialogs.
gate_locked() {
    local scope="$1" motive="$2" dir="$3" candidates="$4"
    local pending="" id desc ttl verdict now entries="" entry count=0 max_ttl=0 rc=0

    while IFS=$'\t' read -r id desc ttl; do
        [[ -z "$id" ]] && continue
        verdict="$(cached_verdict "$scope" "$id" "$dir")"
        case "$verdict" in
            allow) log_verdict "$scope" "$id" cached-allow ;;
            deny)  log_verdict "$scope" "$id" cached-deny
                   echo "agent-secrets-gate: denied scope=$scope group=$id" >&2
                   return $EX_NOPERM ;;
            '')    pending="$pending$id"$'\t'"$desc"$'\t'"$ttl"$'\n' ;;
            *)     die "bad cached approval verdict" ;;
        esac
    done <<< "$candidates"
    [[ -n "$pending" ]] || return 0

    if ! approval_channel_ok; then
        while IFS=$'\t' read -r id desc ttl; do
            [[ -n "$id" ]] && log_verdict "$scope" "$id" no-channel
        done <<< "$pending"
        echo "agent-secrets-gate: unavailable scope=$scope (no active local session to ask)" >&2
        return $EX_UNAVAILABLE
    fi

    while IFS=$'\t' read -r id desc ttl; do
        [[ -z "$id" ]] && continue
        printf -v entry ' - %s: %s\n' "$id" "${desc:-no description recorded.}"
        entries="$entries$entry"
        count=$((count + 1))
        (( ttl > max_ttl )) && max_ttl="$ttl"
    done <<< "$pending"

    ask_dialog "secret access: $count item(s)" \
        "$(batch_dialog_body "$scope" "$motive" "$entries" "$max_ttl")" || rc=$?
    now=$(date +%s)
    case $rc in
        0) while IFS=$'\t' read -r id desc ttl; do
               [[ -z "$id" ]] && continue
               printf 'allow %s\n' "$((now + ttl))" > "$dir/${scope}__${id//./_}"
               log_verdict "$scope" "$id" allow-batch
           done <<< "$pending"
           return 0 ;;
        1) while IFS=$'\t' read -r id desc ttl; do
               [[ -z "$id" ]] && continue
               printf 'deny %s\n' "$((now + DENY_TTL))" > "$dir/${scope}__${id//./_}"
               log_verdict "$scope" "$id" deny-batch
           done <<< "$pending"
           echo "agent-secrets-gate: denied scope=$scope requested-items=$count" >&2
           return $EX_NOPERM ;;
        2) while IFS=$'\t' read -r id desc ttl; do
               [[ -n "$id" ]] && log_verdict "$scope" "$id" timeout
           done <<< "$pending"
           echo "agent-secrets-gate: timeout scope=$scope (nothing cached, re-run to ask again)" >&2
           return $EX_TEMPFAIL ;;
        *) while IFS=$'\t' read -r id desc ttl; do
               [[ -n "$id" ]] && log_verdict "$scope" "$id" dialog-failed
           done <<< "$pending"
           echo "agent-secrets-gate: dialog failed scope=$scope" >&2
           return $EX_TEMPFAIL ;;
    esac
}

cmd_index() {
    local scope="$1" file plain
    file="$(scope_file "$scope")"
    plain="$(plaintext_of "$scope")"
    printf '#toc1\tscope=%s\tsha256=%s\n' "$scope" "$(sha256_of_stdin < "$file")"
    parse_meta <<< "$plain"
}

cmd_keys() {
    local scope="$1" plain
    validate_scope "$scope"
    plain="$(plaintext_of "$scope")"
    parse_meta <<< "$plain" | awk -F'\t' '$1=="K" { print $2 }'
}

# adding and replacing values happens here so the unprivileged command never
# needs to hold the rest of a decrypted scope. the value arrives on stdin,
# never in argv, shell history, or a process listing.
cmd_set() {
    local scope="$1" var="$2" desc="$3" force="$4" value plain meta updated
    validate_scope "$scope"
    [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "bad variable name"
    [[ "$force" == 0 || "$force" == 1 ]] || die "set force flag must be 0 or 1"
    value="$(cat)"
    value="${value%$'\n'}"
    [[ -n "$value" ]] || die "secret value must not be empty"
    [[ "$value" != *$'\n'* ]] || die "secret values must use one line"
    [[ "$value" != *$'\r'* ]] || die "secret values must not contain carriage returns"
    [[ "$desc" != *$'\n'* && "$desc" != *$'\r'* && "$desc" != *$'\t'* ]] || \
        die "secret descriptions must use one plain line"
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    gate_for "$scope" "$meta" "store a secret value." "" || return $?
    if grep -q "^$var=" <<< "$plain"; then
        [[ "$force" == 1 ]] || die "$var already exists; use --force to replace it"
        updated="$(
            while IFS= read -r line || [[ -n "$line" ]]; do
                if [[ "$line" == "$var="* ]]; then
                    printf '%s=%s\n' "$var" "$value"
                else
                    printf '%s\n' "$line"
                fi
            done <<< "$plain"
        )"
    else
        updated="$plain"
        [[ -n "$desc" ]] && updated+=$'\n'"#@d $desc"
        updated+=$'\n'"$var=$value"
    fi
    printf '%s\n' "$updated" | cmd_encrypt "$scope"
}

cmd_decrypt() {
    local scope="$1" group="" motive="" plain meta
    shift
    if [[ "${1:-}" != "--motive" && $# -gt 0 ]]; then group="$1"; shift; fi
    if [[ $# -gt 0 ]]; then
        [[ "$1" == "--motive" && $# -eq 2 ]] || die "decrypt takes a scope, optional group, and optional --motive"
        motive="$2"
        validate_motive "$motive"
    fi
    validate_group "$group"
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    require_group "$meta" "$scope" "$group"
    gate_for "$scope" "$meta" "$motive" "$group" || return $?
    if [[ -z "$group" ]]; then
        printf '%s\n' "$plain"
    else
        render "$group" 3< <(printf '%s\n' "$meta") <<< "$plain"
    fi
}

cmd_run() {
    local scope="$1" group="" motive="" plain meta line
    shift
    if [[ "${1:-}" != "--motive" && "${1:-}" != "--" && $# -gt 0 ]]; then
        group="$1"
        shift
    fi
    if [[ "${1:-}" == "--motive" ]]; then
        [[ $# -ge 2 ]] || die "run needs a motive"
        motive="$2"
        validate_motive "$motive"
        shift 2
    fi
    [[ "${1:-}" == "--" ]] || die "run needs -- before the command"
    shift
    [[ $# -gt 0 ]] || die "run needs a command"
    validate_scope "$scope"
    validate_group "$group"
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    require_group "$meta" "$scope" "$group"
    gate_for "$scope" "$meta" "$motive" "$group" || return $?
    local -a env_args=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        line="${line#$'\xef\xbb\xbf'}"
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# || "$line" != *=* ]] && continue
        env_args+=("$line")
    done <<< "$(
        if [[ -n "$group" ]]; then
            render "$group" 3< <(printf '%s\n' "$meta") <<< "$plain"
        else
            printf '%s\n' "$plain"
        fi
    )"
    local child_path=/usr/local/bin:/usr/bin:/bin
    [[ "$OS" == Darwin ]] && child_path=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
    if [[ $EUID -eq 0 ]]; then
        # setpriv is util-linux. On macOS `sudo -u` is the supported way for
        # root to become another account, and the `env -i` after it means
        # sudo's own environment handling never gets a say.
        local drop=()
        if [[ "$OS" == Darwin ]]; then
            drop=(/usr/bin/sudo -n -u "#$(target_uid)" --)
        else
            drop=(setpriv --reuid="$(target_uid)" --regid="$(id -g "$target_user")" --init-groups --)
        fi
        exec "${drop[@]}" \
            env -i HOME="$target_home" USER="$target_user" LOGNAME="$target_user" \
            PATH="$child_path" ${env_args[@]+"${env_args[@]}"} "$@"
    fi
    exec env ${env_args[@]+"${env_args[@]}"} "$@"
}

# Canonicalises before encrypting, so every save leaves the file tidy and the
# next splice is predictable.
cmd_encrypt() {
    local scope="$1" plain meta bad
    validate_scope "$scope"
    plain="$(cat)"; plain="${plain//$'\r'/}"
    bad="$(grep -nv -e '^[[:space:]]*$' -e '^#' <<< "$plain" | grep -v '=' || true)"
    [[ -n "$bad" ]] && die "every line must be KEY=VALUE or a '#' comment: $bad"
    meta="$(parse_meta <<< "$plain")"
    local errs; errs="$(grep '^E' <<< "$meta" || true)"
    [[ -n "$errs" ]] && { printf '%s\n' "$errs" >&2; die "refusing to write a scope with metadata errors"; }
    # Every save is a full decode and re-encode of the caller's data: the
    # payload is reparsed and the file is rebuilt from the meta stream. So a
    # renderer that ever fails to emit a key it parsed does not corrupt the
    # file, it silently shortens it. The save succeeds, the index rebuilds,
    # and nothing looks wrong until the value is needed and is not there.
    #
    # This compares what went in against what is about to be written, and
    # refuses rather than shortening. It is deliberately a runtime check and
    # not only a test: the tests protect this repository, and this protects
    # the store of somebody running a version nobody tested.
    local canonical; canonical="$(render "" 3< <(printf '%s\n' "$meta") <<< "$plain")"
    local lost; lost="$(
        comm -23 \
            <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' <<< "$plain" | sed 's/=$//' | sort -u) \
            <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' <<< "$canonical" | sed 's/=$//' | sort -u)
    )"
    if [[ -n "$lost" ]]; then
        printf 'agent-secrets-helper: these keys would be dropped by this save:\n' >&2
        printf '  %s\n' $lost >&2
        die "refusing to write a scope that loses keys"
    fi
    printf '%s\n' "$canonical" | raw_encrypt
}

# ---------------------------------------------------------------------------
# Rekey
#
# This is the one verb that writes files. Every other verb is a filter, for a
# good reason: a file the helper writes lands root-owned, and the unprivileged
# half could no longer replace it. So cmd_rekey hands ownership of each scope
# back to the caller afterwards, and only the key stays root's.
#
# Nothing here is released to anyone. The plaintext is decrypted and
# re-encrypted inside this process and never reaches a caller, so there is no
# approval dialog: the gate exists to stop values reaching a process, and this
# operation gives a value to nobody.
#
# The ordering is the whole design. A rekey that swapped the key and the scopes
# in the wrong order, or without keeping the old key, would have a window where
# a kill -9 leaves scopes nobody can read. Instead:
#
#   1. every scope is re-encrypted under the new key into a staging file, and
#      each staging file is decrypted again and compared with the original
#      plaintext before anything is committed.
#   2. the old key is copied aside, then the new key takes its place.
#   3. the staged scopes replace the real ones, one at a time.
#
# Between 2 and 3 the store is mixed: some scopes on the new key, some on the
# old. raw_decrypt tries both, so every scope opens throughout. Interrupt it
# anywhere and the store still works; rerunning finishes the job.
rekey_cleanup() {
    rm -f "$SCOPES_DIR"/*.env.gpg.rekey "$SECRETS_DIR/key/.key.new" 2>/dev/null || true
}

# A scope this process wrote is owned by root. Give it back, or the next
# secret-edit cannot replace it and rclone can no longer sync it.
own_as_caller() {
    [[ $EUID -eq 0 ]] || return 0
    chown "$(target_uid):$(id -g "$target_user")" "$1"
    chmod 600 "$1"
}

cmd_rekey() {
    [[ -f "$KEY_FILE" ]] || die "no key at $KEY_FILE"
    [[ -f "$KEY_FILE_OLD" ]] && \
        die "a previous rekey was never finished. check your scopes open, then run: secret-rekey --finish"

    local scopes=() f
    shopt -s nullglob
    for f in "$SCOPES_DIR"/*.env.gpg; do scopes+=("$f"); done
    shopt -u nullglob

    trap rekey_cleanup EXIT
    rekey_cleanup

    local newkey="$SECRETS_DIR/key/.key.new"
    generate_key_material > "$newkey"
    chmod 600 "$newkey"

    local plain check name
    for f in ${scopes[@]+"${scopes[@]}"}; do
        name="${f##*/}"; name="${name%.env.gpg}"
        plain="$(raw_decrypt "$f")" || die "cannot decrypt $name; nothing was changed"
        printf '%s\n' "$plain" | encrypt_with "$newkey" > "$f.rekey" \
            || die "cannot re-encrypt $name; nothing was changed"
        # Read it back before trusting it. This is the only moment where a bad
        # write is still free to undo.
        check="$(decrypt_with "$newkey" "$f.rekey")" \
            || die "$name did not decrypt under the new key; nothing was changed"
        [[ "$check" == "$plain" ]] \
            || die "$name did not survive re-encryption intact; nothing was changed"
        echo "  verified $name" >&2
    done

    cp "$KEY_FILE" "$KEY_FILE_OLD"
    chmod 600 "$KEY_FILE_OLD"
    mv -f "$newkey" "$KEY_FILE"
    chmod 600 "$KEY_FILE"

    for f in ${scopes[@]+"${scopes[@]}"}; do
        mv -f "$f.rekey" "$f"
        own_as_caller "$f"
    done

    trap - EXIT
    logger -p authpriv.notice -t agent-secrets-helper "rekey scopes=${#scopes[@]}" 2>/dev/null || true
    printf '%s\n' "${#scopes[@]}"
}

# Finishing what an interrupted rekey left behind.
#
# After a kill the store can hold a mix: some scopes on the new key, some still
# on the old. cmd_rekey refuses to run then, because generating a second new
# key would overwrite the old one and strand whatever still needs it. So this
# converts the stragglers using the key pair already on disk, and generates
# nothing.
cmd_rekey_resume() {
    [[ -f "$KEY_FILE_OLD" ]] || die "no rekey is in progress"
    local f name plain check moved=0
    trap rekey_cleanup EXIT
    rekey_cleanup
    shopt -s nullglob
    for f in "$SCOPES_DIR"/*.env.gpg; do
        name="${f##*/}"; name="${name%.env.gpg}"
        if decrypt_with "$KEY_FILE" "$f" >/dev/null; then
            continue
        fi
        plain="$(decrypt_with "$KEY_FILE_OLD" "$f")" \
            || die "$name opens under neither key. leaving it alone"
        printf '%s\n' "$plain" | encrypt_with "$KEY_FILE" > "$f.rekey" \
            || die "cannot re-encrypt $name; nothing was changed"
        check="$(decrypt_with "$KEY_FILE" "$f.rekey")" \
            || die "$name did not decrypt under the current key; nothing was changed"
        [[ "$check" == "$plain" ]] \
            || die "$name did not survive re-encryption intact; nothing was changed"
        mv -f "$f.rekey" "$f"
        own_as_caller "$f"
        moved=$((moved + 1))
        echo "  moved $name" >&2
    done
    shopt -u nullglob
    trap - EXIT
    logger -p authpriv.notice -t agent-secrets-helper "rekey-resume scopes=$moved" 2>/dev/null || true
    printf '%s\n' "$moved"
}

# Removing the old key is the irreversible half, so it is a separate verb and
# it checks first: every scope has to open under the new key alone.
cmd_rekey_finish() {
    [[ -f "$KEY_FILE_OLD" ]] || die "there is no previous key to remove"
    local f name checked=0
    shopt -s nullglob
    for f in "$SCOPES_DIR"/*.env.gpg; do
        name="${f##*/}"; name="${name%.env.gpg}"
        decrypt_with "$KEY_FILE" "$f" >/dev/null \
            || die "$name does not open under the current key. the old key is being kept"
        checked=$((checked + 1))
    done
    shopt -u nullglob
    rm -f "$KEY_FILE_OLD"
    logger -p authpriv.notice -t agent-secrets-helper "rekey-finish scopes=$checked" 2>/dev/null || true
    printf '%s\n' "$checked"
}

cmd_edit_extract() {
    local scope="$1" group="$2"
    [[ -n "$group" ]] || die "edit-extract needs a group"
    cmd_decrypt "$scope" "$group" --motive "Edit the requested secret group."
}

# Replaces one subtree and re-emits the whole scope. The filter has to be
# applied here rather than in the wrapper: a wrapper that decrypted everything
# and then sliced would already have seen every sensitive value.
cmd_edit_merge() {
    local scope="$1" group="$2" plain meta edited
    [[ -n "$group" ]] || die "edit-merge needs a group"
    validate_group "$group"
    edited="$(cat)"; edited="${edited//$'\r'/}"
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    require_group "$meta" "$scope" "$group"
    gate_for "$scope" "$meta" "Save changes to the requested secret group." "$group" || return $?
    # Everything outside the subtree, unchanged, plus the edited subtree.
    local rest; rest="$(render_excluding "$group" "$meta" "$plain")"
    local merged; merged="$(printf '%s\n%s\n' "$rest" "$edited")"

    # Every key that lives outside the edited subtree has to survive the
    # splice. This is measured against the original plaintext, not against
    # $rest, because $rest coming back wrong is the entire failure mode: a
    # check that trusted it would agree with the bug. cmd_encrypt cannot catch
    # this either, since by then the keys are already missing from its input.
    local outside; outside="$(awk -F'\t' -v g="$group" '
        $1=="K" && !($3==g || index($3 ".", g ".")==1) { print $2 }' <<< "$meta" | sort -u)"
    if [[ -n "$outside" ]]; then
        local dropped; dropped="$(
            comm -23 <(printf '%s\n' "$outside") \
                     <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' <<< "$merged" | sed 's/=$//' | sort -u)
        )"
        if [[ -n "$dropped" ]]; then
            printf 'agent-secrets-helper: these keys are outside %s and would be lost:\n' "$group" >&2
            printf '  %s\n' $dropped >&2
            die "refusing to splice a group edit that loses the rest of the scope"
        fi
    fi
    printf '%s\n' "$merged" | cmd_encrypt "$scope"
}

# Everything in the scope except the named subtree, as a filtered meta stream.
#
# This used to build two newline-separated lists in the shell and hand them to
# awk with -v. The awk that ships with macOS rejects that outright: a -v
# assignment there cannot contain a newline ("awk: newline in string"). Nothing
# checked, because the failure happened inside a process substitution, whose
# exit status the caller never sees. So render_excluding returned nothing, and
# `secret-edit <scope> <group>` wrote back a scope containing only the group
# that had just been edited. Every other group, silently gone, on every mac.
#
# One pass now, and the only -v is a single-line group path.
render_excluding() {
    local group="$1" meta="$2" plain="$3"
    render "" 3< <(awk -F'\t' -v g="$group" '
      function inside(p) { return (p == g || index(p ".", g ".") == 1) }
      { rec[NR] = $0; t[NR] = $1; id[NR] = $2 }
      $1=="K" && !inside($3) { keepk[$2] = 1 }
      $1=="G" &&  inside($2) { dropg[$2] = 1 }
      END {
        for (i = 1; i <= NR; i++) {
          if (t[i] == "G" || t[i] == "GA") { if (!(id[i] in dropg)) print rec[i]; continue }
          if (t[i] == "K" || t[i] == "KA") { if (id[i] in keepk)    print rec[i]; continue }
        }
      }' <<< "$meta") <<< "$plain"
}

main() {
    [[ $# -ge 1 ]] || die "usage: secret-helper <verb> [args]"
    local verb="$1"; shift
    case "$verb" in
        version)      [[ $# -eq 0 ]] || die "version takes no arguments"; printf '%s\n' "$HELPER_PROTOCOL" ;;
        index)        [[ $# -eq 1 ]] || die "index takes a scope"; cmd_index "$1" ;;
        keys)         [[ $# -eq 1 ]] || die "keys takes a scope"; cmd_keys "$1" ;;
        set)          [[ $# -eq 4 ]] || die "set takes a scope, variable, description, and force flag"; cmd_set "$@" ;;
        decrypt)      [[ $# -ge 1 && $# -le 4 ]] || die "decrypt takes a scope, optional group, and optional --motive"; cmd_decrypt "$@" ;;
        run)          [[ $# -ge 3 ]] || die "run takes a scope, optional group, and a command"; cmd_run "$@" ;;
        encrypt)      [[ $# -eq 1 ]] || die "encrypt takes a scope"; cmd_encrypt "$1" ;;
        edit-extract) [[ $# -eq 2 ]] || die "edit-extract takes a scope and group"; cmd_edit_extract "$@" ;;
        edit-merge)   [[ $# -eq 2 ]] || die "edit-merge takes a scope and group"; cmd_edit_merge "$@" ;;
        rekey)        [[ $# -eq 0 ]] || die "rekey takes no arguments"; cmd_rekey ;;
        rekey-resume) [[ $# -eq 0 ]] || die "rekey-resume takes no arguments"; cmd_rekey_resume ;;
        rekey-finish) [[ $# -eq 0 ]] || die "rekey-finish takes no arguments"; cmd_rekey_finish ;;
        gate)         [[ $# -ge 2 ]] || die "gate takes a scope, optional --motive, and one or more groups"
                      local_gate_scope="$1"; shift
                      local_gate_motive=""
                      if [[ "${1:-}" == "--motive" ]]; then
                          [[ $# -ge 3 ]] || die "gate needs a motive and one or more groups"
                          local_gate_motive="$2"; validate_motive "$local_gate_motive"; shift 2
                      fi
                      validate_scope "$local_gate_scope"
                      for local_gate_group in "$@"; do validate_group "$local_gate_group"; done
                      local_gate_meta="$(parse_meta <<< "$(plaintext_of "$local_gate_scope")")"
                      for local_gate_group in "$@"; do
                          require_group "$local_gate_meta" "$local_gate_scope" "$local_gate_group"
                      done
                      gate_for "$local_gate_scope" "$local_gate_meta" "$local_gate_motive" "$@" ;;
        *)            die "unknown verb" ;;
    esac
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && main "$@"
