#!/bin/bash -p
# Privileged half of the secrets tooling. Installed at /usr/local/libexec/secret-helper,
# root:root 0755, reached through one NOPASSWD sudoers line.
#
# Everything that can see plaintext lives here, for two reasons. The key is
# root-owned, so the unprivileged wrappers cannot decrypt on their own
# even if an agent rewrites them. And the group filter for `secret-edit <scope>
# <group>` has to be applied before the plaintext leaves this process: a wrapper
# that decrypted the whole scope and then filtered would already have seen every
# sensitive value, and the gate would have bought nothing.
#
# `-p` in the shebang is load-bearing. Privileged mode makes bash ignore
# BASH_ENV, ENV, SHELLOPTS and functions exported through the environment, none
# of which sudo's env_reset can be relied on alone to strip.
#
# sudoers cannot restrict arguments: a Cmnd listed without an argument spec
# permits ANY argv, and no wildcard form changes that. So every check that
# matters is in this file, and the caller-side checks in secret-common.sh
# are conveniences with no security value once sudo is in the picture.
set -euo pipefail

umask 077
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

die() { echo "agent-secrets-helper: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Platform layer
#
# This block is duplicated, on purpose, in bin/secret-common.sh. The helper
# runs as root through sudo and must never source a file the calling account
# can write, so a shared lib/portable.sh would be a one-line privilege
# escalation. Two small copies are the price of not having that hole.
#
# Everything below is written for bash 3.2, because that is what macOS ships
# at the one bash path root actually owns. Associative arrays and mapfile are
# bash 4 and are deliberately absent from this file.

OS="$(uname -s)"
readonly OS
case "$OS" in
    Linux|Darwin) ;;
    CYGWIN*|MINGW*|MSYS*)
        die "windows is not supported natively; run this inside wsl2" ;;
    *) die "unsupported platform: $OS (linux and macos only)" ;;
esac

if [[ ${BASH_VERSINFO[0]:-0} -lt 3 ]] || { [[ ${BASH_VERSINFO[0]:-0} -eq 3 ]] && [[ ${BASH_VERSINFO[1]:-0} -lt 2 ]]; }; then
    die "needs bash 3.2 or newer (found ${BASH_VERSION:-unknown})"
fi

# `-p` in the shebang is the reason this file can ignore its environment. If
# something stripped it, the guarantees in the header comment are gone.
if [[ $EUID -eq 0 ]] && [[ ! -o privileged ]]; then
    die "refusing to run as root without bash privileged mode; the shebang must keep -p"
fi

stat_owner_uid() { if [[ "$OS" == Darwin ]]; then stat -f '%u' -- "$1"; else stat -c '%u' -- "$1"; fi; }
stat_mode()      { if [[ "$OS" == Darwin ]]; then stat -f '%Lp' -- "$1"; else stat -c '%a' -- "$1"; fi; }
stat_mtime()     { if [[ "$OS" == Darwin ]]; then stat -f '%m' -- "$1"; else stat -c '%Y' -- "$1"; fi; }

sha256_of_stdin() {
    if [[ "$OS" == Darwin ]]; then shasum -a 256; else sha256sum; fi | cut -d' ' -f1
}

home_of() {
    local u="$1" h=""
    if command -v getent >/dev/null 2>&1; then
        h="$(getent passwd "$u" | cut -d: -f6)"
    elif [[ "$OS" == Darwin ]]; then
        h="$(dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | sed 's/^NFSHomeDirectory: *//')"
    fi
    [[ -n "$h" ]] || return 1
    printf '%s\n' "$h"
}

# True when root, and only root, can replace this path or any directory above
# it. A helper that runs as root but calls a binary under a prefix the caller
# owns is not a privileged helper at all, and on macOS that is the normal
# state of affairs: homebrew's /opt/homebrew, and /usr/local on intel macs,
# are both writable by the admin account.
#
# Symlinks are the subtle part. A symlink's own permission bits are always 0777
# and the kernel ignores them completely: what governs access is the target,
# and what stops the link being repointed is write permission on the directory
# holding it, which this walk checks on the way up. Treating that 0777 as
# world-writable rejected /bin/bash on every usr-merged distribution, which is
# to say on Arch, Fedora, and current Debian and Ubuntu. So a symlink is
# checked for ownership, its mode is skipped, and its target is walked too.
path_is_trusted() {
    _trusted_walk "$1" 0
}

_trusted_walk() {
    local p="$1" depth="$2" owner mode link
    (( depth > 64 )) && return 1
    [[ -e "$p" ]] || return 1
    while :; do
        owner="$(stat_owner_uid "$p" 2>/dev/null)" || return 1
        [[ "$owner" == 0 ]] || return 1
        if [[ -L "$p" ]]; then
            link="$(readlink "$p" 2>/dev/null)" || return 1
            case "$link" in
                /*) ;;
                *) link="$(dirname -- "$p")/$link" ;;
            esac
            _trusted_walk "$link" "$((depth + 1))" || return 1
        else
            mode="$(stat_mode "$p" 2>/dev/null)" || return 1
            (( (8#$mode & 8#022) == 0 )) || return 1
        fi
        [[ "$p" == "/" ]] && return 0
        p="$(dirname -- "$p")"
    done
}

# Absolute, never resolved through PATH. In root mode an untrusted candidate is
# skipped rather than used, so the search can fall through to a safe one.
resolve_gpg() {
    local c found_untrusted=""
    for c in /usr/bin/gpg /usr/bin/gpg2 /opt/local/bin/gpg \
             /usr/local/bin/gpg /usr/local/bin/gpg2 /opt/homebrew/bin/gpg; do
        [[ -x "$c" ]] || continue
        if [[ $EUID -eq 0 ]] && ! path_is_trusted "$c"; then
            [[ -n "$found_untrusted" ]] || found_untrusted="$c"
            continue
        fi
        printf '%s\n' "$c"
        return 0
    done
    [[ -n "$found_untrusted" ]] && { printf '!%s\n' "$found_untrusted"; return 0; }
    return 1
}

GPG="$(resolve_gpg)" || die "no gpg found. install gnupg and run the installer again"
if [[ "$GPG" == '!'* ]]; then
    die "the only gpg on this machine is ${GPG#!}, which your account can replace. a root-owned helper cannot call it. install gnupg under a root-owned prefix, or use the unhardened mode"
fi
readonly GPG
# appended, never prepended. gpg is called by absolute path and finds its own
# agent through its compiled-in libexec dir, so this is only a fallback for odd
# installs. prepending it would put a homebrew prefix ahead of /usr/bin for the
# rest of this file, quietly swapping awk, sed and grep for different
# implementations in the one program that must not behave differently.
gpg_dir="$(dirname -- "$GPG")"
export PATH="$PATH:$gpg_dir"

if [[ $EUID -eq 0 ]]; then
    [[ -n "${SUDO_USER:-}" && "${SUDO_USER:-}" != root ]] || \
        die "run this through sudo from the account that owns the store"
    readonly target_user="$SUDO_USER"
    target_home="$(home_of "$target_user")" || die "cannot find a home directory for $target_user"
    readonly target_home
    readonly SECRETS_DIR="$target_home/.secrets"
else
    target_user="$(id -un)"
    readonly target_user
    readonly target_home="$HOME"
    readonly SECRETS_DIR="${AGENT_SECRETS_DIR:-$HOME/.secrets}"
fi
readonly SCOPES_DIR="$SECRETS_DIR/scopes"
readonly KEY_FILE="$SECRETS_DIR/key/.key"
# Only present while a rekey is in flight, or after one that has not been
# finished. See cmd_rekey for why keeping it is what makes a rekey safe to
# interrupt.
readonly KEY_FILE_OLD="$SECRETS_DIR/key/.key.old"

# sysexits, so a verdict can never be confused with a child's ordinary exit 1.
readonly EX_UNAVAILABLE=69   # no approval channel
readonly EX_TEMPFAIL=75      # dialog timed out, was killed, or crashed
readonly EX_NOPERM=77        # user said no
# part of the documented exit contract even where this file does not raise it.
# shellcheck disable=SC2034
readonly EX_CONFIG=78        # stale index or malformed metadata
readonly HELPER_PROTOCOL=9    # --for, approvals refresh on use

# A scope name becomes a filename. Re-validated here rather than trusted from
# the caller: this is the check that stops `decrypt ../../root/.ssh/id_ed25519`.
validate_scope() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "bad scope name"
}

# A group path becomes a variable-name prefix. Same reasoning.
validate_group() {
    [[ -z "$1" ]] && return 0
    [[ "$1" =~ ^[a-z0-9][a-z0-9_]*(\.[a-z0-9][a-z0-9_]*)*$ ]] || die "bad group path"
}

# Syntax is not existence. A group path that parses but names nothing selects an
# empty payload, and `secret-run <scope> typo -- cmd` then hands the command an
# environment with none of the values it asked for and exits 0. The command
# fails somewhere further down, for a reason that looks nothing like the cause.
#
# This mirrors render()'s in_scope exactly, and has to: asking for `pg` selects
# `pg.prod` even when `pg` itself is never declared, so a stricter check here
# would reject paths the renderer is happy to serve. Ungrouped keys have no
# group path, so nothing but the whole scope reaches them and the empty path
# stays valid.
group_exists() {
    local meta="$1" want="$2"
    [[ -z "$want" ]] && return 0
    awk -F'\t' -v want="$want" '
        $1=="G" && ($2==want || index($2 ".", want ".")==1) { found=1; exit }
        END { exit(found ? 0 : 1) }' <<< "$meta"
}

require_group() {
    local meta="$1" scope="$2" want="$3"
    group_exists "$meta" "$want" && return 0
    die "no group '$want' in scope '$scope'. browse it with: secret-list $scope --tree"
}

# Groups carrying mode=ro that no sensitive mark covers. A read task wants one
# of these, and naming it costs nothing at the gate, which is exactly why a
# read task should never be reaching for the whole scope.
ro_groups() {
    awk -F'\t' '
        $1=="GA" && $3=="mode" && $4=="ro" { ro[$2]=1 }
        $1=="G"                            { desc[$2]=$6; sens[$2]=$4 }
        END {
            n=0
            for (p in ro) if (sens[p]=="0") list[n++]=p
            if (n==0) exit
            for (i=0;i<n;i++) for (j=i+1;j<n;j++)
                if (list[j]<list[i]) { t=list[i]; list[i]=list[j]; list[j]=t }
            shown = (n > 10 ? 10 : n)
            for (i=0;i<shown;i++) printf "    %-40s %s\n", list[i], desc[list[i]]
            if (n > shown) printf "    ... and %d more\n", n - shown
        }'
}

# A run that names no group receives every value in the scope, so the gate has
# to clear every sensitive group in it. That is almost never what the task
# needs, and until now it cost nothing to ask for: one missing argument away
# from the correct call, and the only symptom was a longer dialog. Four
# whole-scope runs against a 13-gate scope in one day, for a task whose
# credential was an ungated read-only role, is what this exists to stop.
#
# So the whole-scope form has to be named, and the refusal points at what the
# caller almost certainly wanted instead.
die_no_group() {
    local scope="$1" meta="$2" gated ro
    # Count what the dialog would actually list, not every group carrying an
    # effective mark. sensitive_roots suppresses a child whose parent is already
    # marked, because one prompt covers both, so counting the G records instead
    # promises more prompts than the gate would ever open.
    gated="$(sensitive_roots <<< "$meta" | wc -l | tr -d ' ')"
    ro="$(ro_groups <<< "$meta")"
    {
        printf 'agent-secrets-helper: run names no group.\n\n'
        printf '  without one the command receives every value in scope %s' "$scope"
        if [[ "$gated" -eq 1 ]]; then
            printf ', and the gate has to\n  clear its sensitive group to hand them over'
        elif [[ "$gated" -gt 1 ]]; then
            printf ', and the gate has to\n  clear all %s of its sensitive groups to hand them over' "$gated"
        fi
        printf '.\n\n  name the group the task needs, or several if it needs several:\n'
        printf '    secret-list %s --tree\n' "$scope"
        if [[ -n "$ro" ]]; then
            printf '\n  read-only roles in this scope, none of which need approval:\n%s\n' "$ro"
        fi
        printf '\n  if the task really does need the whole scope, say so:\n'
        printf '    secret-run %s --all-groups -- <command>\n' "$scope"
    } >&2
    exit 1
}

scope_file() {
    validate_scope "$1"
    printf '%s/%s.env.gpg' "$SCOPES_DIR" "$1"
}

# gpg argv is built entirely from constants plus a path this script derived
# itself. Nothing from the caller reaches it, which is what closes --output,
# --options, --homedir and --exec-path as injection points.
raw_decrypt() {
    local file="$1" out
    [[ -f "$file" ]] || die "no such scope"
    if out="$(decrypt_with "$KEY_FILE" "$file")"; then
        printf '%s\n' "$out"
        return 0
    fi
    # A rekey rewrites the key before it rewrites the scopes, and keeps the
    # previous key while it works. A scope that has not been re-encrypted yet
    # still opens through this fallback, which is what lets a rekey be killed
    # at any point without leaving half the store unreadable.
    if [[ -f "$KEY_FILE_OLD" ]] && out="$(decrypt_with "$KEY_FILE_OLD" "$file")"; then
        printf '%s\n' "$out"
        return 0
    fi
    return 1
}

decrypt_with() {
    "$GPG" --quiet --batch --pinentry-mode loopback \
           --passphrase-file "$1" --decrypt -- "$2" 2>/dev/null
}

raw_encrypt() { encrypt_with "$KEY_FILE"; }

encrypt_with() {
    "$GPG" --quiet --batch --yes --pinentry-mode loopback \
           --passphrase-file "$1" \
           --symmetric --cipher-algo AES256
}

# Same shape as secret-init writes: one line of base64, because gpg reads a
# passphrase file as text and stops at the first newline.
generate_key_material() {
    local out
    out="$("$GPG" --armor --gen-random 2 32)" || die "gpg could not generate a key"
    out="${out%%$'\n'*}"
    [[ ${#out} -ge 43 ]] || die "gpg produced a ${#out}-character key"
    [[ "$out" =~ ^[A-Za-z0-9+/=]+$ ]] || die "gpg produced a key outside the base64 alphabet"
    printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Parser
#
# Metadata rides in `#@` comment lines inside an otherwise ordinary .env
# payload, so an old secret-run, an old secret-edit, and a bare `gpg --decrypt`
# all still read the file correctly. That is what keeps a ciphertext backup plus the
# key in safekeeping sufficient to recover everything with no tooling at all.
#
#   #@g <dotted.path>[<tab or 2+ spaces><description>]   declare a group
#   #@d <text>                                          describe next declaration
#   #@a <name>=<value>                                   attribute of next declaration
#   #@sensitive [ttl=<seconds>]                          mark next declaration
#
# #@d, #@a and #@sensitive attach to the NEXT declaration, which is either a
# #@g line or a KEY= line. A blank line does not clear them, so a group's header
# block can be spaced out for readability. Only a declaration consumes them.
#
# A key belongs to the group whose derived prefix is the LONGEST match on its
# variable name: `#@g pg.aws.shared` derives PG_AWS_SHARED_ and claims
# PG_AWS_SHARED_ADMIN_RO_USER with leaf ADMIN_RO_USER, unless a longer declared
# group claims it first. Keys matching no group sit at the root.
#
# Emits tab-separated records on stdout. Never a value.
#   G <path> <sensitive> <ttl> <description>
#   GA <path> <name> <value>
#   K <var> <group> <leaf> <sensitive> <ttl> <description>
#   KA <var> <name> <value>
#   E <line-number> <message>
parse_meta() {
    awk '
    function reset_pending() { p_desc=""; p_sens=0; p_ttl=""; p_na=0 }

    function derive_prefix(path,   s) {
        s = toupper(path); gsub(/\./, "_", s); return s "_"
    }

    BEGIN { FS="\n"; reset_pending(); ng=0; nk=0; nga=0; nka=0 }

    { sub(/\r$/, ""); sub(/^\xef\xbb\xbf/, "") }

    /^[ \t]*#@/ {
        line = $0
        sub(/^[ \t]*#@/, "", line)

        if (line ~ /^g[ \t]/) {
            sub(/^g[ \t]+/, "", line)
            # Description is separated from the path by a tab or 2+ spaces.
            path = line; desc = ""
            if (match(line, /[ \t][ \t]+|\t/)) {
                path = substr(line, 1, RSTART-1)
                desc = substr(line, RSTART+RLENGTH)
            }
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", desc)
            if (path !~ /^[a-z0-9][a-z0-9_]*(\.[a-z0-9][a-z0-9_]*)*$/) {
                printf "E\t%d\tbad group path: %s\n", NR, path; reset_pending(); next
            }
            if (path in seen_g) { printf "E\t%d\tduplicate group: %s\n", NR, path }
            seen_g[path] = 1
            if (desc == "") desc = p_desc
            gpath[ng] = path; gdesc[ng] = desc; gsens[ng] = p_sens; gttl[ng] = p_ttl
            for (i = 0; i < p_na; i++) { ga_p[nga]=path; ga_n[nga]=p_an[i]; ga_v[nga]=p_av[i]; nga++ }
            ng++
            reset_pending(); next
        }
        if (line ~ /^d[ \t]/) {
            sub(/^d[ \t]+/, "", line)
            gsub(/[ \t]+$/, "", line)
            p_desc = (p_desc == "" ? line : p_desc " " line)
            next
        }
        if (line ~ /^a[ \t]/) {
            sub(/^a[ \t]+/, "", line)
            if (index(line, "=") == 0) { printf "E\t%d\tattribute needs name=value\n", NR; next }
            an = substr(line, 1, index(line, "=") - 1)
            av = substr(line, index(line, "=") + 1)
            gsub(/^[ \t]+|[ \t]+$/, "", an); gsub(/^[ \t]+|[ \t]+$/, "", av)
            if (an !~ /^[a-z][a-z0-9_]*$/) { printf "E\t%d\tbad attribute name: %s\n", NR, an; next }
            p_an[p_na] = an; p_av[p_na] = av; p_na++
            next
        }
        if (line ~ /^sensitive([ \t]|$)/) {
            p_sens = 1
            if (match(line, /ttl=[0-9]+/)) p_ttl = substr(line, RSTART+4, RLENGTH-4)
            next
        }
        printf "E\t%d\tunknown directive: %s\n", NR, line
        next
    }

    /^[ \t]*#/ { next }
    /^[ \t]*$/ { next }

    {
        eq = index($0, "=")
        if (eq == 0) { printf "E\t%d\tline is neither KEY=VALUE nor a comment\n", NR; next }
        var = substr($0, 1, eq-1)
        gsub(/^[ \t]+|[ \t]+$/, "", var)
        if (var !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { printf "E\t%d\tbad variable name\n", NR; next }
        if (var in seen_k) { printf "E\t%d\tduplicate key: %s\n", NR, var }
        seen_k[var] = 1
        kvar[nk] = var; kdesc[nk] = p_desc; ksens[nk] = p_sens; kttl[nk] = p_ttl
        for (i = 0; i < p_na; i++) { ka_k[nka]=var; ka_n[nka]=p_an[i]; ka_v[nka]=p_av[i]; nka++ }
        nk++
        reset_pending()
    }

    END {
        # Sensitivity inherits downward with no child opt-out, so a group is
        # effectively sensitive if it or any ancestor is marked.
        for (i = 0; i < ng; i++) {
            eff = gsens[i]; ttl = gttl[i]
            for (j = 0; j < ng; j++) {
                if (i == j) continue
                if (index(gpath[i] ".", gpath[j] ".") == 1 && gsens[j]) {
                    eff = 1
                    if (ttl == "") ttl = gttl[j]
                }
            }
            printf "G\t%s\t%d\t%d\t%s\t%s\n", gpath[i], gsens[i], eff, ttl, gdesc[i]
        }
        for (i = 0; i < nga; i++) printf "GA\t%s\t%s\t%s\n", ga_p[i], ga_n[i], ga_v[i]

        for (i = 0; i < nk; i++) {
            best = ""; bestlen = 0; bsens = 0; bttl = ""
            for (j = 0; j < ng; j++) {
                pfx = derive_prefix(gpath[j])
                if (index(kvar[i], pfx) == 1 && length(pfx) > bestlen) {
                    best = gpath[j]; bestlen = length(pfx)
                }
            }
            leaf = (best == "" ? kvar[i] : substr(kvar[i], bestlen + 1))
            # Inherit the winning group chain sensitivity.
            for (j = 0; j < ng; j++) {
                if (best != "" && index(best ".", gpath[j] ".") == 1 && gsens[j]) {
                    bsens = 1
                    if (bttl == "") bttl = gttl[j]
                }
            }
            eff = (ksens[i] || bsens) ? 1 : 0
            ttl = (kttl[i] != "" ? kttl[i] : bttl)
            printf "K\t%s\t%s\t%s\t%d\t%d\t%s\t%s\n", kvar[i], best, leaf, ksens[i], eff, ttl, kdesc[i]
        }
        for (i = 0; i < nka; i++) printf "KA\t%s\t%s\t%s\n", ka_k[i], ka_n[i], ka_v[i]
    }
    '
}

# ---------------------------------------------------------------------------
# Canonical renderer
#
# Takes the meta stream on fd 3 and the plaintext on stdin, and re-emits the
# payload in canonical order: groups sorted by path, each preceded by its
# attribute/description header block, keys sorted within their group, ungrouped
# keys last. Every save goes through this, so a hand-edited file comes back
# tidy and splicing is predictable.
#
# Group assignment is NOT recomputed here. It is read from the meta stream, so
# there is exactly one implementation of longest-prefix matching in this file.
# Two implementations that could drift is how a key silently ends up in the
# wrong place, or in no place at all.
#
# The first argument is a space-separated list of group paths, because a
# command can legitimately need two groups that are not one subtree: an api
# token from one group, and the access headers that front that api from
# another. With the list empty, emits the whole scope. A path selects its
# own subtree, and a group is emitted once however many of the listed paths
# select it. With KEEP_HEADER=0, omits the leading file comment.
render() {
    local group="${1:-}"
    # A single -v assignment, and group paths cannot contain whitespace, so the
    # list travels as one line. awk -v chokes on a newline inside an assignment
    # on macOS, which is why nothing here separates them with one.
    awk -F'\t' -v want="$group" '
    BEGIN { ng=0; nk=0; nwant = split(want, wants, " ") }
    function in_scope(p,   i) {
        if (nwant == 0) return 1
        for (i = 1; i <= nwant; i++)
            if (p == wants[i] || index(p ".", wants[i] ".") == 1) return 1
        return 0
    }
    # Values come from the payload, everything else from the meta stream.
    FNR==NR {
        if ($1 == "G")  { gp[ng]=$2; gown[ng]=$3; gt[ng]=$5; gd[ng]=$6; ng++ }
        if ($1 == "GA") { gan[$2] = gan[$2] SUBSEP $3 "=" $4 }
        if ($1 == "K")  { kv[nk]=$2; kg[nk]=$3; kown[nk]=$5; kt[nk]=$7; kd[nk]=$8; nk++ }
        if ($1 == "KA") { kan[$2] = kan[$2] SUBSEP $3 "=" $4 }
        next
    }
    {
        line = $0; sub(/\r$/, "", line); sub(/^\xef\xbb\xbf/, "", line)
        if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/) next
        eq = index(line, "=")
        if (eq == 0) next
        v = substr(line, 1, eq-1); gsub(/^[ \t]+|[ \t]+$/, "", v)
        val[v] = substr(line, eq+1)
        has[v] = 1
    }
    function emit_attrs(blob,   n, parts, i) {
        n = split(blob, parts, SUBSEP)
        for (i = 1; i <= n; i++) if (parts[i] != "") printf "#@a %s\n", parts[i]
    }
    function emit_key(i) {
        emit_attrs(kan[kv[i]])
        if (kown[i]) printf "#@sensitive%s\n", (kt[i] != "" ? " ttl=" kt[i] : "")
        if (kd[i] != "") printf "#@d %s\n", kd[i]
        printf "%s=%s\n", kv[i], val[kv[i]]
    }
    END {
        # Sort groups by path so the file reads as a tree.
        for (i = 0; i < ng; i++) order[i] = i
        for (i = 0; i < ng; i++) for (j = i+1; j < ng; j++)
            if (gp[order[j]] < gp[order[i]]) { t=order[i]; order[i]=order[j]; order[j]=t }

        for (oi = 0; oi < ng; oi++) {
            g = order[oi]
            if (!in_scope(gp[g])) continue
            printf "\n"
            emit_attrs(gan[gp[g]])
            # Only print a sensitivity mark the group declares itself. Printing
            # an inherited one would turn inheritance into a copy, and removing
            # the parent mark later would then silently leave the children marked.
            if (gown[g]) printf "#@sensitive%s\n", (gt[g] != "" ? " ttl=" gt[g] : "")
            printf "#@g %s\t%s\n", gp[g], gd[g]
            for (i = 0; i < nk; i++) if (kg[i] == gp[g] && has[kv[i]]) emit_key(i)
        }
        if (nwant == 0) {
            first = 1
            for (i = 0; i < nk; i++) if (kg[i] == "" && has[kv[i]]) {
                if (first) { printf "\n"; first = 0 }
                emit_key(i)
            }
        }
    }
    ' /dev/fd/3 -
}

# ---------------------------------------------------------------------------
# Approval gate
readonly APPROVE_TTL_DEFAULT=900   # 15 min
readonly DENY_TTL=30               # short, but long enough to break a retry loop
# However often an approval is used, it ends this long after the yes. Every use
# pushes its expiry out again, so without a ceiling a loop that touched a group
# every few minutes would keep it open for as long as the loop ran. Root owns
# this file, so nothing running as you can raise it.
readonly APPROVE_MAX_LIFETIME=43200   # 12 h
# The window a run or an approval asked for with --for, in seconds. Empty means
# each group's own #@sensitive ttl=, or the default. A global rather than one
# more argument threaded through every gate call, the same way ask_vars is.
gate_window=""
readonly DIALOG_TIMEOUT=60         # inside the agent harness's 120s Bash window

target_uid() { id -u "$target_user"; }

cache_dir() {
    local u; u="$(target_uid)"
    if [[ $EUID -eq 0 ]]; then
        if [[ "$OS" == Darwin ]]; then printf '/var/run/agent-secrets-gate/%s' "$u"
        else printf '/run/agent-secrets-gate/%s' "$u"; fi
    else
        printf '%s/agent-secrets-gate' "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
    fi
}

# A verdict cache somebody else can write is a verdict cache somebody else can
# forge. `mkdir -p` is happy to hand back a directory that already exists and
# belongs to another account, which is exactly what a pre-created
# /tmp/agent-secrets-gate would be on a machine with no XDG_RUNTIME_DIR.
ensure_private_dir() {
    local d="$1" owner mode
    mkdir -p "$d" 2>/dev/null || die "cannot create $d"
    chmod 700 "$d" 2>/dev/null || die "cannot restrict $d"
    owner="$(stat_owner_uid "$d" 2>/dev/null)" || die "cannot stat $d"
    mode="$(stat_mode "$d" 2>/dev/null)" || die "cannot stat $d"
    [[ "$owner" == "$EUID" ]] || die "$d belongs to uid $owner, not to this process"
    (( (8#$mode & 8#077) == 0 )) || die "$d is reachable by other accounts"
}

# flock is util-linux and does not exist on macOS. mkdir is atomic everywhere,
# which is all this needs: one dialog at a time per scope. A lock whose owner
# died is stolen after LOCK_STALE seconds, so a crashed request cannot wedge
# the gate until the next reboot.
readonly LOCK_STALE=180
gate_lock=""
acquire_lock() {
    local d="$1" waited=0 now mt
    while ! mkdir "$d" 2>/dev/null; do
        now=$(date +%s)
        mt="$(stat_mtime "$d" 2>/dev/null || echo "$now")"
        # steal a lock whose owner is gone, but never loop back without
        # sleeping: if the rmdir fails for any reason, `continue` here would
        # spin at full speed for as long as the lock exists.
        if (( now - mt > LOCK_STALE )); then rmdir "$d" 2>/dev/null || true; fi
        sleep 1
        waited=$((waited + 1))
        if (( waited > LOCK_STALE )); then die "timed out waiting for the approval lock on $d"; fi
    done
    gate_lock="$d"
    # gate_locked can die on a corrupt verdict cache. without this the lock
    # would then survive its owner and make every later request wait out the
    # staleness timeout. exec in cmd_run happens after the lock is released, so
    # this trap never has anything left to do by then.
    trap release_lock EXIT
}
release_lock() {
    [[ -n "$gate_lock" ]] && rmdir "$gate_lock" 2>/dev/null
    gate_lock=""
    return 0
}

# The desktop environment is read from the user manager, never from the caller.
# A caller-supplied WAYLAND_DISPLAY or DISPLAY is how QT_QPA_PLATFORM=offscreen,
# LD_PRELOAD and PATH shadowing all get their foothold.
user_env_var() {
    local u g; u="$(target_uid)"; g="$(id -g "$target_user")"
    [[ "$OS" == Linux ]] || return 0
    if [[ $EUID -eq 0 ]]; then
        setpriv --reuid="$u" --regid="$g" --clear-groups -- \
            env -i XDG_RUNTIME_DIR="/run/user/$u" /usr/bin/systemctl --user show-environment 2>/dev/null \
            | sed -n "s/^$1=//p" | head -1
    else
        /usr/bin/systemctl --user show-environment 2>/dev/null | sed -n "s/^$1=//p" | head -1
    fi
}

# Ask "is there a live desktop to draw on", not "who am I".
#
# Identity cannot answer this. An agent session's /proc/self/sessionid is the
# systemd user manager's session, the same one the bisync timer runs in, so no
# identity test separates them. And the display environment variables cannot
# answer it either: XWayland means clearing WAYLAND_DISPLAY still reaches the
# screen, and an SSH session that exports DISPLAY=:0 reaches a screen nobody is
# sitting at.
approval_channel_ok() {
    if [[ "$OS" == Darwin ]]; then macos_channel_ok; else linux_channel_ok; fi
}

# macOS has no loginctl, but the question is the same one. /dev/console belongs
# to whoever is logged in at the physical display, which an ssh session never
# is, and ioreg is the only public place the lock state is published.
macos_channel_ok() {
    local console
    [[ -x /usr/sbin/ioreg ]] || return 1
    console="$(stat -f '%Su' /dev/console 2>/dev/null)" || return 1
    [[ "$console" == "$target_user" ]] || return 1
    ! /usr/sbin/ioreg -n Root -d1 2>/dev/null | grep -q 'CGSSessionScreenIsLocked.*Yes'
}

linux_channel_ok() {
    local d act rem seat locked
    command -v loginctl >/dev/null 2>&1 || return 1
    d=$(loginctl show-user "$(target_uid)" --value -p Display 2>/dev/null) || return 1
    [[ -n "$d" ]] || return 1
    act=$(loginctl show-session "$d" --value -p Active 2>/dev/null)
    rem=$(loginctl show-session "$d" --value -p Remote 2>/dev/null)
    seat=$(loginctl show-session "$d" --value -p Seat 2>/dev/null)
    locked=$(loginctl show-session "$d" --value -p LockedHint 2>/dev/null)
    # A locked screen matters on its own: the dialog would render behind the
    # lock and be answered by whoever unlocks the machine, not necessarily its owner.
    [[ "$act" == "yes" && "$rem" == "no" && -n "$seat" && "$locked" != "yes" ]]
}

# 0 = allow, 1 = deny, 2 = timed out, 3 = no dialog, crashed, or killed, and
# 4 = the second allow button, when one was asked for.
#
# Arguments: title, body, then optionally the label of the allow button and of
# a second, shorter allow. A run that asks for longer than a group usually
# gets offers both, so the answer to "two hours?" does not have to be no.
#
# Anything that is not a plain 0 or 4 is treated as absence of consent, never as
# consent: `env -i kdialog` aborts with 134 and no stderr when Qt cannot find a
# platform plugin, which is why this never infers availability from an exit
# status it did not expect.
ask_dialog() {
    if [[ "$OS" == Darwin ]]; then ask_dialog_macos "$@"; else ask_dialog_linux "$@"; fi
}

# One toolkit draws every dialog this tool shows: the approval gate, the single
# value prompt and the multi-field form. Mixing them means an approval in one
# widget set followed by a value prompt in another, for one operation, and the
# dialog that matters most is the one you want looking familiar.
#
# zenity comes first because it can draw all three. kdialog has no multi-field
# form, so where it is the only one installed `secret-ask` asks for a set one
# credential at a time rather than reaching for a second toolkit.
linux_dialog_tool() {
    local t
    for t in /usr/bin/zenity /usr/bin/kdialog /usr/local/bin/zenity /usr/local/bin/kdialog; do
        [[ -x "$t" ]] && { printf '%s\n' "$t"; return 0; }
    done
    return 1
}

ask_dialog_linux() {
    local title="$1" body="$2" allow_label="${3:-allow}" alt_label="${4:-}" u g rc=0 tool out
    tool="$(linux_dialog_tool)" || return 3
    u="$(target_uid)"; g="$(id -g "$target_user")"
    local wd dp xa db
    wd=$(user_env_var WAYLAND_DISPLAY); dp=$(user_env_var DISPLAY)
    xa=$(user_env_var XAUTHORITY);      db=$(user_env_var DBUS_SESSION_BUS_ADDRESS)
    # Catch a stale post-relogin snapshot: the user manager keeps the values it
    # was given at session start, so after a logout WAYLAND_DISPLAY can name a
    # compositor socket that no longer exists.
    [[ -n "$wd" && ! -S "/run/user/$u/$wd" ]] && return 3

    local pre=() args=()
    [[ $EUID -eq 0 ]] && pre=(setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --)
    # kdialog answers yes/no/cancel with 0/1/2, so with a second allow the
    # cancel button is the deny. zenity exits 1 for both its cancel button and
    # an extra one, and tells them apart by printing the extra button's label.
    case "$tool" in
        */kdialog)
            if [[ -n "$alt_label" ]]; then
                args=(--title "$title" --yes-label "$allow_label" --no-label "$alt_label"
                      --cancel-label deny --warningyesnocancel "$body")
            else
                args=(--title "$title" --warningyesno "$body")
            fi ;;
        */zenity)
            args=(--question --title="$title" --text="$body"
                  --ok-label="$allow_label" --cancel-label=deny)
            [[ -n "$alt_label" ]] && args+=(--extra-button="$alt_label") ;;
    esac
    out="$(timeout -s TERM "$DIALOG_TIMEOUT" \
        ${pre[@]+"${pre[@]}"} env -i \
            HOME="$target_home" PATH=/usr/bin:/bin \
            XDG_RUNTIME_DIR="/run/user/$u" \
            ${wd:+WAYLAND_DISPLAY="$wd"} ${dp:+DISPLAY="$dp"} \
            ${xa:+XAUTHORITY="$xa"} ${db:+DBUS_SESSION_BUS_ADDRESS="$db"} \
            "$tool" ${args[@]+"${args[@]}"} 2>/dev/null)" || rc=$?
    if [[ -n "$alt_label" ]]; then
        case "$tool" in
            */kdialog) case $rc in 0) return 0;; 1) return 4;; 2) return 1;; 124) return 2;; *) return 3;; esac ;;
            */zenity)  [[ $rc -eq 1 && "${out%$'\n'}" == "$alt_label" ]] && return 4 ;;
        esac
    fi
    case $rc in 0) return 0;; 1) return 1;; 124) return 2;; *) return 3;; esac
}

# The title and body are passed as osascript argv rather than spliced into the
# script text, so a description containing a quote cannot rewrite the dialog.
# `launchctl asuser` is how root reaches the GUI session on macOS; without it
# osascript has no window server to draw on.
ask_dialog_macos() {
    local title="$1" body="$2" allow_label="${3:-allow}" alt_label="${4:-}" u out rc=0 pre=()
    u="$(target_uid)"
    [[ -x /usr/bin/osascript ]] || return 3
    if [[ $EUID -eq 0 ]]; then
        [[ -x /bin/launchctl && -x /usr/bin/sudo ]] || return 3
        pre=(/bin/launchctl asuser "$u" /usr/bin/sudo -n -u "#$u" --)
    fi
    out="$(${pre[@]+"${pre[@]}"} /usr/bin/osascript - "$title" "$body" "$DIALOG_TIMEOUT" \
        "$allow_label" "$alt_label" 2>/dev/null <<'APPLESCRIPT'
on run argv
    set dialogTitle to item 1 of argv
    set dialogBody to item 2 of argv
    set limit to (item 3 of argv) as integer
    set allowLabel to item 4 of argv
    set altLabel to item 5 of argv
    if altLabel is "" then
        set choices to {"deny", allowLabel}
    else
        set choices to {"deny", altLabel, allowLabel}
    end if
    set answer to display dialog dialogBody with title dialogTitle ¬
        buttons choices default button "deny" ¬
        with icon caution giving up after limit
    if gave up of answer then
        return "timeout"
    else if button returned of answer is allowLabel then
        return "allow"
    else if altLabel is not "" and button returned of answer is altLabel then
        return "alt"
    else
        return "deny"
    end if
end run
APPLESCRIPT
    )" || rc=$?
    (( rc != 0 )) && return 3
    case "$out" in
        allow)   return 0 ;;
        alt)     return 4 ;;
        deny)    return 1 ;;
        timeout) return 2 ;;
        *)       return 3 ;;
    esac
}

# Verdicts are cached by (scope, identity), not by caller. Every agent Bash call
# is fresh, so a pid-based cache would prompt every time. A single lock for a
# scope lets one request batch every uncached item and prevents parallel callers
# from stacking overlapping dialogs.
#
# The file name has to be injective. It used to be ${scope}__${id//./_}, which
# folded pg.prod and pg_prod onto one file, so approving one unlocked the other.
# On a case-insensitive filesystem, the default on macOS, it also folded the key
# PG_PROD onto the group pg_prod. So the type is spelled out, a group path keeps
# its dots, and a key name is hex-encoded: keys are the one identity whose case
# carries meaning, and hex has no case to lose.
#
# The kind is part of the name because a read and a change are different
# answers. Saying yes to storing a value in pg.prod is not saying yes to some
# process reading pg.prod for the next fifteen minutes, and the reverse.
verdict_file() {
    local dir="$1" scope="$2" type="$3" id="$4" kind="$5" name
    case "$type" in
        g) name="$id" ;;
        k) name="$(printf '%s' "$id" | od -An -tx1 | tr -d ' \n')" ;;
        *) die "bad verdict identity type" ;;
    esac
    case "$kind" in
        read|change) ;;
        *) die "bad verdict kind" ;;
    esac
    printf '%s/%s~%s~%s~%s' "$dir" "$scope" "$type" "$name" "$kind"
}

# Exactly the identity asked about, never a parent. Walking up used to let an
# approval of pg answer for pg.prod. Every marked descendant is already listed
# in the dialog that approves its parent, so the walk only ever mattered for a
# group marked after that approval was given, and that is the one case where an
# answer you gave about something else should not count.
#
# An allow line is `allow <expires> <hard-expiry> <window>`: it is good until
# <expires>, every use moves <expires> to now + <window>, and nothing moves it
# past <hard-expiry>. A deny line is `deny <expires>` and never moves. Prints
# `allow <window>`, `deny`, or nothing. A two-field allow from before windows
# existed prints an empty window and is honoured, unrefreshed, until it runs out.
cached_verdict() {
    local f; f="$(verdict_file "$4" "$1" "$2" "$3" "$5")"
    local now verdict exp hard window
    [[ -f "$f" ]] || return 0
    now=$(date +%s)
    IFS=' ' read -r verdict exp hard window < "$f" || true
    [[ "$exp" =~ ^[0-9]+$ && $now -lt $exp ]] || return 0
    if [[ "$verdict" == allow ]]; then
        [[ -z "$hard" || ( "$hard" =~ ^[0-9]+$ && $now -lt $hard ) ]] || return 0
        printf 'allow %s\n' "$window"
    else
        printf '%s\n' "$verdict"
    fi
    return 0
}

write_allow() {
    local f="$1" now="$2" window="$3" hard exp
    hard=$((now + APPROVE_MAX_LIFETIME))
    exp=$((now + window))
    (( exp > hard )) && exp="$hard"
    printf 'allow %s %s %s\n' "$exp" "$hard" "$window" > "$f"
}

# Using an approval keeps it open: the expiry moves to now + its window, never
# past the hard expiry set when it was granted, and never backwards.
refresh_verdict() {
    local f="$1" now="$2" verdict exp hard window next
    [[ -f "$f" ]] || return 0
    IFS=' ' read -r verdict exp hard window < "$f" || return 0
    [[ "$verdict" == allow && "$exp" =~ ^[0-9]+$ && "$hard" =~ ^[0-9]+$ && "$window" =~ ^[0-9]+$ ]] || return 0
    next=$((now + window))
    (( next > hard )) && next="$hard"
    (( next > exp )) || return 0
    printf 'allow %s %s %s\n' "$next" "$hard" "$window" > "$f"
}

validate_motive() {
    local motive="$1"
    [[ -n "$motive" ]] || die "motive must not be empty"
    [[ ${#motive} -le 160 ]] || die "motive must be 160 characters or fewer"
    [[ "$motive" != *$'\n'* && "$motive" != *$'\r'* && "$motive" != *$'\t'* ]] || \
        die "motive must be one line"
    [[ "$motive" =~ ^[[:print:]]+$ ]] || die "motive must use printable characters"
}

# 7200 -> "2 hours". What the dialog says has to be what was asked for, so
# anything that is not a whole number of hours or minutes is said in seconds.
human_duration() {
    local s="$1" n unit
    if (( s % 3600 == 0 )); then n=$((s / 3600)); unit=hour
    elif (( s % 60 == 0 )); then n=$((s / 60)); unit=minute
    else n="$s"; unit=second
    fi
    if (( n == 1 )); then printf '1 %s' "$unit"; else printf '%d %ss' "$n" "$unit"; fi
}

validate_window() {
    [[ "$1" =~ ^[0-9]{1,6}$ ]] || die "--for takes a number of seconds"
    (( $1 >= 60 )) || die "--for asks for $(human_duration "$1"); the shortest approval is 1 minute"
    (( $1 <= APPROVE_MAX_LIFETIME )) || \
        die "--for asks for $(human_duration "$1"); the most an approval can last is $(human_duration "$APPROVE_MAX_LIFETIME")"
}

effective_ttl() {
    local ttl="$1"
    [[ "$ttl" =~ ^[0-9]+$ ]] || ttl="$APPROVE_TTL_DEFAULT"
    printf '%s\n' "$ttl"
}

batch_dialog_body() {
    local scope="$1" motive="$2" entries="$3" window="$4" kinds="$5" loose="${6:-}" alt="${7:-}"
    local lasts cap
    lasts="$(human_duration "$window") after their last use"
    cap="$(human_duration "$APPROVE_MAX_LIFETIME")"
    if [[ -n "$loose" ]]; then
        printf 'a process wants to change sensitive secrets in scope %s, and the change takes protection away.\n\nmotive: %s\n\n' \
            "$scope" "${motive:-no motive supplied.}"
        [[ -n "$entries" ]] && printf 'it would change:\n%s\n' "$entries"
        printf 'afterwards these would need less approval to read:\n%s\nallow it? this is asked every time and never remembered.' "$loose"
        [[ -n "$entries" ]] && printf ' other changes to the groups above stay allowed for %s.' "$lasts"
        return 0
    fi
    case "$kinds" in
        read)
            printf 'a process requests sensitive secrets in scope %s.\n\nmotive: %s\n\nrequested items:\n%s\nallow these items for %s, and at most %s in all?' \
                "$scope" "${motive:-no motive supplied.}" "$entries" "$lasts" "$cap" ;;
        change)
            printf 'a process wants to change sensitive secrets in scope %s.\n\nmotive: %s\n\nit would change:\n%s\nallow changes to these for %s, and at most %s in all? this does not let anything read them.' \
                "$scope" "${motive:-no motive supplied.}" "$entries" "$lasts" "$cap" ;;
        *)
            printf 'a process wants to open sensitive secrets in scope %s to edit them.\n\nmotive: %s\n\nrequested items:\n%s\nallow reading and changing these for %s, and at most %s in all?' \
                "$scope" "${motive:-no motive supplied.}" "$entries" "$lasts" "$cap" ;;
    esac
    [[ -n "$alt" ]] && printf '\n\nor allow them for their usual %s instead.' "$(human_duration "$alt")"
    return 0
}

# One word for the journal and the dialog title, whichever kinds were asked.
kinds_label() {
    case "$1" in
        read) printf 'access' ;;
        change) printf 'change' ;;
        *) printf 'edit' ;;
    esac
}

# Masked input, asked of the person at the screen and answered straight into
# this process.
#
# The point of the whole verb is that the value never exists anywhere the
# caller can reach: not in argv, where `ps` would have it, not in the shell
# history, and not in the transcript of whatever agent asked for it. So the
# dialog prints to a pipe this function owns, and the only thing that leaves
# here is the ciphertext.
#
# Exit codes match ask_dialog: 0 answered, 1 cancelled, 2 timed out, 3 no way
# to ask.
ask_secret() {
    if [[ "$OS" == Darwin ]]; then ask_secret_macos "$@"; else ask_secret_linux "$@"; fi
}

ask_secret_linux() {
    local title="$1" body="$2" u g rc=0 tool out
    tool="$(linux_dialog_tool)" || return 3
    u="$(target_uid)"; g="$(id -g "$target_user")"
    local wd dp xa db
    wd=$(user_env_var WAYLAND_DISPLAY); dp=$(user_env_var DISPLAY)
    xa=$(user_env_var XAUTHORITY);      db=$(user_env_var DBUS_SESSION_BUS_ADDRESS)
    [[ -n "$wd" && ! -S "/run/user/$u/$wd" ]] && return 3

    local pre=() args=()
    [[ $EUID -eq 0 ]] && pre=(setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --)
    case "$tool" in
        */kdialog) args=(--title "$title" --password "$body") ;;
        */zenity)  args=(--entry --hide-text --title="$title" --text="$body") ;;
    esac
    out="$(timeout -s TERM "$DIALOG_TIMEOUT" \
        ${pre[@]+"${pre[@]}"} env -i \
            HOME="$target_home" PATH=/usr/bin:/bin \
            XDG_RUNTIME_DIR="/run/user/$u" \
            ${wd:+WAYLAND_DISPLAY="$wd"} ${dp:+DISPLAY="$dp"} \
            ${xa:+XAUTHORITY="$xa"} ${db:+DBUS_SESSION_BUS_ADDRESS="$db"} \
            "$tool" ${args[@]+"${args[@]}"} 2>/dev/null)" || rc=$?
    case $rc in
        0) printf '%s' "${out%$'\n'}"; return 0 ;;
        1) return 1 ;;
        124) return 2 ;;
        *) return 3 ;;
    esac
}

# Several masked fields in one dialog.
#
# Only some dialog tools can do this. zenity has --forms with a password field
# per value; kdialog has no multi-field form at all, so there the caller falls
# back to asking one at a time. Both are correct, one is nicer, and which you
# get depends on what is installed rather than on anything the caller said.
#
# Values come back joined. The separator is US (0x1f) rather than zenity's
# default pipe, because a pipe in a password is ordinary and a unit separator
# is not. A value containing it would produce the wrong field count, which is
# checked, so the failure is loud rather than silent.
ask_secret_form() {
    local title="$1" body="$2"; shift 2
    local u g rc=0 tool out sep=$'\x1f'
    # Whatever draws every other dialog draws this one, or there is no form and
    # the caller asks one at a time. 4 says exactly that.
    tool="$(linux_dialog_tool)" || return 3
    case "$tool" in */zenity) ;; *) return 4 ;; esac
    u="$(target_uid)"; g="$(id -g "$target_user")"
    local wd dp xa db
    wd=$(user_env_var WAYLAND_DISPLAY); dp=$(user_env_var DISPLAY)
    xa=$(user_env_var XAUTHORITY);      db=$(user_env_var DBUS_SESSION_BUS_ADDRESS)
    [[ -n "$wd" && ! -S "/run/user/$u/$wd" ]] && return 3

    local pre=() args=(--forms --title="$title" --text="$body" --separator="$sep")
    local label
    for label in "$@"; do args+=(--add-password="$label"); done
    [[ $EUID -eq 0 ]] && pre=(setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --)

    out="$(timeout -s TERM "$DIALOG_TIMEOUT" \
        ${pre[@]+"${pre[@]}"} env -i \
            HOME="$target_home" PATH=/usr/bin:/bin \
            XDG_RUNTIME_DIR="/run/user/$u" \
            ${wd:+WAYLAND_DISPLAY="$wd"} ${dp:+DISPLAY="$dp"} \
            ${xa:+XAUTHORITY="$xa"} ${db:+DBUS_SESSION_BUS_ADDRESS="$db"} \
            "$tool" ${args[@]+"${args[@]}"} 2>/dev/null)" || rc=$?
    case $rc in
        0) printf '%s' "${out%$'\n'}"; return 0 ;;
        1) return 1 ;;
        124) return 2 ;;
        *) return 3 ;;
    esac
}

ask_secret_macos() {
    local title="$1" body="$2" u out rc=0 pre=()
    u="$(target_uid)"
    [[ -x /usr/bin/osascript ]] || return 3
    if [[ $EUID -eq 0 ]]; then
        [[ -x /bin/launchctl && -x /usr/bin/sudo ]] || return 3
        pre=(/bin/launchctl asuser "$u" /usr/bin/sudo -n -u "#$u" --)
    fi
    out="$(${pre[@]+"${pre[@]}"} /usr/bin/osascript - "$title" "$body" "$DIALOG_TIMEOUT" 2>/dev/null <<'APPLESCRIPT'
on run argv
    set dialogTitle to item 1 of argv
    set dialogBody to item 2 of argv
    set limit to (item 3 of argv) as integer
    set answer to display dialog dialogBody with title dialogTitle ¬
        default answer "" with hidden answer ¬
        buttons {"cancel", "store"} default button "store" ¬
        with icon note giving up after limit
    if gave up of answer then
        return "T:"
    else if button returned of answer is "store" then
        return "V:" & text returned of answer
    else
        return "C:"
    end if
end run
APPLESCRIPT
    )" || rc=$?
    (( rc != 0 )) && return 3
    case "$out" in
        "V:"*) printf '%s' "${out#V:}"; return 0 ;;
        "C:")  return 1 ;;
        "T:")  return 2 ;;
        *)     return 3 ;;
    esac
}

# The journal is the one record the calling process cannot rewrite.
log_verdict() { logger -p authpriv.notice -t agent-secrets-helper "scope=$1 group=$2 kind=$3 verdict=$4" 2>/dev/null || true; }

# ---------------------------------------------------------------------------
# Verbs. Every one writes to stdout and never to a file.
#
# This is deliberate. If the helper wrote scopes/<scope>.env.gpg the file would
# land root:root, and `rclone bisync` running as the user could no longer
# replace it. The sync would stop, silently, on the one directory whose whole
# job is being your backup. So the unprivileged wrapper keeps doing its own
# mktemp/$EDITOR/mv dance and the helper stays a pure filter.

plaintext_of() { raw_decrypt "$(scope_file "$1")" | tr -d '\r'; }

# What has to be approved, and under what name.
#
# Two sources, and missing either one is a hole. A group carrying its own
# #@sensitive mark covers everything beneath it, so gating the declared roots is
# enough. But a key can also be marked on its own, with no sensitive group
# anywhere above it, and reading only the G records lets that key straight out.
#
# A key-level mark is suppressed when an ancestor group is already marked,
# because the group prompt already covers it and two dialogs for one read is
# how prompt fatigue starts.
#
# Each line says whether it is a group (g) or a key (k). That used to be
# guessed from the first letter, but the format accepts lowercase key names, so
# a key marked on its own could be mistaken for a group with the same spelling.
sensitive_roots() {
    awk -F'\t' '
      $1=="G" && $3=="1" { own[$2]=1; printf "g\t%s\t%s\t%s\n", $2, $6, $5 }
      $1=="K" && $5=="1" {
          covered=0; g=$3
          while (g != "") {
              if (g in own) { covered=1; break }
              if (index(g,".")==0) break
              sub(/\.[^.]*$/, "", g)
          }
          if (!covered) printf "k\t%s\t%s\t%s\n", $2, $8, $7
      }'
}

# True when the gate identity (a dotted group path, or a bare VARIABLE_NAME for
# a key marked on its own) falls inside the subtree being asked for.
in_request() {
    local id="$1" group="$2" keygroup="$3"
    [[ -z "$group" ]] && return 0
    [[ "$id" == "$group" || "$id" == "$group".* || "$group" == "$id".* ]] && return 0
    [[ -n "$keygroup" && ( "$keygroup" == "$group" || "$keygroup" == "$group".* || "$group" == "$keygroup".* ) ]] && return 0
    return 1
}

# Gate every sensitive root selected by one or more group paths. The request is
# approved or denied as one set, so a task that needs several known groups gets
# one readable dialog rather than a click-through stream.
#
# The first argument is what is being approved: read, change, or "read change"
# for opening a group in an editor, which is both and asks once for both.
#
# Candidates travel as tab-separated lines rather than in an associative array.
# This file has to run under the bash 3.2 that macOS ships at the only bash
# path root actually owns, and bash 3.2 has no `declare -A` and no `mapfile`.
gate_for() {
    local kinds="$1" scope="$2" meta="$3" motive="$4"
    shift 4
    [[ $# -eq 0 ]] && set -- ""
    local roots; roots=$(sensitive_roots <<< "$meta")
    [[ -z "$roots" ]] && return 0

    local candidates="" seen="" type id desc ttl kg group matches
    while IFS=$'\t' read -r type id desc ttl; do
        [[ -z "$id" ]] && continue
        case "$seen" in *"|$type:$id|"*) continue ;; esac
        kg=""
        [[ "$type" == k ]] && kg=$(awk -F'\t' -v v="$id" '$1=="K" && $2==v { print $3 }' <<< "$meta")
        matches=false
        for group in "$@"; do
            if in_request "$id" "$group" "$kg"; then matches=true; break; fi
        done
        $matches || continue
        seen="$seen|$type:$id|"
        candidates="$candidates$type"$'\t'"$id"$'\t'"$desc"$'\t'"$(effective_ttl "$ttl")"$'\n'
    done <<< "$roots"
    [[ -n "$candidates" ]] || return 0

    # Sorting makes the dialog and the audit log deterministic.
    candidates="$(printf '%s' "$candidates" | sort)"

    local dir; dir="$(cache_dir)"
    ensure_private_dir "$dir"
    acquire_lock "$dir/.lock.$scope"
    local rc=0
    gate_locked "$kinds" "$scope" "$motive" "$dir" "$candidates" || rc=$?
    release_lock
    return $rc
}

# Runs with the per-scope lock held, so one request can batch every uncached
# item and parallel callers cannot stack overlapping dialogs.
#
# An item is settled from the cache only when every kind asked for is cached as
# allowed. One cached deny of any kind refuses it, and a yes in the dialog is
# written for every kind it was asked under.
#
# The optional sixth argument lists keys a change would leave less protected,
# one "KEY<tab>reason" per line. Those always open the dialog, whatever is
# cached, and the yes is never cached for them: an approval of some earlier
# change to pg is not an answer to taking a key out from under pg.
gate_locked() {
    local kinds="$1" scope="$2" motive="$3" dir="$4" candidates="$5" loosen="${6:-}"
    local pending="" cached="" type id desc ttl verdict cw kind now entries="" entry count=0 max_ttl=0 rc=0
    local loose_entries="" key reason
    local label; label="$(kinds_label "$kinds")"
    local requested="$gate_window" all_allowed

    now=$(date +%s)
    while IFS=$'\t' read -r type id desc ttl; do
        [[ -z "$id" ]] && continue
        all_allowed=true
        for kind in $kinds; do
            verdict="$(cached_verdict "$scope" "$type" "$id" "$dir" "$kind")"
            case "$verdict" in
                allow*)
                    # Asking for longer than what was approved asks again,
                    # rather than quietly getting the shorter window.
                    cw="${verdict#allow}"; cw="${cw# }"
                    if [[ -n "$requested" ]] && { [[ ! "$cw" =~ ^[0-9]+$ ]] || (( cw < requested )); }; then
                        all_allowed=false
                    fi ;;
                deny)  log_verdict "$scope" "$id" "$kind" cached-deny
                       echo "agent-secrets-gate: denied $kind scope=$scope group=$id" >&2
                       return $EX_NOPERM ;;
                '')    all_allowed=false ;;
                *)     die "bad cached approval verdict" ;;
            esac
        done
        if $all_allowed; then
            cached="$cached$type"$'\t'"$id"$'\n'
        else
            pending="$pending$type"$'\t'"$id"$'\t'"$desc"$'\t'"$ttl"$'\n'
        fi
    done <<< "$candidates"
    if [[ -z "$pending" && -z "$loosen" ]]; then
        refresh_cached "$scope" "$dir" "$kinds" "$label" "$cached" "$now"
        return 0
    fi

    if ! approval_channel_ok; then
        while IFS=$'\t' read -r type id desc ttl; do
            [[ -n "$id" ]] && log_verdict "$scope" "$id" "$label" no-channel
        done <<< "$pending"
        while IFS=$'\t' read -r key reason; do
            [[ -n "$key" ]] && log_verdict "$scope" "$key" loosen no-channel
        done <<< "$loosen"
        echo "agent-secrets-gate: unavailable scope=$scope (no active local session to ask)" >&2
        return $EX_UNAVAILABLE
    fi

    while IFS=$'\t' read -r type id desc ttl; do
        [[ -z "$id" ]] && continue
        printf -v entry ' - %s: %s\n' "$id" "${desc:-no description recorded.}"
        entries="$entries$entry"
        count=$((count + 1))
        (( ttl > max_ttl )) && max_ttl="$ttl"
    done <<< "$pending"
    while IFS=$'\t' read -r key reason; do
        [[ -z "$key" ]] && continue
        printf -v entry ' - %s: %s\n' "$key" "$reason"
        loose_entries="$loose_entries$entry"
    done <<< "$loosen"

    # A request for longer than these groups usually get offers their usual
    # window as well, so the choice is not between two hours and nothing.
    local shown="$max_ttl" allow_label="allow" alt_label="" alt=""
    if [[ -n "$requested" ]]; then
        shown="$requested"
        if (( requested > max_ttl )); then
            allow_label="allow $(human_duration "$requested")"
            alt_label="allow $(human_duration "$max_ttl")"
            alt="$max_ttl"
        fi
    fi
    (( shown > 0 )) || shown="$APPROVE_TTL_DEFAULT"

    local title="secret $label: $count item(s)"
    [[ -n "$loose_entries" ]] && title="secret $label: removes protection"
    ask_dialog "$title" \
        "$(batch_dialog_body "$scope" "$motive" "$entries" "$shown" "$kinds" "$loose_entries" "$alt")" \
        "$allow_label" "$alt_label" || rc=$?
    now=$(date +%s)
    # A no to a loosening is cached against everything it touched, cached
    # allows included, so a retry meets the deny rather than a new dialog.
    local denied="$pending"
    [[ -n "$loose_entries" ]] && denied="$candidates"
    local window
    case $rc in
        0|4) while IFS=$'\t' read -r type id desc ttl; do
                 [[ -z "$id" ]] && continue
                 window="$ttl"
                 [[ $rc -eq 0 && -n "$requested" ]] && window="$requested"
                 for kind in $kinds; do
                     write_allow "$(verdict_file "$dir" "$scope" "$type" "$id" "$kind")" "$now" "$window"
                 done
                 log_verdict "$scope" "$id" "$label" "allow-batch window=$window"
             done <<< "$pending"
             while IFS=$'\t' read -r key reason; do
                 [[ -n "$key" ]] && log_verdict "$scope" "$key" loosen allow
             done <<< "$loosen"
             refresh_cached "$scope" "$dir" "$kinds" "$label" "$cached" "$now"
             return 0 ;;
        1) while IFS=$'\t' read -r type id desc ttl; do
               [[ -z "$id" ]] && continue
               for kind in $kinds; do
                   printf 'deny %s\n' "$((now + DENY_TTL))" > "$(verdict_file "$dir" "$scope" "$type" "$id" "$kind")"
               done
               log_verdict "$scope" "$id" "$label" deny-batch
           done <<< "$denied"
           while IFS=$'\t' read -r key reason; do
               [[ -n "$key" ]] && log_verdict "$scope" "$key" loosen deny
           done <<< "$loosen"
           echo "agent-secrets-gate: denied $label scope=$scope requested-items=$count" >&2
           return $EX_NOPERM ;;
        2) while IFS=$'\t' read -r type id desc ttl; do
               [[ -n "$id" ]] && log_verdict "$scope" "$id" "$label" timeout
           done <<< "$pending"
           echo "agent-secrets-gate: timeout scope=$scope (nothing cached, re-run to ask again)" >&2
           return $EX_TEMPFAIL ;;
        *) while IFS=$'\t' read -r type id desc ttl; do
               [[ -n "$id" ]] && log_verdict "$scope" "$id" "$label" dialog-failed
           done <<< "$pending"
           echo "agent-secrets-gate: dialog failed scope=$scope" >&2
           return $EX_TEMPFAIL ;;
    esac
}

# Items that were already allowed, used by a request that has now gone through.
# Refreshing them only here, rather than as they were found, means a request
# refused on its second item does not keep its first one open.
refresh_cached() {
    local scope="$1" dir="$2" kinds="$3" label="$4" cached="$5" now="$6" type id kind
    while IFS=$'\t' read -r type id; do
        [[ -z "$id" ]] && continue
        for kind in $kinds; do
            refresh_verdict "$(verdict_file "$dir" "$scope" "$type" "$id" "$kind")" "$now"
        done
        log_verdict "$scope" "$id" "$label" cached-allow
    done <<< "$cached"
}

# ---------------------------------------------------------------------------
# Change policy
#
# Every write that changes a scope goes through commit_policy, which compares
# the scope before and after and decides what has to be asked. Each verb used
# to decide that for itself, from the arguments it was given, and the editor
# path decided it from the group named on the command line. That is how editing
# service.api could add `#@g pg_prod` and move PG_PROD_PASS out of the marked
# pg with nothing asked: the save was gated on service.api, which was not where
# anything changed.
#
# Comparing the two versions makes the answer independent of how the change
# was made. Four questions, all decided here:
#
#   integrity  every key that was there is still there with the same value,
#              unless the caller named it as written (W) or deleted (D).
#   change     what was touched, and which marked identities guard it. Those
#              are gated as a change. Adding a mark or shortening a TTL only
#              tightens, so it touches nothing.
#   loosen     which keys would be guarded by less afterwards. A key's gate
#              set is the marked groups above it, or the key itself when it
#              carries the only mark. Losing any of them, or one of them
#              lasting longer once approved, loosens the key. That is asked
#              every time, whatever is cached.
#   fresh      identities that exist afterwards and did not before. Their
#              cached verdicts are purged, because the cache is keyed by name
#              and an approval given to something else by that name is not an
#              approval of this.
#
# Inputs: fd3 before meta, fd4 after meta, fd5 mapping, fd6 before plaintext,
# fd7 after plaintext. Output records: T type id desc ttl, L key reason,
# N type id, X message, and OK last, so a policy that died part way cannot be
# mistaken for one that found nothing to ask.
change_policy() {
    awk -F'\t' -v dttl="$APPROVE_TTL_DEFAULT" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function ttlof(t) { return (t ~ /^[0-9]+$/) ? t + 0 : dttl + 0 }

    # The marked groups among p and its ancestors, as "|g:a|g:a.b|". With
    # strict set, p itself is left out.
    function marked_chain(p, own, decl, strict,   s, g) {
        s = "|"; g = p
        if (strict) {
            if (index(g, ".") == 0) return s
            sub(/\.[^.]*$/, "", g)
        }
        while (g != "") {
            if ((g in decl) && own[g] == "1") s = s "g:" g "|"
            if (index(g, ".") == 0) break
            sub(/\.[^.]*$/, "", g)
        }
        return s
    }
    function key_gate(k, kg, kown, gown, gdecl,   s) {
        s = marked_chain(kg[k], gown, gdecl, 0)
        if (s == "|" && kown[k] == "1") s = "|k:" k "|"
        return s
    }
    function ttl_before(id,   n) {
        n = substr(id, 3)
        return (substr(id, 1, 1) == "g") ? ttlof(bgttl[n]) : ttlof(bkttl[n])
    }
    function ttl_after(id,   n) {
        n = substr(id, 3)
        return (substr(id, 1, 1) == "g") ? ttlof(agttl[n]) : ttlof(akttl[n])
    }
    # Identities that did not exist before are skipped unless fresh_ok: a mark
    # that is itself new is the tightening, not something to ask about.
    function emit_ids(set, fresh_ok,   n, a, i, id, name) {
        n = split(set, a, "|")
        for (i = 1; i <= n; i++) {
            id = a[i]
            if (id == "" || (id in emitted)) continue
            if (!fresh_ok && !(id in bid)) continue
            emitted[id] = 1
            name = substr(id, 3)
            if (substr(id, 1, 1) == "g") printf "T\tg\t%s\t%s\t%s\n", name, bgdesc[name], bgttl[name]
            else                         printf "T\tk\t%s\t%s\t%s\n", name, bkdesc[name], bkttl[name]
        }
    }
    function loosen(k, k2,   B, A, n, a, i, id) {
        B = key_gate(k, bkg, bkown, bgown, bg)
        A = key_gate(k2, akg, akown, agown, ag)
        n = split(B, a, "|")
        for (i = 1; i <= n; i++) {
            id = a[i]
            if (id == "") continue
            if (index(A, "|" id "|") == 0) {
                printf "L\t%s\tno longer behind %s\n", k2, substr(id, 3); lost[id] = 1
            } else if (ttl_after(id) > ttl_before(id)) {
                printf "L\t%s\tan approval of %s would last longer\n", k2, substr(id, 3); lost[id] = 1
            }
        }
    }
    function value_of(line,   eq) {
        sub(/\r$/, "", line); sub(/^\xef\xbb\xbf/, "", line)
        if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/) return 0
        eq = index(line, "=")
        if (eq == 0) return 0
        pv_var = trim(substr(line, 1, eq - 1)); pv_val = substr(line, eq + 1)
        return 1
    }

    FILENAME == ARGV[1] {
        if ($1 == "G")  { bg[$2] = 1; bgown[$2] = $3; bgttl[$2] = $5; bgdesc[$2] = $6 }
        if ($1 == "GA") { bga[$2] = bga[$2] SUBSEP $3 "=" $4 }
        if ($1 == "K")  { bk[$2] = 1; bkg[$2] = $3; bkown[$2] = $5; bkttl[$2] = $7; bkdesc[$2] = $8 }
        if ($1 == "KA") { bka[$2] = bka[$2] SUBSEP $3 "=" $4 }
        next
    }
    FILENAME == ARGV[2] {
        if ($1 == "G")  { ag[$2] = 1; agown[$2] = $3; agttl[$2] = $5; agdesc[$2] = $6 }
        if ($1 == "GA") { aga[$2] = aga[$2] SUBSEP $3 "=" $4 }
        if ($1 == "K")  { ak[$2] = 1; akg[$2] = $3; akown[$2] = $5; akttl[$2] = $7; akdesc[$2] = $8 }
        if ($1 == "KA") { aka[$2] = aka[$2] SUBSEP $3 "=" $4 }
        next
    }
    FILENAME == ARGV[3] {
        if ($1 == "W") wr[$2] = 1
        if ($1 == "D") del[$2] = 1
        next
    }
    FILENAME == ARGV[4] { if (value_of($0)) bval[pv_var] = pv_val; next }
    FILENAME == ARGV[5] { if (value_of($0)) aval[pv_var] = pv_val; next }

    END {
        for (p in bg) if (bgown[p] == "1") bid["g:" p] = 1
        for (k in bk) if (bkown[k] == "1") bid["k:" k] = 1
        for (p in ag) if (agown[p] == "1" && !(("g:" p) in bid)) printf "N\tg\t%s\n", p
        for (k in ak) if (akown[k] == "1" && !(("k:" k) in bid)) printf "N\tk\t%s\n", k

        for (k in bk) {
            if (!(k in ak)) {
                if (!(k in del)) { printf "X\t%s would be lost\n", k; continue }
                emit_ids(key_gate(k, bkg, bkown, bgown, bg), 1)
                continue
            }
            if (bval[k] != aval[k] && !(k in wr)) printf "X\tthe value of %s would change\n", k
            if (bval[k] != aval[k] || bkdesc[k] != akdesc[k] || bka[k] != aka[k] \
                || (bkown[k] == "1" && akown[k] != "1"))
                emit_ids(key_gate(k, bkg, bkown, bgown, bg), 1)
            loosen(k, k)
        }
        for (k in ak) {
            if (k in bk) continue
            if (!(k in wr)) { printf "X\t%s would appear without being written\n", k; continue }
            emit_ids(key_gate(k, akg, akown, agown, ag), 0)
        }
        for (p in bg) {
            if (!(p in ag)) { emit_ids(marked_chain(p, bgown, bg, 0), 1); continue }
            if (bgdesc[p] != agdesc[p] || bga[p] != aga[p] || (bgown[p] == "1" && agown[p] != "1"))
                emit_ids(marked_chain(p, bgown, bg, 0), 1)
        }
        for (p in ag) if (!(p in bg)) emit_ids(marked_chain(p, agown, ag, 1), 0)
        # What a loosened key loses is gated as a change too. A cached deny of
        # it refuses straight away, and a no is cached against it, so a retry
        # loop meets the deny instead of a fresh dialog.
        for (id in lost) emit_ids("|" id "|", 1)
        print "OK"
    }' /dev/fd/3 /dev/fd/4 /dev/fd/5 /dev/fd/6 /dev/fd/7
}

purge_verdicts() {
    local dir="$1" scope="$2" fresh="$3" type id
    while IFS=$'\t' read -r type id; do
        [[ -z "$id" ]] && continue
        rm -f "$(verdict_file "$dir" "$scope" "$type" "$id" read)" \
              "$(verdict_file "$dir" "$scope" "$type" "$id" change)"
    done <<< "$fresh"
}

# Decide what a change from $before to $after has to ask, ask it, and return
# non-zero if the answer is no. Never prints to stdout: every caller writes
# the new ciphertext there afterwards.
commit_policy() {
    local scope="$1" before="$2" after="$3" mapping="$4" motive="$5"
    local bmeta ameta errs out bad
    bmeta="$(parse_meta <<< "$before")"
    ameta="$(parse_meta <<< "$after")"
    errs="$(grep '^E' <<< "$ameta" || true)"
    [[ -n "$errs" ]] && { printf '%s\n' "$errs" >&2; die "refusing to write a scope with metadata errors"; }

    out="$(change_policy 3< <(printf '%s\n' "$bmeta") 4< <(printf '%s\n' "$ameta") \
        5< <(printf '%s\n' "$mapping") 6< <(printf '%s\n' "$before") 7< <(printf '%s\n' "$after"))" \
        || die "the change policy failed; nothing was written"
    [[ "$(tail -n 1 <<< "$out")" == OK ]] || die "the change policy did not finish; nothing was written"

    bad="$(awk -F'\t' '$1=="X" { print "  " $2 }' <<< "$out")"
    if [[ -n "$bad" ]]; then
        printf 'agent-secrets-helper: refusing this change:\n%s\n' "$bad" >&2
        exit 1
    fi

    local candidates="" loosen fresh type id desc ttl
    while IFS=$'\t' read -r type id desc ttl; do
        [[ -z "$id" ]] && continue
        candidates="$candidates$type"$'\t'"$id"$'\t'"$desc"$'\t'"$(effective_ttl "$ttl")"$'\n'
    done <<< "$(awk -F'\t' '$1=="T" { print $2 "\t" $3 "\t" $4 "\t" $5 }' <<< "$out" | sort -u)"
    loosen="$(awk -F'\t' '$1=="L" { print $2 "\t" $3 }' <<< "$out" | sort -u)"
    fresh="$(awk -F'\t' '$1=="N" { print $2 "\t" $3 }' <<< "$out")"
    [[ -z "$candidates$loosen$fresh" ]] && return 0

    local dir; dir="$(cache_dir)"
    ensure_private_dir "$dir"
    acquire_lock "$dir/.lock.$scope"
    local rc=0
    if [[ -n "$candidates" ]]; then
        gate_locked change "$scope" "$motive" "$dir" "$candidates" "$loosen" || rc=$?
    fi
    [[ $rc -eq 0 ]] && purge_verdicts "$dir" "$scope" "$fresh"
    release_lock
    return $rc
}

cmd_index() {
    local scope="$1" file plain
    file="$(scope_file "$scope")"
    plain="$(plaintext_of "$scope")"
    printf '#toc1\tscope=%s\tsha256=%s\n' "$scope" "$(sha256_of_stdin < "$file")"
    parse_meta <<< "$plain"
}

cmd_keys() {
    local scope="$1" plain
    validate_scope "$scope"
    plain="$(plaintext_of "$scope")"
    parse_meta <<< "$plain" | awk -F'\t' '$1=="K" { print $2 }'
}

# adding and replacing values happens here so the unprivileged command never
# needs to hold the rest of a decrypted scope. the value arrives on stdin,
# never in argv, shell history, or a process listing.
# One line, no carriage return, not empty. Applied to a value from stdin and to
# a value typed into the dialog alike: the dialog is a different way in, not a
# different contract.
validate_value() {
    [[ -n "$1" ]] || die "secret value must not be empty"
    [[ "$1" != *$'\n'* ]] || die "secret values must use one line"
    [[ "$1" != *$'\r'* ]] || die "secret values must not contain carriage returns"
}

validate_desc() {
    [[ "$1" != *$'\n'* && "$1" != *$'\r'* && "$1" != *$'\t'* ]] || \
        die "secret descriptions must use one plain line"
}

# Splices one value into a payload and emits the payload. Encryption is a
# separate step so that a multi-value ask can splice every value first and
# encrypt once: either all of them land or none of them do, and a cancelled
# third field cannot leave the first two written.
splice_value() {
    local var="$1" desc="$2" force="$3" value="$4" plain="$5" updated
    if grep -q "^$var=" <<< "$plain"; then
        [[ "$force" == 1 ]] || die "$var already exists; use --force to replace it"
        updated="$(
            while IFS= read -r line || [[ -n "$line" ]]; do
                if [[ "$line" == "$var="* ]]; then
                    printf '%s=%s\n' "$var" "$value"
                else
                    printf '%s\n' "$line"
                fi
            done <<< "$plain"
        )"
    else
        updated="$plain"
        [[ -n "$desc" ]] && updated+=$'\n'"#@d $desc"
        updated+=$'\n'"$var=$value"
    fi
    printf '%s\n' "$updated"
}


cmd_set() {
    local scope="$1" var="$2" desc="$3" force="$4" value plain after
    validate_scope "$scope"
    [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "bad variable name"
    [[ "$force" == 0 || "$force" == 1 ]] || die "set force flag must be 0 or 1"
    value="$(cat)"
    value="${value%$'\n'}"
    validate_value "$value"
    validate_desc "$desc"
    plain="$(plaintext_of "$scope")"
    # A write is not a read. The value travels inwards: this verb consumes stdin
    # and emits ciphertext, and no plaintext ever reaches the caller. Gating the
    # whole scope here was protecting against nothing the gate is for, while
    # making one added key to a scope with thirteen sensitive groups cost
    # thirteen approvals -- which is how people learn to click through them.
    #
    # What does deserve a gate is replacing a credential that already exists,
    # because that is destructive and irreversible if the old value is not
    # somewhere else. Narrowing to the destination covers exactly that: writing
    # into a sensitive group still asks, about that group, and commit_policy
    # works out which group that is from the scope as it would be written.
    #
    # A key that lands outside every group is gated on its own name, which is
    # the identity sensitive_roots gives a key marked on its own. A new root
    # level key therefore matches nothing and asks nothing; overwriting a marked
    # one still asks.
    after="$(splice_value "$var" "$desc" "$force" "$value" "$plain")" || exit 1
    commit_policy "$scope" "$plain" "$after" "W"$'\t'"$var" "store a secret value at $var." || return $?
    printf '%s\n' "$after" | cmd_encrypt "$scope"
}

cmd_decrypt() {
    local scope="$1" group="" motive=""
    shift
    if [[ "${1:-}" != "--motive" && $# -gt 0 ]]; then group="$1"; shift; fi
    if [[ $# -gt 0 ]]; then
        [[ "$1" == "--motive" && $# -eq 2 ]] || die "decrypt takes a scope, optional group, and optional --motive"
        motive="$2"
        validate_motive "$motive"
    fi
    decrypt_gated read "$scope" "$group" "$motive"
}

decrypt_gated() {
    local kinds="$1" scope="$2" group="$3" motive="$4" plain meta
    validate_group "$group"
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    require_group "$meta" "$scope" "$group"
    gate_for "$kinds" "$scope" "$meta" "$motive" "$group" || return $?
    if [[ -z "$group" ]]; then
        printf '%s\n' "$plain"
    else
        render "$group" 3< <(printf '%s\n' "$meta") <<< "$plain"
    fi
}

# One command, one or more groups. Several groups rather than one because the
# groups a task needs are not always one subtree, and the alternatives were
# both bad: --all-groups hands over the whole scope and clears every gate in
# it to do so, and nesting one run inside another does not work at all, since
# the outer environment is dropped when the hardened helper steps down to the
# calling account.
#
# The groups are still named, so the gate is still the union of what those
# groups carry rather than the whole scope, and the dialog is one dialog.
cmd_run() {
    local scope="$1" motive="" all_groups=false plain meta line
    shift
    local groups=()
    # Group names run until the first option or --, so the two forms cannot be
    # mixed by accident: --all-groups already means the whole scope, and a
    # group name next to it asks for two different things at once.
    if [[ "${1:-}" == "--all-groups" ]]; then
        all_groups=true
        shift
        if [[ $# -gt 0 && "$1" != "--motive" && "$1" != "--for" && "$1" != "--" ]]; then
            die "--all-groups takes no group names; it already means the whole scope"
        fi
    else
        while [[ $# -gt 0 && "$1" != "--motive" && "$1" != "--for" && "$1" != "--" ]]; do
            if [[ "$1" == "--all-groups" ]]; then
                die "--all-groups takes no group names; it already means the whole scope"
            fi
            groups+=("$1")
            shift
        done
    fi
    while [[ $# -gt 0 && "$1" != "--" ]]; do
        case "$1" in
            --motive)
                [[ $# -ge 2 ]] || die "run needs a motive"
                motive="$2"
                validate_motive "$motive"
                shift 2 ;;
            --for)
                [[ $# -ge 2 ]] || die "--for needs a number of seconds"
                validate_window "$2"
                gate_window="$2"
                shift 2 ;;
            *) die "run takes --motive and --for after the groups, then -- and the command" ;;
        esac
    done
    [[ "${1:-}" == "--" ]] || die "run needs -- before the command"
    shift
    [[ $# -gt 0 ]] || die "run needs a command"
    validate_scope "$scope"
    local group
    for group in ${groups[@]+"${groups[@]}"}; do validate_group "$group"; done
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    if [[ ${#groups[@]} -eq 0 ]] && ! $all_groups; then
        die_no_group "$scope" "$meta"
    fi
    # Every named group has to exist. Checking them all before the gate means a
    # typo in the second one is not discovered after somebody has approved the
    # first.
    for group in ${groups[@]+"${groups[@]}"}; do
        require_group "$meta" "$scope" "$group"
    done
    gate_for read "$scope" "$meta" "$motive" ${groups[@]+"${groups[@]}"} || return $?
    local -a env_args=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        line="${line#$'\xef\xbb\xbf'}"
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# || "$line" != *=* ]] && continue
        env_args+=("$line")
    done <<< "$(
        if [[ ${#groups[@]} -gt 0 ]]; then
            render "${groups[*]}" 3< <(printf '%s\n' "$meta") <<< "$plain"
        else
            printf '%s\n' "$plain"
        fi
    )"
    local child_path=/usr/local/bin:/usr/bin:/bin
    [[ "$OS" == Darwin ]] && child_path=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
    if [[ $EUID -eq 0 ]]; then
        # setpriv is util-linux. On macOS `sudo -u` is the supported way for
        # root to become another account, and the `env -i` after it means
        # sudo's own environment handling never gets a say.
        local drop=()
        if [[ "$OS" == Darwin ]]; then
            drop=(/usr/bin/sudo -n -u "#$(target_uid)" --)
        else
            drop=(setpriv --reuid="$(target_uid)" --regid="$(id -g "$target_user")" --init-groups --)
        fi
        exec "${drop[@]}" \
            env -i HOME="$target_home" USER="$target_user" LOGNAME="$target_user" \
            PATH="$child_path" ${env_args[@]+"${env_args[@]}"} "$@"
    fi
    exec env ${env_args[@]+"${env_args[@]}"} "$@"
}

# Store a value nobody types into a command line.
#
# `secret-set` is fine when a value is being generated, because `openssl rand |
# secret-set` never puts it in an argument. It is the wrong shape when the value
# already exists and a person has to supply it: the natural thing to do with a
# command handed over by an agent is to paste the credential into it, and then
# it is in the shell history and in that agent's transcript.
#
# So the agent names the destination and never the value. The gate runs first,
# before anyone is asked to type anything, so a write that would be refused is
# refused before the typing rather than after.
# Set by cmd_ask, read by ask_values, which fills ask_values_out.
#
# Globals rather than name references: this file has to keep running under the
# bash 3.2 that macOS ships at the only bash path root actually owns, which has
# no namerefs, and the obvious 3.2 substitute is eval over array indices. That
# is not safe here. These are secret values, and a value containing a quote, a
# backslash or a dollar sign would come out of an eval changed.
ask_vars=()
ask_descs=()
ask_values_out=()

cmd_ask() {
    local scope="$1" force="$2"; shift 2
    validate_scope "$scope"
    [[ "$force" == 0 || "$force" == 1 ]] || die "ask force flag must be 0 or 1"
    [[ $# -ge 2 && $(( $# % 2 )) -eq 0 ]] || die "ask takes a scope, a force flag, and variable/description pairs"

    ask_vars=(); ask_descs=(); ask_values_out=()
    local seen="" var desc
    while [[ $# -gt 0 ]]; do
        var="$1"; desc="$2"; shift 2
        [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "bad variable name"
        validate_desc "$desc"
        case "$seen" in *"|$var|"*) die "$var named twice in one ask" ;; esac
        seen="$seen|$var|"
        ask_vars+=("$var"); ask_descs+=("$desc")
    done

    local plain n i
    n="${#ask_vars[@]}"
    plain="$(plaintext_of "$scope")"

    # Everything that can refuse this runs before anyone is asked to type.
    # Retyping a credential only to be told it was already there is how someone
    # reaches for --force without meaning it, and refusing after the typing
    # wastes the one thing the dialog was there to protect.
    for ((i = 0; i < n; i++)); do
        if grep -q "^${ask_vars[i]}=" <<< "$plain" && [[ "$force" != 1 ]]; then
            die "${ask_vars[i]} already exists; use --force to replace it"
        fi
    done

    # One approval covering every destination, rather than one per field, and
    # before anyone types: the policy runs over the scope as it would look with
    # a stand-in for each value. Only the values differ from the real write, so
    # the answer is the same one.
    local provisional="$plain" mapping=""
    for ((i = 0; i < n; i++)); do
        provisional="$(splice_value "${ask_vars[i]}" "${ask_descs[i]}" "$force" "pending" "$provisional")" || exit 1
        mapping="${mapping}W"$'\t'"${ask_vars[i]}"$'\n'
    done
    commit_policy "$scope" "$plain" "$provisional" "$mapping" "store $n secret value(s) in $scope." || return $?

    if ! approval_channel_ok; then
        echo "agent-secrets-ask: no active local session to ask in" >&2
        return $EX_UNAVAILABLE
    fi

    ask_values "$scope" || return $?

    # Splice everything, then encrypt once: a cancelled third field must not
    # leave the first two written.
    local payload="$plain"
    for ((i = 0; i < n; i++)); do
        validate_value "${ask_values_out[i]}"
        payload="$(splice_value "${ask_vars[i]}" "${ask_descs[i]}" "$force" "${ask_values_out[i]}" "$payload")"
    done
    printf '%s\n' "$payload" | cmd_encrypt "$scope"
}

# Fills ask_values_out, one value per entry in ask_vars. Uses a single form
# where the dialog tool has one and asks one at a time where it does not:
# kdialog has no multi-field form, and that is a property of the desktop rather
# than of the request.
ask_values() {
    local scope="$1" n="${#ask_vars[@]}" i rc=0 joined body title value
    ask_values_out=()

    if [[ "$n" -gt 1 ]]; then
        local -a labels=()
        body="scope: $scope"
        for ((i = 0; i < n; i++)); do
            labels+=("${ask_vars[i]}")
            [[ -n "${ask_descs[i]}" ]] && body="$body"$'\n'"${ask_vars[i]}: ${ask_descs[i]}"
        done
        body="$body"$'\n\n'"values are read straight into the encrypted store. they are not shown to the process that asked for them."

        rc=0
        joined="$(ask_secret_form "store $n secrets in $scope" "$body" "${labels[@]}")" || rc=$?
        # 4 means this tool has no multi-field form. Anything else is an answer.
        if [[ $rc -ne 4 ]]; then
            ask_report "$rc" || return $?
            local -a parts=()
            local old_ifs="$IFS"
            IFS=$'\x1f' read -r -a parts <<< "$joined" || true
            IFS="$old_ifs"
            [[ "${#parts[@]}" -eq "$n" ]] || \
                die "the dialog returned ${#parts[@]} values for $n fields; nothing was stored"
            for ((i = 0; i < n; i++)); do ask_values_out+=("${parts[i]}"); done
            return 0
        fi
    fi

    for ((i = 0; i < n; i++)); do
        title="store a secret: ${ask_vars[i]}"
        body="scope: $scope"$'\n'"key:   ${ask_vars[i]}"
        [[ -n "${ask_descs[i]}" ]] && body="$body"$'\n\n'"${ask_descs[i]}"
        body="$body"$'\n\n'"the value is read straight into the encrypted store. it is not shown to the process that asked for it."
        rc=0
        value="$(ask_secret "$title" "$body")" || rc=$?
        ask_report "$rc" || return $?
        ask_values_out+=("$value")
    done
    return 0
}

# One place that turns a dialog result into an exit code and a sentence.
ask_report() {
    case "$1" in
        0) return 0 ;;
        1) echo "agent-secrets-ask: cancelled" >&2; return $EX_NOPERM ;;
        2) echo "agent-secrets-ask: timed out, nothing was stored" >&2; return $EX_TEMPFAIL ;;
        *) echo "agent-secrets-ask: dialog failed" >&2; return $EX_UNAVAILABLE ;;
    esac
}

# Canonicalises before encrypting, so every save leaves the file tidy and the
# next splice is predictable.
cmd_encrypt() {
    local scope="$1" plain meta bad
    validate_scope "$scope"
    plain="$(cat)"; plain="${plain//$'\r'/}"
    bad="$(grep -nv -e '^[[:space:]]*$' -e '^#' <<< "$plain" | grep -v '=' || true)"
    [[ -n "$bad" ]] && die "every line must be KEY=VALUE or a '#' comment: $bad"
    meta="$(parse_meta <<< "$plain")"
    local errs; errs="$(grep '^E' <<< "$meta" || true)"
    [[ -n "$errs" ]] && { printf '%s\n' "$errs" >&2; die "refusing to write a scope with metadata errors"; }
    # Every save is a full decode and re-encode of the caller's data: the
    # payload is reparsed and the file is rebuilt from the meta stream. So a
    # renderer that ever fails to emit a key it parsed does not corrupt the
    # file, it silently shortens it. The save succeeds, the index rebuilds,
    # and nothing looks wrong until the value is needed and is not there.
    #
    # This compares what went in against what is about to be written, and
    # refuses rather than shortening. It is deliberately a runtime check and
    # not only a test: the tests protect this repository, and this protects
    # the store of somebody running a version nobody tested.
    local canonical; canonical="$(render "" 3< <(printf '%s\n' "$meta") <<< "$plain")"
    local lost; lost="$(
        comm -23 \
            <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' <<< "$plain" | sed 's/=$//' | sort -u) \
            <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' <<< "$canonical" | sed 's/=$//' | sort -u)
    )"
    if [[ -n "$lost" ]]; then
        printf 'agent-secrets-helper: these keys would be dropped by this save:\n' >&2
        printf '  %s\n' $lost >&2
        die "refusing to write a scope that loses keys"
    fi
    printf '%s\n' "$canonical" | raw_encrypt
}

# ---------------------------------------------------------------------------
# Rekey
#
# This is the one verb that writes files. Every other verb is a filter, for a
# good reason: a file the helper writes lands root-owned, and the unprivileged
# half could no longer replace it. So cmd_rekey hands ownership of each scope
# back to the caller afterwards, and only the key stays root's.
#
# Nothing here is released to anyone. The plaintext is decrypted and
# re-encrypted inside this process and never reaches a caller, so there is no
# approval dialog: the gate exists to stop values reaching a process, and this
# operation gives a value to nobody.
#
# The ordering is the whole design. A rekey that swapped the key and the scopes
# in the wrong order, or without keeping the old key, would have a window where
# a kill -9 leaves scopes nobody can read. Instead:
#
#   1. every scope is re-encrypted under the new key into a staging file, and
#      each staging file is decrypted again and compared with the original
#      plaintext before anything is committed.
#   2. the old key is copied aside, then the new key takes its place.
#   3. the staged scopes replace the real ones, one at a time.
#
# Between 2 and 3 the store is mixed: some scopes on the new key, some on the
# old. raw_decrypt tries both, so every scope opens throughout. Interrupt it
# anywhere and the store still works; rerunning finishes the job.
rekey_cleanup() {
    rm -f "$SCOPES_DIR"/*.env.gpg.rekey "$SECRETS_DIR/key/.key.new" 2>/dev/null || true
}

# A scope this process wrote is owned by root. Give it back, or the next
# secret-edit cannot replace it and rclone can no longer sync it.
own_as_caller() {
    [[ $EUID -eq 0 ]] || return 0
    chown "$(target_uid):$(id -g "$target_user")" "$1"
    chmod 600 "$1"
}

cmd_rekey() {
    [[ -f "$KEY_FILE" ]] || die "no key at $KEY_FILE"
    [[ -f "$KEY_FILE_OLD" ]] && \
        die "a previous rekey was never finished. check your scopes open, then run: secret-rekey --finish"

    local scopes=() f
    shopt -s nullglob
    for f in "$SCOPES_DIR"/*.env.gpg; do scopes+=("$f"); done
    shopt -u nullglob

    trap rekey_cleanup EXIT
    rekey_cleanup

    local newkey="$SECRETS_DIR/key/.key.new"
    generate_key_material > "$newkey"
    chmod 600 "$newkey"

    local plain check name
    for f in ${scopes[@]+"${scopes[@]}"}; do
        name="${f##*/}"; name="${name%.env.gpg}"
        plain="$(raw_decrypt "$f")" || die "cannot decrypt $name; nothing was changed"
        printf '%s\n' "$plain" | encrypt_with "$newkey" > "$f.rekey" \
            || die "cannot re-encrypt $name; nothing was changed"
        # Read it back before trusting it. This is the only moment where a bad
        # write is still free to undo.
        check="$(decrypt_with "$newkey" "$f.rekey")" \
            || die "$name did not decrypt under the new key; nothing was changed"
        [[ "$check" == "$plain" ]] \
            || die "$name did not survive re-encryption intact; nothing was changed"
        echo "  verified $name" >&2
    done

    cp "$KEY_FILE" "$KEY_FILE_OLD"
    chmod 600 "$KEY_FILE_OLD"
    mv -f "$newkey" "$KEY_FILE"
    chmod 600 "$KEY_FILE"

    for f in ${scopes[@]+"${scopes[@]}"}; do
        mv -f "$f.rekey" "$f"
        own_as_caller "$f"
    done

    trap - EXIT
    logger -p authpriv.notice -t agent-secrets-helper "rekey scopes=${#scopes[@]}" 2>/dev/null || true
    printf '%s\n' "${#scopes[@]}"
}

# Finishing what an interrupted rekey left behind.
#
# After a kill the store can hold a mix: some scopes on the new key, some still
# on the old. cmd_rekey refuses to run then, because generating a second new
# key would overwrite the old one and strand whatever still needs it. So this
# converts the stragglers using the key pair already on disk, and generates
# nothing.
cmd_rekey_resume() {
    [[ -f "$KEY_FILE_OLD" ]] || die "no rekey is in progress"
    local f name plain check moved=0
    trap rekey_cleanup EXIT
    rekey_cleanup
    shopt -s nullglob
    for f in "$SCOPES_DIR"/*.env.gpg; do
        name="${f##*/}"; name="${name%.env.gpg}"
        if decrypt_with "$KEY_FILE" "$f" >/dev/null; then
            continue
        fi
        plain="$(decrypt_with "$KEY_FILE_OLD" "$f")" \
            || die "$name opens under neither key. leaving it alone"
        printf '%s\n' "$plain" | encrypt_with "$KEY_FILE" > "$f.rekey" \
            || die "cannot re-encrypt $name; nothing was changed"
        check="$(decrypt_with "$KEY_FILE" "$f.rekey")" \
            || die "$name did not decrypt under the current key; nothing was changed"
        [[ "$check" == "$plain" ]] \
            || die "$name did not survive re-encryption intact; nothing was changed"
        mv -f "$f.rekey" "$f"
        own_as_caller "$f"
        moved=$((moved + 1))
        echo "  moved $name" >&2
    done
    shopt -u nullglob
    trap - EXIT
    logger -p authpriv.notice -t agent-secrets-helper "rekey-resume scopes=$moved" 2>/dev/null || true
    printf '%s\n' "$moved"
}

# Removing the old key is the irreversible half, so it is a separate verb and
# it checks first: every scope has to open under the new key alone.
cmd_rekey_finish() {
    [[ -f "$KEY_FILE_OLD" ]] || die "there is no previous key to remove"
    local f name checked=0
    shopt -s nullglob
    for f in "$SCOPES_DIR"/*.env.gpg; do
        name="${f##*/}"; name="${name%.env.gpg}"
        decrypt_with "$KEY_FILE" "$f" >/dev/null \
            || die "$name does not open under the current key. the old key is being kept"
        checked=$((checked + 1))
    done
    shopt -u nullglob
    rm -f "$KEY_FILE_OLD"
    logger -p authpriv.notice -t agent-secrets-helper "rekey-finish scopes=$checked" 2>/dev/null || true
    printf '%s\n' "$checked"
}

# Opening a group to edit it is a read now and a change on save, and asking
# twice for one edit is a dialog nobody learns anything from. So the open asks
# for both, and the save finds the change already approved.
cmd_edit_extract() {
    local scope="$1" group="$2"
    [[ -n "$group" ]] || die "edit-extract needs a group"
    decrypt_gated "read change" "$scope" "$group" "Edit the requested secret group."
}

# Replaces one subtree and re-emits the whole scope. The filter has to be
# applied here rather than in the wrapper: a wrapper that decrypted everything
# and then sliced would already have seen every sensitive value.
cmd_edit_merge() {
    local scope="$1" group="$2" plain meta edited
    [[ -n "$group" ]] || die "edit-merge needs a group"
    validate_group "$group"
    edited="$(cat)"; edited="${edited//$'\r'/}"
    plain="$(plaintext_of "$scope")"
    meta="$(parse_meta <<< "$plain")"
    require_group "$meta" "$scope" "$group"
    # Everything outside the subtree, unchanged, plus the edited subtree.
    local rest; rest="$(render_excluding "$group" "$meta" "$plain")"
    local merged; merged="$(printf '%s\n%s\n' "$rest" "$edited")"

    # The edit may drop or rewrite anything that was inside the group, and may
    # write any key it names. Everything else has to come through unchanged,
    # and commit_policy checks that against the original plaintext, not
    # against $rest: $rest coming back wrong is the entire failure mode, and a
    # check that trusted it would agree with the bug. cmd_encrypt cannot catch
    # this either, since by then the keys are already missing from its input.
    #
    # The gate is decided by what the save changes, not by the group named on
    # the command line. An edit of service.api that declares `#@g pg_prod`
    # moves PG_PROD_PASS out from under a marked pg, and that has to be asked
    # about pg, by name, however innocent the group being edited is.
    local mapping
    mapping="$(
        awk -F'\t' -v g="$group" '$1=="K" && ($3==g || index($3 ".", g ".")==1) { print "D\t" $2; print "W\t" $2 }' <<< "$meta"
        parse_meta <<< "$edited" | awk -F'\t' '$1=="K" { print "W\t" $2 }'
    )"
    commit_policy "$scope" "$plain" "$merged" "$mapping" "Save changes to the requested secret group." || return $?
    printf '%s\n' "$merged" | cmd_encrypt "$scope"
}

# Everything in the scope except the named subtree, as a filtered meta stream.
#
# This used to build two newline-separated lists in the shell and hand them to
# awk with -v. The awk that ships with macOS rejects that outright: a -v
# assignment there cannot contain a newline ("awk: newline in string"). Nothing
# checked, because the failure happened inside a process substitution, whose
# exit status the caller never sees. So render_excluding returned nothing, and
# `secret-edit <scope> <group>` wrote back a scope containing only the group
# that had just been edited. Every other group, silently gone, on every mac.
#
# One pass now, and the only -v is a single-line group path.
render_excluding() {
    local group="$1" meta="$2" plain="$3"
    render "" 3< <(awk -F'\t' -v g="$group" '
      function inside(p) { return (p == g || index(p ".", g ".") == 1) }
      { rec[NR] = $0; t[NR] = $1; id[NR] = $2 }
      $1=="K" && !inside($3) { keepk[$2] = 1 }
      $1=="G" &&  inside($2) { dropg[$2] = 1 }
      END {
        for (i = 1; i <= NR; i++) {
          if (t[i] == "G" || t[i] == "GA") { if (!(id[i] in dropg)) print rec[i]; continue }
          if (t[i] == "K" || t[i] == "KA") { if (id[i] in keepk)    print rec[i]; continue }
        }
      }' <<< "$meta") <<< "$plain"
}

main() {
    [[ $# -ge 1 ]] || die "usage: secret-helper <verb> [args]"
    local verb="$1"; shift
    case "$verb" in
        version)      [[ $# -eq 0 ]] || die "version takes no arguments"; printf '%s\n' "$HELPER_PROTOCOL" ;;
        index)        [[ $# -eq 1 ]] || die "index takes a scope"; cmd_index "$1" ;;
        keys)         [[ $# -eq 1 ]] || die "keys takes a scope"; cmd_keys "$1" ;;
        set)          [[ $# -eq 4 ]] || die "set takes a scope, variable, description, and force flag"; cmd_set "$@" ;;
        ask)          [[ $# -ge 4 ]] || die "ask takes a scope, a force flag, and variable/description pairs"; cmd_ask "$@" ;;
        decrypt)      [[ $# -ge 1 && $# -le 4 ]] || die "decrypt takes a scope, optional group, and optional --motive"; cmd_decrypt "$@" ;;
        run)          [[ $# -ge 3 ]] || die "run takes a scope, one or more groups or --all-groups, and a command"; cmd_run "$@" ;;
        encrypt)      [[ $# -eq 1 ]] || die "encrypt takes a scope"; cmd_encrypt "$1" ;;
        edit-extract) [[ $# -eq 2 ]] || die "edit-extract takes a scope and group"; cmd_edit_extract "$@" ;;
        edit-merge)   [[ $# -eq 2 ]] || die "edit-merge takes a scope and group"; cmd_edit_merge "$@" ;;
        rekey)        [[ $# -eq 0 ]] || die "rekey takes no arguments"; cmd_rekey ;;
        rekey-resume) [[ $# -eq 0 ]] || die "rekey-resume takes no arguments"; cmd_rekey_resume ;;
        rekey-finish) [[ $# -eq 0 ]] || die "rekey-finish takes no arguments"; cmd_rekey_finish ;;
        gate)         [[ $# -ge 2 ]] || die "gate takes a scope, optional --motive and --for, and one or more groups"
                      local_gate_scope="$1"; shift
                      local_gate_motive=""
                      while [[ "${1:-}" == "--motive" || "${1:-}" == "--for" ]]; do
                          [[ $# -ge 3 ]] || die "gate needs $1 with a value, then one or more groups"
                          if [[ "$1" == "--motive" ]]; then
                              local_gate_motive="$2"; validate_motive "$local_gate_motive"
                          else
                              validate_window "$2"; gate_window="$2"
                          fi
                          shift 2
                      done
                      validate_scope "$local_gate_scope"
                      for local_gate_group in "$@"; do validate_group "$local_gate_group"; done
                      local_gate_meta="$(parse_meta <<< "$(plaintext_of "$local_gate_scope")")"
                      for local_gate_group in "$@"; do
                          require_group "$local_gate_meta" "$local_gate_scope" "$local_gate_group"
                      done
                      gate_for read "$local_gate_scope" "$local_gate_meta" "$local_gate_motive" "$@" ;;
        *)            die "unknown verb" ;;
    esac
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && main "$@"
