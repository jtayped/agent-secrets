#!/usr/bin/env bash
# store one one-line value read from stdin.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: <producer> | secret-set <scope> <group.path.key> [--desc <text>] [--force]" >&2
    exit 1
}

[[ $# -ge 2 ]] || usage
scope="$1"
path="$2"
shift 2
validate_scope "$scope"
desc=""
force=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --desc) [[ $# -ge 2 ]] || usage; desc="$2"; shift 2 ;;
        --force) force=1; shift ;;
        *) usage ;;
    esac
done

[[ "$path" =~ ^[A-Za-z0-9_.]+$ ]] || { echo "error: bad path '$path'" >&2; exit 1; }
[[ -t 0 ]] && { echo "error: send the value on stdin, not in an argument" >&2; exit 1; }
var="$(printf '%s' "$path" | tr '.a-z' '_A-Z')"
[[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || {
    echo "error: '$path' does not make a usable variable name" >&2
    exit 1
}

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || { echo "error: no scope '$scope'" >&2; exit 1; }
ensure_key
tmp="$scope_file.new"
trap 'rm -f "$tmp"' EXIT
secret_helper set "$scope" "$var" "$desc" "$force" > "$tmp"
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
echo "stored $var in $scope"
