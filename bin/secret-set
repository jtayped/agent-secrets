#!/usr/bin/env bash
# store one one-line value read from stdin.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: <producer> | secret-set <scope> <group.path.key> [--desc <text>] [--group-desc <text>] [--force]" >&2
    echo "       --group-desc creates the group when it does not exist yet, and says what it holds" >&2
    echo "       secret-list <scope> --tree   to find the group it belongs in" >&2
    exit 1
}

[[ $# -ge 2 ]] || usage
scope="$1"
path="$2"
shift 2
validate_scope "$scope"
desc=""
group_desc=""
force=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --desc) [[ $# -ge 2 ]] || usage; desc="$2"; shift 2 ;;
        --group-desc) [[ $# -ge 2 ]] || usage; group_desc="$2"; shift 2 ;;
        --force) force=1; shift ;;
        *) usage ;;
    esac
done

split_key_path "$path" || exit 1
var="$path_var"
[[ -t 0 ]] && { echo "error: send the value on stdin, not in an argument" >&2; exit 1; }
if [[ -n "$group_desc" && -z "$path_group" ]]; then
    echo "error: --group-desc needs a group in the path, like $scope <group>.$path" >&2
    exit 1
fi

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || { echo "error: no scope '$scope'" >&2; exit 1; }
require_helper_protocol secret-set || exit $?
ensure_key
scope_lock "$scope"
tmp="$scope_file.new"
trap 'rm -f "$tmp"; scope_unlock' EXIT
secret_helper set "$scope" "$var" "$desc" "$force" "$path_group" "$group_desc" > "$tmp"
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
if [[ -n "$path_group" ]]; then
    echo "stored $var in $scope, group $path_group"
else
    echo "stored $var in $scope"
    ungrouped_note "$var" "$scope"
fi
