#!/usr/bin/env bash
# ask for one value in a dialog and store it. the value never reaches this
# wrapper, this shell, or whoever asked for the command to be run.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: secret-ask <scope> <group.path.key> [--desc <text>] [--group-desc <text>] [<group.path.key> ...]... [--force]" >&2
    echo "       --desc and --group-desc attach to the path in front of them" >&2
    echo "       secret-list <scope> --tree   to find the group they belong in" >&2
    exit 1
}

[[ $# -ge 2 ]] || usage
scope="$1"
shift
validate_scope "$scope"

# --desc and --group-desc attach to the path in front of them, the way #@d
# attaches to the declaration after it. anything else would need a flag per
# credential and a way to pair them up by hand.
#
# each path travels as four fields: variable, description, group, group
# description.
force=0
quads=()
var=""
ungrouped=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --desc)
            [[ $# -ge 2 && -n "$var" ]] || usage
            quads[${#quads[@]}-3]="$2"
            shift 2 ;;
        --group-desc)
            [[ $# -ge 2 && -n "$var" ]] || usage
            [[ -n "${quads[${#quads[@]}-2]}" ]] || {
                echo "error: --group-desc needs a group in the path in front of it" >&2
                exit 1
            }
            quads[${#quads[@]}-1]="$2"
            shift 2 ;;
        --force) force=1; shift ;;
        -*) usage ;;
        *)
            split_key_path "$1" || exit 1
            shift
            var="$path_var"
            [[ -n "$path_group" ]] || ungrouped+=("$var")
            quads+=("$var" "" "$path_group" "") ;;
    esac
done
[[ "${#quads[@]}" -ge 4 ]] || usage

require_helper_protocol secret-ask || exit $?

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}
ensure_key

# held while the values are typed, which is the only way to keep a write that
# lands meanwhile from being thrown away when this one moves into place.
scope_lock "$scope"
tmp="$scope_file.new"
trap 'rm -f "$tmp"; scope_unlock' EXIT
rc=0
secret_helper ask "$scope" "$force" --grouped "${quads[@]}" > "$tmp" || rc=$?
if [[ $rc -ne 0 ]]; then
    case $rc in
        69) echo "secret-ask: no local session is available to ask in" >&2 ;;
        75) echo "secret-ask: the dialog timed out. nothing was stored." >&2 ;;
        # 77 arrives from two places: the approval gate refusing the write, and
        # the person closing the value dialog. both mean no, and the helper has
        # already said which one on stderr, so do not guess here.
        77) echo "secret-ask: refused. nothing was stored." >&2 ;;
    esac
    exit "$rc"
fi
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
stored=""
for ((i = 0; i < ${#quads[@]}; i += 4)); do stored="$stored ${quads[i]}"; done
echo "stored$stored in $scope"
for var in ${ungrouped[@]+"${ungrouped[@]}"}; do ungrouped_note "$var" "$scope"; done
