#!/usr/bin/env bash
# ask for one value in a dialog and store it. the value never reaches this
# wrapper, this shell, or whoever asked for the command to be run.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: secret-ask <scope> <group.path.key> [--desc <text>] [--force]" >&2
    echo "       secret-list <scope> --tree   to find the group it belongs in" >&2
    exit 1
}

[[ $# -ge 2 ]] || usage
scope="$1"
path="$2"
shift 2
validate_scope "$scope"
desc=""
force=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --desc) [[ $# -ge 2 ]] || usage; desc="$2"; shift 2 ;;
        --force) force=1; shift ;;
        *) usage ;;
    esac
done

[[ "$path" =~ ^[A-Za-z0-9_.]+$ ]] || { echo "error: bad path '$path'" >&2; exit 1; }
var="$(printf '%s' "$path" | tr '.a-z' '_A-Z')"
[[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || {
    echo "error: '$path' does not make a usable variable name" >&2
    exit 1
}

require_helper_protocol secret-ask || exit $?

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}
ensure_key

tmp="$scope_file.new"
trap 'rm -f "$tmp"' EXIT
rc=0
secret_helper ask "$scope" "$var" "$desc" "$force" > "$tmp" || rc=$?
if [[ $rc -ne 0 ]]; then
    case $rc in
        69) echo "secret-ask: no local session is available to ask in" >&2 ;;
        75) echo "secret-ask: the dialog timed out. nothing was stored." >&2 ;;
        # 77 arrives from two places: the approval gate refusing the write, and
        # the person closing the value dialog. both mean no, and the helper has
        # already said which one on stderr, so do not guess here.
        77) echo "secret-ask: refused. nothing was stored." >&2 ;;
    esac
    exit "$rc"
fi
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
echo "stored $var in $scope"
