#!/usr/bin/env bash
# create or edit a scope, or one group within a scope.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: secret-edit <scope> [<group> | --new]" >&2
    echo "       secret-list" >&2
    echo "       secret-list <scope> --tree" >&2
    exit 1
}

[[ $# -ge 1 && $# -le 2 ]] || usage
scope="$1"
validate_scope "$scope"
create_new=false
group=""
if [[ $# -eq 2 ]]; then
    if [[ "$2" == "--new" ]]; then create_new=true; else group="$2"; fi
fi

mkdir -p "$secrets_scopes_dir"
chmod 700 "$secrets_scopes_dir"
scope_file="$secrets_scopes_dir/$scope.env.gpg"
if [[ ! -f "$scope_file" ]] && ! $create_new; then
    echo "error: no scope '$scope' yet" >&2
    echo "existing scopes: $(scopes_line)" >&2
    echo "to create it: secret-edit $scope --new" >&2
    exit 1
fi
[[ -n "$group" && ! -f "$scope_file" ]] && { echo "error: no scope '$scope'" >&2; exit 1; }
ensure_key

tmp="$(mktemp "${TMPDIR:-/tmp}/secret-edit-$scope.XXXXXX")"
trap 'secure_rm "$tmp"; rm -f "$scope_file.new"' EXIT
if [[ -f "$scope_file" ]]; then
    if [[ -n "$group" ]]; then
        secret_helper edit-extract "$scope" "$group" > "$tmp"
        [[ -s "$tmp" ]] || {
            echo "error: no group '$group' in '$scope'. see: secret-list $scope --tree" >&2
            exit 1
        }
    else
        secret_helper decrypt "$scope" > "$tmp"
    fi
else
    printf '# %s secrets. use one key=value line, without quotes or export.\n' "$scope" > "$tmp"
    printf '# metadata: #@g <group.path> <description>, #@d <description>, #@a <name>=<value>, #@sensitive\n' >> "$tmp"
fi

before="$(sha256_of_stdin < "$tmp")"
# editor values such as "code -w" intentionally carry flags.
# shellcheck disable=SC2086
${EDITOR:-nano} "$tmp"
if [[ "$before" == "$(sha256_of_stdin < "$tmp")" ]]; then
    echo "no changes. $scope was left alone."
    exit 0
fi

if [[ -n "$group" ]]; then
    secret_helper edit-merge "$scope" "$group" < "$tmp" > "$scope_file.new"
else
    secret_helper encrypt "$scope" < "$tmp" > "$scope_file.new"
fi
[[ -s "$scope_file.new" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$scope_file.new" "$scope_file"
secret-reindex "$scope" >/dev/null
echo "updated $scope_file"
