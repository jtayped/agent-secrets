#!/usr/bin/env bash
# list scopes, or browse one scope a level at a time. never prints a value.
#
# browsing is the default because the tree is not what you want when you have
# forgotten where something lives. `--tree` prints everything, which is useful
# once you know roughly what you are looking at and unreadable when you do not.
# so this behaves like ls: one level, with enough of a summary on each subgroup
# to tell you whether it is worth going into.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-list                          every scope
       secret-list <scope>                  the top level of a scope
       secret-list <scope> <group>          one level inside a group
       secret-list <scope> [<group>] --tree the whole subtree
       secret-list <scope> --keys           every variable name, one per line
MSG
    exit 1
}

tree=false
keys=false
scope=""
group=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --tree) tree=true; shift ;;
        --keys) keys=true; shift ;;
        -h|--help) usage ;;
        -*) echo "error: unknown option '$1'" >&2; usage ;;
        *)
            if [[ -z "$scope" ]]; then scope="$1"
            elif [[ -z "$group" ]]; then group="$1"
            else echo "error: too many arguments" >&2; usage
            fi
            shift ;;
    esac
done

if [[ -z "$scope" ]]; then
    if $tree || $keys; then
        echo "error: --tree and --keys need a scope" >&2
        usage
    fi
    scopes="$(list_scopes)"
    if [[ -z "$scopes" ]]; then
        echo "no scopes yet. create one with: secret-edit <scope> --new" >&2
        exit 0
    fi
    printf '%s\n' "$scopes"
    exit 0
fi

if $tree && $keys; then
    echo "error: --tree and --keys are alternatives" >&2
    usage
fi
if $keys && [[ -n "$group" ]]; then
    echo "error: --keys takes no group; it always lists the whole scope" >&2
    usage
fi

validate_scope "$scope"
if [[ -n "$group" && ! "$group" =~ ^[a-z0-9][a-z0-9_]*(\.[a-z0-9][a-z0-9_]*)*$ ]]; then
    echo "error: group paths are dotted lowercase, like pg.aws.main (got '$group')" >&2
    exit 1
fi

scope_file="$secrets_scopes_dir/$scope.env.gpg"
if [[ ! -f "$scope_file" ]]; then
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
fi

toc="$secrets_index_dir/$scope.toc"
if [[ -f "$toc" ]]; then
    want="$(sha256_of_stdin < "$scope_file")"
    have="$(sed -n '1s/.*sha256=//p' "$toc")"
else
    want=""
    have="missing"
fi

# the index is a display cache, so a stale one is a wrong answer rather than a
# slow one. the flat key list can fall back to the helper; the views that read
# group structure cannot.
if $keys; then
    if [[ "$want" == "$have" ]]; then
        awk -F'\t' '$1=="K" { print $2 }' "$toc"
    else
        echo "warning: index for '$scope' is stale or missing. rebuilding it now." >&2
        secret_helper keys "$scope"
    fi
    exit 0
fi

[[ "$want" == "$have" ]] || {
    echo "error: index for '$scope' is stale or missing. run: secret-reindex $scope" >&2
    exit 78
}

# a group path is browsable if it was declared, or if some declared group sits
# beneath it. `#@g pg.demo` with no `#@g pg` above it is legal, and `pg` still
# has to be somewhere you can stand.
group_exists() {
    awk -F'\t' -v g="$1" '
        $1=="G" && ($2 == g || index($2, g ".") == 1) { found = 1 }
        END { exit !found }' "$toc"
}

# the distinct next path segments below a parent, declared or implied.
children_of() {
    awk -F'\t' -v p="$1" '
        $1!="G" { next }
        {
            if (p == "") { rest = $2 }
            else if (index($2, p ".") == 1) { rest = substr($2, length(p) + 2) }
            else { next }
            dot = index(rest, ".")
            child = (dot ? substr(rest, 1, dot - 1) : rest)
            if (!(child in seen)) { seen[child] = 1; print child }
        }' "$toc" | sort | paste -sd' ' -
}

if [[ -n "$group" ]] && ! group_exists "$group"; then
    echo "error: no group '$group' in '$scope'" >&2
    parent="${group%.*}"
    [[ "$parent" == "$group" ]] && parent=""
    siblings="$(children_of "$parent")"
    if [[ -n "$siblings" ]]; then
        echo "at that level: $siblings" >&2
    else
        echo "browse it with: secret-list $scope" >&2
    fi
    exit 1
fi

if $tree; then
    awk -F'\t' -v want="$group" '
      BEGIN { ng=0; nk=0 }
      function in_scope(p) { return (want == "" || p == want || index(p ".", want ".") == 1) }
      $1=="E" { printf "  ! line %s: %s\n", $2, $3; err=1; next }
      $1=="G" { path[ng]=$2; own[$2]=$3; eff[$2]=$4; desc[$2]=$6; ng++; next }
      $1=="GA"{ attr[$2] = attr[$2] (attr[$2]==""?"":" ") $3 "=" $4; next }
      $1=="K" { kv[nk]=$2; kg[nk]=$3; kl[nk]=$4; kown[nk]=$5; kd[nk]=$8; nk++; next }
      $1=="KA"{ kattr[$2] = kattr[$2] (kattr[$2]==""?"":" ") $3 "=" $4; next }
      function indent(p, n) { n=gsub(/\./,".",p); return sprintf("%*s", n*2, "") }
      function mark(o,e) { return o ? " [sensitive]" : (e ? " [sensitive, inherited]" : "") }
      END {
        if (err) printf "\n"
        for (i=0;i<ng;i++) for (j=i+1;j<ng;j++) if (path[j]<path[i]) { t=path[i];path[i]=path[j];path[j]=t }
        for (i=0;i<ng;i++) {
          p=path[i]; if (!in_scope(p)) continue
          pad=indent(p)
          printf "%s%s%s%s\n", pad, p, mark(own[p],eff[p]), (desc[p]!="" ? "   " desc[p] : "")
          if (attr[p]!="") printf "%s  (%s)\n", pad, attr[p]
          for (k=0;k<nk;k++) if (kg[k]==p) {
            printf "%s  %-28s %s\n", pad, kl[k] (kown[k]?" *":""), kd[k]
            if (kattr[kv[k]]!="") printf "%s    (%s)\n", pad, kattr[kv[k]]
          }
        }
        if (want != "") exit
        first=1
        for (k=0;k<nk;k++) if (kg[k]=="") {
          if (first) { printf "\n(ungrouped)\n"; first=0 }
          printf "  %-28s %s\n", kl[k] (kown[k]?" *":""), kd[k]
        }
      }' "$toc"
    exit 0
fi

# ---------------------------------------------------------------------------
# level view
awk -F'\t' -v scope="$scope" -v here="$group" '
  BEGIN { FS="\t"; ng=0; nk=0 }
  $1=="E" { errs = errs sprintf("  ! line %s: %s\n", $2, $3); next }
  $1=="G" { gp[ng]=$2; gown[$2]=$3; geff[$2]=$4; gdesc[$2]=$6; ng++; next }
  $1=="K" { kv[nk]=$2; kg[nk]=$3; kl[nk]=$4; kown[nk]=$5; keff[nk]=$6; kd[nk]=$8; nk++; next }

  # strictly below "parent", at any depth
  function under(path, parent) {
      if (parent == "") return 1
      return (index(path, parent ".") == 1)
  }
  function leafname(path, parent) {
      return (parent == "") ? path : substr(path, length(parent) + 2)
  }
  function mark(own, eff) {
      return own ? "  [sensitive]" : (eff ? "  [sensitive, inherited]" : "")
  }
  # what is down there, so you can tell whether it is worth going into
  # "sub" is a reserved awk function name, hence nsub.
  function summary(g,   i, nsub, nkey, out) {
      nsub = 0; nkey = 0
      for (i = 0; i < ng; i++) if (gp[i] != g && under(gp[i], g)) nsub++
      for (i = 0; i < nk; i++) if (kg[i] == g || under(kg[i], g)) nkey++
      out = ""
      if (nsub) out = nsub " group" (nsub == 1 ? "" : "s")
      if (nkey) out = out (out == "" ? "" : ", ") nkey " key" (nkey == 1 ? "" : "s")
      return (out == "" ? "empty" : out)
  }

  # trailing spaces on a padded row are invisible until someone pipes the
  # output somewhere that cares.
  function emit(line) { sub(/[ \t]+$/, "", line); print line }
  function tail(desc, own, eff,   mk) {
      mk = mark(own, eff)
      if (mk == "") return desc
      return (desc == "") ? substr(mk, 3) : desc mk
  }

  END {
      if (errs != "") printf "%s\n", errs

      # a group can be declared at depth with no declaration for its parents:
      # `#@g pg.demo` with no `#@g pg` is legal. so the children of a level are
      # the distinct next path segments below it, not just the declared groups
      # that happen to sit exactly one level down. without this, a scope whose
      # groups are all declared at depth browses as empty.
      n = 0
      for (i = 0; i < ng; i++) {
          if (gp[i] == here || !under(gp[i], here)) continue
          rest = leafname(gp[i], here)
          dot = index(rest, ".")
          child = (dot ? substr(rest, 1, dot - 1) : rest)
          full = (here == "" ? child : here "." child)
          if (!(full in seen_child)) { seen_child[full] = 1; subs[n++] = full }
      }
      for (i = 0; i < n; i++) for (j = i+1; j < n; j++)
          if (subs[j] < subs[i]) { t = subs[i]; subs[i] = subs[j]; subs[j] = t }

      m = 0
      for (i = 0; i < nk; i++) if (kg[i] == here) here_keys[m++] = i
      # sorted, because this is an ls and ls sorts. --tree keeps file order.
      for (i = 0; i < m; i++) for (j = i+1; j < m; j++)
          if (kl[here_keys[j]] < kl[here_keys[i]]) {
              t = here_keys[i]; here_keys[i] = here_keys[j]; here_keys[j] = t
          }

      # one width for both columns, so subgroups and keys read as a single list
      w = 12
      here_sensitive = (here != "" && (gown[here] || geff[here]))
      for (i = 0; i < n; i++) { l = length(leafname(subs[i], here)) + 1; if (l > w) w = l }
      for (i = 0; i < m; i++) { l = length(kl[here_keys[i]]) + 2;        if (l > w) w = l }
      if (w > 30) w = 30

      label = (here == "") ? scope : scope ":" here
      head = label "  (" summary(here) ")"
      if (here != "") head = head "  " tail(gdesc[here], gown[here], geff[here])
      emit(head)

      if (n + m == 0) {
          print ""
          print "  (nothing here)"
          exit
      }
      print ""

      for (i = 0; i < n; i++) {
          g = subs[i]
          emit(sprintf("  %-*s  %-17s %s", w, leafname(g, here) "/", summary(g),
                       tail(gdesc[g], gown[g], geff[g])))
      }
      if (n > 0 && m > 0) print ""
      for (i = 0; i < m; i++) {
          k = here_keys[i]
          # a star on every key inside an already-marked group would be true and
          # useless. mark only what the heading does not already say.
          star = (keff[k] && !here_sensitive) ? " *" : ""
          if (star != "") starred = 1
          emit(sprintf("  %-*s  %-17s %s", w, kl[k] star, "", kd[k]))
      }

      print ""
      if (n > 0) {
          printf "  go deeper with: secret-list %s %s%s\n",
                 scope, (here == "" ? "" : here "."), leafname(subs[0], here)
      }
      if (starred) print "  * needs your approval before it can be read."
      if (here != "") {
          printf "  give a command just this group: secret-run %s %s -- <command>\n", scope, here
      }
  }' "$toc"
