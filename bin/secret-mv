#!/usr/bin/env bash
# move or copy keys and groups, renaming the variables that hold them. no value
# passes through this command.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-mv <scope> <from> <to> [--group-desc <text>] [<from> <to> ...]... [--copy] [--dry-run]

  a key goes to a dotted path, the same shape secret-set takes:
    secret-mv work OPENAI_KEY ai.openai.API_KEY        OPENAI_KEY becomes AI_OPENAI_API_KEY
  a group goes to a new group path, with everything under it:
    secret-mv work stage pg.stage                      STAGE_HOST becomes PG_STAGE_HOST

  this renames variables. a program reading the old name will not find the
  value under the new one.

  --group-desc  creates the group a key moves into, when it does not exist yet
  --copy        keep the original too
  --dry-run     say what would change and what it would ask, and change nothing
MSG
    exit 1
}

[[ $# -ge 3 ]] || usage
scope="$1"
shift
validate_scope "$scope"
triples=()
copy=0
dry=0
pending=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --copy) copy=1; shift ;;
        --dry-run) dry=1; shift ;;
        --group-desc)
            [[ $# -ge 2 && ${#triples[@]} -ge 3 && ${#pending[@]} -eq 0 ]] || usage
            triples[${#triples[@]}-1]="$2"
            shift 2 ;;
        -*) usage ;;
        *)
            [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.]*$ ]] || { echo "error: bad name '$1'" >&2; exit 1; }
            pending+=("$1")
            shift
            if [[ ${#pending[@]} -eq 2 ]]; then
                triples+=("${pending[0]}" "${pending[1]}" "")
                pending=()
            fi ;;
    esac
done
[[ ${#pending[@]} -eq 0 && ${#triples[@]} -ge 3 ]] || usage

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}
require_helper_protocol secret-mv || exit $?
ensure_key

if [[ "$dry" == 1 ]]; then
    secret_helper mv "$scope" "$copy" 1 "${triples[@]}"
    exit 0
fi

scope_lock "$scope"
tmp="$scope_file.new"
trap 'rm -f "$tmp"; scope_unlock' EXIT
secret_helper mv "$scope" "$copy" 0 "${triples[@]}" > "$tmp"
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
