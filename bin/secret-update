#!/usr/bin/env bash
# upgrade the installed commands without touching a single stored secret.
#
# the guarantee this command exists to make: an upgrade replaces code in
# ~/.local/bin and ~/.local/libexec, and never writes to ~/.secrets except
# through a numbered migration that is forbidden to read or rewrite a scope.
# the scopes and the key are yours; the tool's job during an upgrade is to
# leave them exactly as it found them.
#
# there is a backup before any migration runs, and a --dry-run that shows the
# whole plan and changes nothing.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-update [--check] [--dry-run] [--yes]

  --check     report what an upgrade would do, then stop. touches nothing.
  --dry-run   the same as --check, spelled the other way.
  --yes       do not ask before installing.

with no options, it reports the plan and asks before doing anything.
MSG
    exit 1
}

check_only=false
assume_yes=false
backup=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check|--dry-run) check_only=true; shift ;;
        --yes|-y) assume_yes=true; shift ;;
        --version) agent_secrets_version; exit 0 ;;
        -h|--help) usage ;;
        *) echo "error: unknown option '$1'" >&2; usage ;;
    esac
done

say() { printf '%s\n' "$*"; }

installed_version="$(agent_secrets_version)"
source_dir="$(manifest_value source || true)"
# running straight out of a clone, before install.sh has written a manifest.
if [[ -z "$source_dir" && -x "$agent_secrets_self_dir/../install.sh" ]]; then
    source_dir="$(cd -- "$agent_secrets_self_dir/.." && pwd)"
fi
installed_commit="$(manifest_value commit || true)"

say "agent-secrets update"
say
say "  installed version   $installed_version"
say "  store               $secrets_dir (format $(store_version))"
say "  code expects        store format $AGENT_SECRETS_STORE_FORMAT"

# ---------------------------------------------------------------------------
# where the code came from
if [[ -z "$source_dir" ]]; then
    cat >&2 <<MSG

error: this install did not record where it came from.

  that happens when the commands were installed before secret-update existed.
  clone the repository again and run ./install.sh from it once; after that this
  command will work, and your store is not involved either way.
MSG
    exit 1
fi
if [[ ! -d "$source_dir" ]]; then
    cat >&2 <<MSG

error: the checkout this was installed from is gone:
  $source_dir

  clone it again somewhere and run ./install.sh from there. nothing in
  $secrets_dir is affected by this.
MSG
    exit 1
fi
say "  source              $source_dir"

# ---------------------------------------------------------------------------
# what is new
in_git=false
if git -C "$source_dir" rev-parse --git-dir >/dev/null 2>&1; then
    in_git=true
fi

if $in_git; then
    if ! git -C "$source_dir" diff --quiet || ! git -C "$source_dir" diff --cached --quiet; then
        say
        say "  note: $source_dir has uncommitted changes. they will be installed as they are."
    fi
    if git -C "$source_dir" fetch --quiet 2>/dev/null; then
        upstream="$(git -C "$source_dir" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
        if [[ -n "$upstream" ]]; then
            behind="$(git -C "$source_dir" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
            if [[ "$behind" -gt 0 ]]; then
                say
                say "  $behind new commit(s) on $upstream:"
                git -C "$source_dir" log --oneline --no-decorate "HEAD..$upstream" | sed 's/^/    /'
                say
                say "  secret-update does not pull for you. review them, then:"
                say "    git -C $source_dir pull --ff-only"
                say "    secret-update"
            fi
        fi
    fi
    current_commit="$(git -C "$source_dir" rev-parse --short HEAD)"
    if [[ -n "$installed_commit" && "$installed_commit" != "$current_commit" ]]; then
        say
        say "  installed from      $installed_commit"
        say "  checkout is at      $current_commit"
    fi
fi

# ---------------------------------------------------------------------------
# migrations
have_format="$(store_version)"
pending=()
if [[ "$have_format" -lt "$AGENT_SECRETS_STORE_FORMAT" ]]; then
    for script in "$source_dir"/migrations/*.sh; do
        [[ -f "$script" ]] || continue
        number="$(basename "$script")"
        number="${number%%-*}"
        [[ "$number" =~ ^[0-9]+$ ]] || continue
        # 10#, or 008 is an invalid octal number and the upgrade dies on arithmetic.
        if (( 10#$number > have_format && 10#$number <= AGENT_SECRETS_STORE_FORMAT )); then
            pending+=("$script")
        fi
    done
fi

say
if [[ ${#pending[@]} -eq 0 ]]; then
    say "  migrations          none pending"
else
    say "  migrations          ${#pending[@]} pending:"
    for script in "${pending[@]}"; do
        say "    $(basename "$script")"
    done
    say "  a migration may not read, rewrite or re-encrypt a scope."
fi

if secret_helper_hardened; then
    say "  mode                hardened"
    say "  after installing, rerun the root installer so the privileged helper"
    say "  matches the commands:"
    say "    sudo $HOME/.local/libexec/agent-secrets-install-root"
else
    say "  mode                unhardened"
fi

if $check_only; then
    say
    say "nothing was changed."
    exit 0
fi

if ! $assume_yes; then
    say
    printf 'install from %s now? [y/N] ' "$source_dir"
    read -r answer
    case "$answer" in
        y|Y|yes|YES) ;;
        *) say "nothing was changed."; exit 0 ;;
    esac
fi

# ---------------------------------------------------------------------------
# backup, then migrate, then install
#
# the backup covers ciphertext and indexes. it deliberately does not copy
# key/: a second copy of the key on the same disk is a bigger risk than the
# one it would insure against, and a key that is root-owned could not be
# copied by this command anyway.
if [[ ${#pending[@]} -gt 0 ]]; then
    backup="$secrets_dir/backups/$(date +%Y%m%dT%H%M%S)"
    mkdir -p "$backup"
    chmod 700 "$secrets_dir/backups" "$backup"
    for dir in scopes index; do
        [[ -d "$secrets_dir/$dir" ]] || continue
        cp -a "$secrets_dir/$dir" "$backup/$dir"
    done
    say
    say "backed up scopes and indexes to $backup"
    say "the key was not copied. back that up yourself, somewhere else."
fi

say
say "installing from $source_dir"
"$source_dir/install.sh"

if [[ ${#pending[@]} -gt 0 ]]; then
    export AGENT_SECRETS_STORE="$secrets_dir"
    for script in "${pending[@]}"; do
        number="$(basename "$script")"
        number="${number%%-*}"
        say
        say "migration $(basename "$script")"
        if ! bash "$script"; then
            say
            say "migration failed. the store version was not advanced, so this runs again"
            say "next time. your scopes are untouched, and there is a copy at:"
            say "  $backup"
            exit 1
        fi
        printf '%s\n' "$((10#$number))" > "$(store_version_file)"
        chmod 600 "$(store_version_file)"
    done
fi

say
say "updated to $(agent_secrets_version)"
say "run secret-doctor to check the result."
