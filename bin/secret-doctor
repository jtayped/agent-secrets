#!/usr/bin/env bash
# report what this machine can and cannot do, and why.
#
# the point of this command is that "it did not work" should never be the whole
# story. every check below names the thing that is missing and what is lost
# without it, so the answer to "is my platform supported" is a list rather than
# a yes or no.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

errors=0
warnings=0

ok()   { printf '  ok    %-14s %s\n' "$1" "${2:-}"; }
warn() { printf '  warn  %-14s %s\n' "$1" "${2:-}"; warnings=$((warnings + 1)); }
bad()  { printf '  ERROR %-14s %s\n' "$1" "${2:-}"; errors=$((errors + 1)); }
skip() { printf '  --    %-14s %s\n' "$1" "${2:-}"; }

have() { command -v "$1" >/dev/null 2>&1; }

require() {
    local cmd="$1" why="$2"
    if have "$cmd"; then ok "$cmd" "$(command -v "$cmd")"
    else bad "$cmd" "missing. $why"; fi
}

optional() {
    local cmd="$1" why="$2"
    if have "$cmd"; then ok "$cmd" "$(command -v "$cmd")"
    else skip "$cmd" "not installed. $why"; fi
}

echo "agent-secrets doctor"
echo
echo "platform"
printf '  %-16s %s\n' "os" "$agent_secrets_os $(uname -r)"
printf '  %-16s %s\n' "bash" "${BASH_VERSION:-unknown}"
printf '  %-16s %s\n' "store" "$secrets_dir"
if secret_helper_hardened; then
    printf '  %-16s %s\n' "mode" "hardened (root-owned helper)"
else
    printf '  %-16s %s\n' "mode" "unhardened (helper runs as you)"
fi

echo
echo "required"
require gpg "every scope is encrypted with it; nothing works without gpg."
require awk "the metadata parser is awk."
require sed "used by every command."
require install "the installer needs it."
require mktemp "secret-edit stages plaintext in a temporary file."
if [[ "$agent_secrets_os" == Darwin ]]; then
    require shasum "index freshness is a sha256 of the ciphertext."
else
    require sha256sum "index freshness is a sha256 of the ciphertext."
fi

echo
echo "approval gate"
if [[ "$agent_secrets_os" == Darwin ]]; then
    require osascript "the approval dialog is an applescript dialog on macos."
    require ioreg "without it the gate cannot tell a locked screen from an unlocked one."
    optional launchctl "root needs it to reach your gui session; only used in hardened mode."
else
    if have kdialog; then ok "dialog" "kdialog"
    elif have zenity; then ok "dialog" "zenity"
    else bad "dialog" "neither kdialog nor zenity. sensitive groups cannot be approved."; fi
    require loginctl "the gate asks systemd-logind whether you are at an active local seat."
    require timeout "the dialog is bounded by it; without it a dialog could hang a request."
    optional setpriv "root drops to your account with it; only used in hardened mode."
fi
optional logger "approval verdicts go to the system journal. without it there is no record."

echo
echo "hardening"
if secret_helper_hardened; then
    ok "helper" "$agent_secrets_helper_installed ($(stat_owner "$agent_secrets_helper_installed"))"
    if [[ -w "$agent_secrets_helper_installed" ]]; then
        bad "helper perms" "your account can write the helper. the gate is not a control."
    fi
    if [[ -r "$secrets_key" ]]; then
        bad "key" "your account can still read $secrets_key. rerun the root installer."
    else
        ok "key" "$(stat_owner "$secrets_key" 2>/dev/null || echo missing), unreadable by you"
    fi
    if helper_protocol="$(secret_helper version 2>/dev/null)"; then
        ok "protocol" "installed helper speaks protocol $helper_protocol"
    else
        bad "protocol" "the installed helper did not answer. rerun the root installer."
    fi
else
    warn "not hardened" "any process running as you can read the key or replace the helper."
    printf '        to harden: sudo %s\n' "$HOME/.local/libexec/agent-secrets-install-root"
    if [[ "$agent_secrets_os" == Darwin ]]; then
        printf '        note: macos hardening needs a gpg under a root-owned prefix.\n'
        printf '        a homebrew gpg does not qualify, and the installer will say so.\n'
    fi
fi

echo
echo "store"
if [[ -d "$secrets_dir" ]]; then
    ok "directory" "$(stat_owner "$secrets_dir")"
else
    bad "directory" "$secrets_dir does not exist. run secret-init."
fi
if [[ -e "$secrets_key" ]]; then
    ok "key file" "present"
else
    bad "key file" "no key at $secrets_key. without it every scope is unreadable."
fi

scope_count=0
for scope in $(list_scopes); do
    scope_count=$((scope_count + 1))
    toc="$secrets_index_dir/$scope.toc"
    if [[ ! -f "$toc" ]]; then
        warn "$scope" "no index. run: secret-reindex $scope"
        continue
    fi
    want="$(sha256_of_stdin < "$secrets_scopes_dir/$scope.env.gpg")"
    have_sum="$(sed -n '1s/.*sha256=//p' "$toc")"
    if [[ "$want" != "$have_sum" ]]; then
        warn "$scope" "index is stale. run: secret-reindex $scope"
    elif grep -q '^E' "$toc"; then
        warn "$scope" "metadata errors. see: secret-list $scope --tree"
    else
        ok "$scope" "indexed"
    fi
done
[[ "$scope_count" -eq 0 ]] && skip "scopes" "none yet. create one with: secret-edit <name> --new"

echo
if [[ "$errors" -gt 0 ]]; then
    echo "$errors problem(s) and $warnings warning(s)."
    exit 1
fi
if [[ "$warnings" -gt 0 ]]; then
    echo "no blocking problems, $warnings warning(s)."
    exit 0
fi
echo "everything checks out."
