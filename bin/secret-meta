#!/usr/bin/env bash
# change what a group or key says about itself: description, attributes, and
# its sensitivity mark. no value passes through.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-meta <scope> <group|KEY> [--desc <text>] [--attr name=value]... [--unset-attr name]...
                   [--sensitive [--ttl <duration>] | --not-sensitive | --ttl <duration>] [--dry-run]

  a group is named by its dotted path (pg.prod), a key by its variable name
  (PG_PROD_PASS), as secret-list --keys prints it.

  --desc           replace the description. it is what the approval dialog shows.
  --attr           set an attribute, like mode=ro. repeat for several.
  --unset-attr     remove one.
  --sensitive      mark it: reading it needs approval. asks nothing.
  --not-sensitive  remove its own mark. this asks every time.
  --ttl            how long an approval lasts. a longer one asks every time.
  --dry-run        say what would change and what it would ask, and change nothing.
MSG
    exit 1
}

[[ $# -ge 3 ]] || usage
scope="$1"
target="$2"
shift 2
validate_scope "$scope"
[[ "$target" =~ ^[A-Za-z0-9_][A-Za-z0-9_.]*$ ]] || { echo "error: bad group or key name '$target'" >&2; exit 1; }
changes=()
dry=0
sensitive=""
ttl=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --desc) [[ $# -ge 2 ]] || usage; changes+=(desc "$2"); shift 2 ;;
        --attr) [[ $# -ge 2 ]] || usage; changes+=(attr "$2"); shift 2 ;;
        --unset-attr) [[ $# -ge 2 ]] || usage; changes+=(unattr "$2"); shift 2 ;;
        --sensitive) sensitive=on; shift ;;
        --not-sensitive) sensitive=off; shift ;;
        --ttl)
            [[ $# -ge 2 ]] || usage
            ttl="$(duration_seconds "$2")" || {
                echo "error: --ttl takes a duration like 30m or 2h (got '$2')" >&2
                exit 1
            }
            shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) usage ;;
    esac
done
case "$sensitive" in
    on)  changes+=(mark "${ttl:--}") ;;
    off) [[ -z "$ttl" ]] || { echo "error: --ttl belongs to a mark, and --not-sensitive removes it" >&2; exit 1; }
         changes+=(unmark) ;;
    *)   [[ -z "$ttl" ]] || changes+=(ttl "$ttl") ;;
esac
[[ ${#changes[@]} -gt 0 ]] || usage

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}
require_helper_protocol secret-meta || exit $?
ensure_key

if [[ "$dry" == 1 ]]; then
    secret_helper meta "$scope" "$target" 1 "${changes[@]}"
    exit 0
fi

scope_lock "$scope"
tmp="$scope_file.new"
trap 'rm -f "$tmp"; scope_unlock' EXIT
secret_helper meta "$scope" "$target" 0 "${changes[@]}" > "$tmp"
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
echo "updated $target in $scope"
