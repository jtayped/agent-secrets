#!/usr/bin/env bash
# create the local store and its symmetric gpg key.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

command -v gpg >/dev/null || {
    echo "error: gpg is required. install gnupg, then run secret-init again." >&2
    exit 1
}

umask 077
mkdir -p "$secrets_scopes_dir" "$secrets_index_dir" "$secrets_key_dir"
chmod 700 "$secrets_dir" "$secrets_scopes_dir" "$secrets_index_dir" "$secrets_key_dir"

if [[ -e "$secrets_key" ]]; then
    echo "key already exists at $secrets_key"
    exit 0
fi

# the key is the gpg passphrase, and gpg reads a passphrase file as text: it
# takes the first line and stops. raw random bytes are therefore the wrong
# shape for this file. roughly one in eight 32-byte random keys contains a
# 0x0a somewhere, and gpg silently uses only the bytes before it, so a newline
# at byte 10 leaves 80 bits of entropy where 256 was intended and nothing says
# so. worse, the 1-in-256 key that begins with a newline is an empty
# passphrase: secret-init reports success and every later encrypt fails. a NUL
# truncates the same way.
#
# so the key is stored as base64, which cannot contain either. `gpg --armor`
# emits exactly one line for 32 bytes, and the entropy is unchanged: still 32
# random bytes, just written in an alphabet that survives being read as text.
tmp="$secrets_key_dir/.key.new"
trap 'rm -f "$tmp"' EXIT
gpg --armor --gen-random 2 32 > "$tmp"

# check what actually landed, rather than trusting the pipeline that wrote it.
# every failure this guards against is silent and permanent.
key_lines="$(wc -l < "$tmp" | tr -d ' ')"
first_line="$(head -1 "$tmp")"
[[ "$key_lines" == 1 ]] || { echo "error: gpg produced a $key_lines-line key" >&2; exit 1; }
[[ "${#first_line}" -ge 43 ]] || { echo "error: gpg produced a ${#first_line}-character key" >&2; exit 1; }
if LC_ALL=C grep -q '[^A-Za-z0-9+/=]' <<< "$first_line"; then
    echo "error: gpg produced a key that is not base64" >&2
    exit 1
fi

chmod 600 "$tmp"
mv "$tmp" "$secrets_key"
echo "created encrypted-store directories and a new key"
