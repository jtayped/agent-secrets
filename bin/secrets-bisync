#!/usr/bin/env bash
# two-way-sync encrypted scopes and the value-free index with rclone.
# never include the key directory in a broad sync target.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

remote="${AGENT_SECRETS_SYNC_REMOTE:-}"
if [[ -z "$remote" ]]; then
    echo "usage: AGENT_SECRETS_SYNC_REMOTE=<rclone-remote:path> secrets-bisync" >&2
    exit 1
fi
command -v rclone >/dev/null || {
    echo "error: rclone is required for syncing." >&2
    exit 1
}

rclone bisync "$secrets_scopes_dir" "$remote/scopes" --conflict-resolve newer -q

# the index carries no values, but it does carry group names, key names and
# your descriptions. on a third-party drive that is an inventory of which
# credentials you hold and what each one is for, which some people will not
# want to publish. it is only a display cache, so skipping it costs one
# secret-reindex on the other machine.
if [[ "${AGENT_SECRETS_SYNC_INDEX:-1}" == 0 ]]; then
    echo "synced encrypted scopes; left the index behind"
    exit 0
fi
rclone bisync "$secrets_index_dir" "$remote/index" --conflict-resolve newer -q
echo "synced encrypted scopes and the value-free index"
