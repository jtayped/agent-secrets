#!/usr/bin/env bash
# declare a group, without an editor and without a value passing through.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-group <scope> <group.path> --desc <text> [--attr name=value]...
                    [--sensitive [--ttl <duration>]] [--take] [--dry-run]

  declares a group that does not exist yet. keys already named for it move in:
  loose ones always, and ones in another group only with --take.

  --desc       what the group holds. required: it is what the approval dialog shows.
  --attr       an attribute, like server=main or mode=ro. repeat for several.
  --sensitive  reading anything in it needs approval. --ttl sets how long one lasts.
  --take       allow it to take keys out of the groups they are in now.
  --dry-run    say what would change and what it would ask, and change nothing.

  change an existing group with secret-meta.
MSG
    exit 1
}

[[ $# -ge 2 ]] || usage
scope="$1"
path="$2"
shift 2
validate_scope "$scope"
[[ "$path" =~ ^[a-z0-9][a-z0-9_]*(\.[a-z0-9][a-z0-9_]*)*$ ]] || {
    echo "error: group paths are dotted lowercase, like pg.aws.main (got '$path')" >&2
    exit 1
}
desc=""
sensitive=0
ttl="-"
take=0
dry=0
attrs=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --desc) [[ $# -ge 2 ]] || usage; desc="$2"; shift 2 ;;
        --attr) [[ $# -ge 2 ]] || usage; attrs+=("$2"); shift 2 ;;
        --sensitive) sensitive=1; shift ;;
        --ttl)
            [[ $# -ge 2 ]] || usage
            ttl="$(duration_seconds "$2")" || {
                echo "error: --ttl takes a duration like 30m or 2h (got '$2')" >&2
                exit 1
            }
            shift 2 ;;
        --take) take=1; shift ;;
        --dry-run) dry=1; shift ;;
        *) usage ;;
    esac
done
[[ -n "$desc" ]] || { echo "error: a new group needs --desc" >&2; usage; }
if [[ "$ttl" != - && "$sensitive" != 1 ]]; then
    echo "error: --ttl goes with --sensitive: it says how long an approval of this group lasts" >&2
    exit 1
fi

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}
require_helper_protocol secret-group || exit $?
ensure_key

if [[ "$dry" == 1 ]]; then
    secret_helper declare "$scope" "$path" "$desc" "$sensitive" "$ttl" "$take" 1 ${attrs[@]+"${attrs[@]}"}
    exit 0
fi

scope_lock "$scope"
tmp="$scope_file.new"
trap 'rm -f "$tmp"; scope_unlock' EXIT
secret_helper declare "$scope" "$path" "$desc" "$sensitive" "$ttl" "$take" 0 ${attrs[@]+"${attrs[@]}"} > "$tmp"
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
echo "declared $path in $scope"
