#!/usr/bin/env bash
# request one approval for known sensitive groups. this never exposes values.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: secret-approve <scope> --motive <short reason> <group> [<group>...]" >&2
    echo "       secret-list <scope> [<group>]   to find a group" >&2
    exit 1
}

[[ $# -ge 4 ]] || usage
scope="$1"
shift
validate_scope "$scope"
[[ "${1:-}" == "--motive" && $# -ge 3 ]] || usage
motive="$2"
shift 2
[[ -n "$motive" ]] || usage

require_helper_protocol secret-approve || exit $?

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}

if secret_helper gate "$scope" --motive "$motive" "$@"; then
    exit 0
fi
rc=$?
case $rc in
    69) echo "secret-approve: no active local session is available for approval" >&2 ;;
    75) echo "secret-approve: approval timed out. nothing was cached." >&2 ;;
    77) echo "secret-approve: approval was denied. stop and ask the store owner." >&2 ;;
esac
exit "$rc"
