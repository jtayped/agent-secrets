#!/usr/bin/env bash
# remove keys, or group declarations. no value passes through this command.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-rm <scope> <KEY|group>... [--with-keys] [--dry-run]

  a key is removed, value and all. there is no undo.
  a group loses only its declaration: its keys move up to the next group, or
  out of every group, and the command says where each one went.

  --with-keys  remove a group with every group and key under it
  --dry-run    say what would go and what it would ask, and change nothing
MSG
    exit 1
}

[[ $# -ge 2 ]] || usage
scope="$1"
shift
validate_scope "$scope"
targets=()
with_keys=0
dry=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --with-keys) with_keys=1; shift ;;
        --dry-run) dry=1; shift ;;
        -*) usage ;;
        *)
            [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.]*$ ]] || { echo "error: bad name '$1'" >&2; exit 1; }
            targets+=("$1"); shift ;;
    esac
done
[[ ${#targets[@]} -ge 1 ]] || usage

scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}
require_helper_protocol secret-rm || exit $?
ensure_key

if [[ "$dry" == 1 ]]; then
    secret_helper rm "$scope" "$with_keys" 1 "${targets[@]}"
    exit 0
fi

scope_lock "$scope"
tmp="$scope_file.new"
trap 'rm -f "$tmp"; scope_unlock' EXIT
secret_helper rm "$scope" "$with_keys" 0 "${targets[@]}" > "$tmp"
[[ -s "$tmp" ]] || { echo "error: helper produced no encrypted scope" >&2; exit 1; }
mv -f "$tmp" "$scope_file"
secret-reindex "$scope" >/dev/null
