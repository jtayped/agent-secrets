#!/usr/bin/env bash
# move every scope onto a new key.
#
# this is the most destructive command here. it rewrites every encrypted file
# you own, and if it went wrong you would find out when you next needed a
# password. so it does the work in stages, verifies each scope before
# committing anything, and keeps the previous key until you say the new one is
# backed up.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    cat >&2 <<'MSG'
usage: secret-rekey [--yes]
       secret-rekey --finish

  re-encrypts every scope under a newly generated key.

  the previous key is kept at ~/.secrets/key/.key.old until you run --finish,
  so an interrupted or regretted rekey is recoverable. nothing is deleted
  until then.

  --yes     do not ask for confirmation.
  --resume  finish a rekey that was interrupted, using the keys already on disk.
  --finish  check every scope opens under the new key, then delete the old one.
MSG
    exit 1
}

finish=false
resume=false
assume_yes=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --finish) finish=true; shift ;;
        --resume) resume=true; shift ;;
        --yes|-y) assume_yes=true; shift ;;
        -h|--help) usage ;;
        *) echo "error: unknown option '$1'" >&2; usage ;;
    esac
done

require_helper_protocol secret-rekey || exit $?
ensure_key

old_key="$secrets_key_dir/.key.old"

if $finish; then
    [[ -e "$old_key" ]] || {
        echo "there is no previous key to remove. nothing to finish." >&2
        exit 0
    }
    checked="$(secret_helper rekey-finish)"
    echo "checked $checked scope(s) against the current key and removed the previous one."
    echo "if your backup still holds the old key, replace it with the current one now."
    exit 0
fi

if $resume; then
    [[ -e "$old_key" ]] || {
        echo "no rekey is in progress. nothing to resume." >&2
        exit 0
    }
    echo "finishing an interrupted rekey:"
    moved="$(secret_helper rekey-resume)"
    secret-reindex >/dev/null
    if [[ "$moved" == 0 ]]; then
        echo "every scope was already on the current key."
    else
        echo "moved $moved scope(s) onto the current key."
    fi
    echo "check a value, back up $secrets_key, then run: secret-rekey --finish"
    exit 0
fi

if [[ -e "$old_key" ]]; then
    cat >&2 <<MSG
error: a previous rekey has not been finished.

  $old_key still exists, so the old key can still open your scopes. generating
  another key now would overwrite it and strand anything that still needs it.

  if the last rekey completed, confirm a value and then run:
    secret-rekey --finish

  if it was interrupted part way, finish it with the keys already on disk:
    secret-rekey --resume
MSG
    exit 1
fi

scopes="$(list_scopes)"
count="$(printf '%s' "$scopes" | grep -c . || true)"

cat <<MSG
secret-rekey

  store        $secrets_dir
  scopes       $count
  key          $secrets_key

  every scope is decrypted and re-encrypted under a newly generated key. each
  one is read back and compared before anything is replaced, and the previous
  key is kept at $old_key until you run --finish.

  the values do not change. what changes is the key that opens them, so the
  copy of the key in your password manager stops working the moment this
  finishes. have somewhere to put the new one.
MSG

if ! $assume_yes; then
    printf '\nrekey %s scope(s) now? [y/N] ' "$count"
    read -r answer
    case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "nothing was changed."; exit 0 ;;
    esac
fi

echo
echo "re-encrypting:"
done_count="$(secret_helper rekey)"

echo
secret-reindex >/dev/null
echo "moved $done_count scope(s) onto a new key."
echo
echo "what to do now, in this order:"
echo "  1. check a value you know:  secret-run <scope> <group> -- <command>"
echo "  2. back up the new key:     $secrets_key"
echo "  3. then, and only then:     secret-rekey --finish"
echo
echo "until step 3 the old key at $old_key still opens everything, which is"
echo "your way back if something is wrong."
