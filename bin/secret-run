#!/usr/bin/env bash
# run a command with one scope or group in its environment. the wrapper never
# receives a decrypted payload.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: secret-run <scope> [<group>] [--motive <short reason>] -- <command> [args...]" >&2
    echo "       secret-list <scope> --tree" >&2
    exit 1
}

[[ $# -ge 3 ]] || usage
scope="$1"
shift
validate_scope "$scope"
scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}

# only check the protocol when the optional motive syntax is present. the
# helper validates every other argument before it decrypts anything.
args=("$scope" "$@")
has_motive=false
for arg in "$@"; do [[ "$arg" == "--motive" ]] && has_motive=true; done
if $has_motive; then
    if helper_protocol="$(secret_helper version 2>/dev/null)" && [[ "$helper_protocol" -ge 2 ]]; then
        :
    else
        echo "secret-run: the installed helper needs an update. run install-root.sh again." >&2
        exit 78
    fi
fi
secret_helper run "${args[@]}"
