#!/usr/bin/env bash
# run a command with one scope, or one or more of its groups, in its
# environment. the wrapper never receives a decrypted payload.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

usage() {
    echo "usage: secret-run <scope> <group> [<group>...] [--motive <short reason>] [--for <duration>] -- <command> [args...]" >&2
    echo "       secret-run <scope> --all-groups [--motive <short reason>] [--for <duration>] -- <command> [args...]" >&2
    echo "       --for 30m, 2h: how long a sensitive group stays open after its last use (at most 12h)" >&2
    echo "       secret-list <scope> [<group>]   to find a group" >&2
    exit 1
}

[[ $# -ge 3 ]] || usage
scope="$1"
shift
validate_scope "$scope"
scope_file="$secrets_scopes_dir/$scope.env.gpg"
[[ -f "$scope_file" ]] || {
    echo "error: no scope '$scope'" >&2
    echo "existing scopes: $(scopes_line)" >&2
    exit 1
}

# only check the protocol for syntax an older helper cannot parse. the check
# costs another sudo round trip, and the one-group form has worked since the
# first helper, so it stays on the fast path. everything else the helper
# validates itself, before it decrypts anything.
#
# the scan stops at `--`: past that the arguments belong to the command being
# run, and one of them being called --motive or --for says nothing about this
# call. --for is the one option rewritten on the way through, from a duration
# a person types to the seconds the helper takes.
args=("$scope")
has_option=false
group_count=0
past_groups=false
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
        args+=("$@")
        break
    fi
    case "$1" in
        --motive)
            has_option=true; past_groups=true
            [[ $# -ge 2 ]] || usage
            args+=("$1" "$2"); shift 2 ;;
        --for)
            has_option=true; past_groups=true
            [[ $# -ge 2 ]] || usage
            seconds="$(duration_seconds "$2")" || {
                echo "error: --for takes a duration like 30m or 2h (got '$2')" >&2
                exit 1
            }
            args+=("$1" "$seconds"); shift 2 ;;
        *)
            $past_groups || group_count=$((group_count + 1))
            args+=("$1"); shift ;;
    esac
done
# an old helper reads --all-groups as a group path and rejects it as malformed,
# and reads a second group as the command it was never given a -- before. both
# say nothing about the real problem, which is that the helper is behind.
if [[ "${args[1]:-}" == "--all-groups" ]] || $has_option || [[ "$group_count" -gt 1 ]]; then
    require_helper_protocol secret-run || exit $?
fi
secret_helper run "${args[@]}"
