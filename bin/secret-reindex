#!/usr/bin/env bash
# Rebuilds the plaintext index for one scope or all of them.
#
# The index holds group paths, key names, descriptions, attributes and
# sensitivity marks, and never a value. That is what lets secret-list --tree and
# pg-hosts run without touching the key, the property that makes pg-hosts safe
# to run in any session today.
#
# It is a display cache and nothing more. The gate never reads it: the index is
# writable by you, so a process that could edit it could erase its own gate.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

mkdir -p "$secrets_index_dir"; chmod 700 "$secrets_index_dir"

reindex_one() {
    local scope="$1" tmp
    validate_scope "$scope"
    [[ -f "$secrets_scopes_dir/$scope.env.gpg" ]] || { echo "error: no scope '$scope'" >&2; return 1; }
    tmp="$(mktemp "$secrets_index_dir/.$scope.XXXXXX")"
    trap 'rm -f "$tmp"' RETURN
    if ! secret_helper index "$scope" > "$tmp"; then
        echo "error: could not index '$scope'" >&2; return 1
    fi
    local errs; errs="$(grep -c '^E' "$tmp" || true)"
    mv -f "$tmp" "$secrets_index_dir/$scope.toc"
    chmod 600 "$secrets_index_dir/$scope.toc"
    if [[ "$errs" != "0" ]]; then
        echo "warning: $scope has $errs metadata problem(s); secret-list --tree will show them" >&2
    fi
    echo "indexed $scope"
}

if [[ $# -eq 0 ]]; then
    for s in $(list_scopes); do reindex_one "$s"; done
else
    for s in "$@"; do reindex_one "$s"; done
fi
