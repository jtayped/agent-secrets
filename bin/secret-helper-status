#!/usr/bin/env bash
# print the current key and helper ownership state.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/secret-common.sh"

if secret_helper_hardened; then
    helper_state="$(stat -c '%U:%G %a' "$agent_secrets_helper_installed")"
    key_state="$(stat -c '%U:%G %a' "$secrets_key" 2>/dev/null || echo 'missing')"
    echo "hardened"
    echo "  helper: $agent_secrets_helper_installed ($helper_state)"
    echo "  key:    $secrets_key ($key_state)"
    if [[ -w "$agent_secrets_helper_installed" ]]; then
        echo "warning: your account can write the helper. the approval gate is not a control." >&2
    fi
    if [[ -r "$secrets_key" ]]; then
        echo "warning: your account can still read the key. run install-root.sh again." >&2
    else
        echo "the helper is the only installed component that can read the key."
    fi
else
    echo "not hardened"
    echo "  helper: $agent_secrets_helper_local"
    echo "  key:    $secrets_key ($(stat -c '%U:%G %a' "$secrets_key" 2>/dev/null || echo missing))"
    echo
    echo "the approval dialog catches mistakes. any process running as you can still read the key or replace the local helper."
    echo "to enforce root ownership, run:"
    echo "  sudo $HOME/.local/libexec/agent-secrets-install-root"
fi
